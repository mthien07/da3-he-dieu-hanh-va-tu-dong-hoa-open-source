# Tường lửa OneBee Box: chỉ máy trong mạng LAN cho phép mới vào được dịch vụ của Box
# (trang giới thiệu, Trợ lý AI, giám sát, kho sao lưu — chạy trong Docker; thư mục chung + NetBIOS, SSH — chạy thẳng trên Box).
# Docker mở cổng bằng iptables riêng, đi vòng qua ufw → chặn ở chuỗi DOCKER-USER (gói đi tới container)
# và INPUT (dịch vụ trên Box). Chỉ xét kết nối MỚI từ bên ngoài; Box gọi ra ngoài, trả lời, gọi nội bộ không bị ảnh hưởng.
# Phạm vi (rà soát bảo mật F5): MỌI cổng mạng trừ lo, docker*, br-* (mạng Docker). Qua cổng mạng chính chỉ mạng LAN cho phép;
# qua tailscale0 chỉ các địa chỉ trong TAILSCALE_CHO_PHEP (máy kỹ thuật); cổng mạng khác (card phụ, wg0, tun0…) bị chặn hết.
# Tailscale: tailscaled chèn -j ts-input / ts-forward vào ĐẦU INPUT/FORWARD mỗi lần khởi động và ts-input ACCEPT mọi gói từ tailscale0
# (util/linuxfw, bản 1.104) → lọc ở filter thì thứ tự khởi động quyết định. Nên kết nối MỚI từ tailscale0 bị lọc ở mangle/PREROUTING
# (chạy trước mọi chuỗi filter; tailscaled chỉ thêm ở đó quy tắc CONNMARK không chặn/không nhận gói) — đúng bất kể ai khởi động trước.
# IPv6: SSH/Samba ngoài mạng nội bộ bị REJECT (không DROP) để Windows lùi về IPv4 ngay, không treo chờ hết giờ.
# Cách dùng: onebee-tuong-lua [bat|tat|xem]   (bat: dựng lại từ đầu, chạy nhiều lần không sao)
set -euo pipefail

CONF="${ONEBEE_TUONG_LUA_CONF:-/etc/onebee-box/tuong-lua.conf}"
LAN_CHO_PHEP=""              # để trống: tự lấy mạng của cổng mạng chính
TAILSCALE_CHO_PHEP=""        # địa chỉ/dải được vào qua tailscale0 (cách nhau dấu phẩy); để trống: chặn hết kết nối qua Tailscale
CONG_TREN_BOX="22,139,445"   # TCP: SSH, Samba
CONG_UDP_TREN_BOX="137,138"  # UDP: Samba tìm máy trong mạng (NetBIOS)
CONG_TU_XA="443,445,8000"    # TCP: cổng máy công tác qua tailscale0 được dùng (số cổng TRƯỚC DNAT)
TU_XA_CHO_PHEP=""            # IP của máy công tác đã duyệt (cách nhau dấu phẩy) — trạng thái vận hành, nạp từ tuong-lua-tu-xa.conf
# shellcheck source=/dev/null
[[ -f "${CONF}" ]] && . "${CONF}"
# shellcheck source=/dev/null
CONF_TU_XA="${ONEBEE_TU_XA_CONF:-/etc/onebee-box/tuong-lua-tu-xa.conf}"
# shellcheck source=/dev/null
[[ -f "${CONF_TU_XA}" ]] && . "${CONF_TU_XA}"

C_DOCKER=ONEBEE-LAN-DOCKER
C_BOX=ONEBEE-LAN-BOX
C_TS=ONEBEE-TAILSCALE   # bảng mangle

cong_mang() { ip -4 route show default | awk '{print $5; exit}'; }

# Gỡ hết quy tắc OneBee (an toàn khi chưa có)
tat() {
  local ipt
  for ipt in iptables ip6tables; do
    command -v "${ipt}" >/dev/null || continue
    "${ipt}" -S 2>/dev/null >/dev/null || continue   # máy tắt IPv6
    while "${ipt}" -S DOCKER-USER 2>/dev/null | grep -q -- "-j ${C_DOCKER}"; do
      "${ipt}" -S DOCKER-USER | grep -- "-j ${C_DOCKER}" | head -1 | sed 's/^-A/-D/' | xargs "${ipt}"
    done
    while "${ipt}" -S INPUT | grep -q -- "-j ${C_BOX}"; do
      "${ipt}" -S INPUT | grep -- "-j ${C_BOX}" | head -1 | sed 's/^-A/-D/' | xargs "${ipt}"
    done
    while "${ipt}" -t mangle -S PREROUTING 2>/dev/null | grep -q -- "-j ${C_TS}"; do
      "${ipt}" -t mangle -S PREROUTING | grep -- "-j ${C_TS}" | head -1 | sed 's/^-A/-t mangle -D/' | xargs "${ipt}"
    done
    for c in "${C_DOCKER}" "${C_BOX}"; do
      "${ipt}" -F "${c}" 2>/dev/null || true
      "${ipt}" -X "${c}" 2>/dev/null || true
    done
    "${ipt}" -t mangle -F "${C_TS}" 2>/dev/null || true
    "${ipt}" -t mangle -X "${C_TS}" 2>/dev/null || true
  done
}

# $1 = iptables|ip6tables, $2 = cổng mạng chính, $3 = mạng LAN cho phép (cách nhau dấu phẩy), $4 = địa chỉ cho phép qua Tailscale (cùng họ địa chỉ),
# $5 = IP máy công tác (IPv4, chỉ dùng khi $1 = iptables)
dung() {
  local ipt="$1" ifc="$2" mang="$3" ts="$4" tu="${5:-}" c net ip cong
  for c in "${C_DOCKER}" "${C_BOX}"; do
    "${ipt}" -N "${c}"
    # Giao diện nội bộ: loopback và mạng Docker (container gọi ra ngoài/gọi nhau) không bị lọc
    "${ipt}" -A "${c}" -i lo -j RETURN
    "${ipt}" -A "${c}" -i 'docker+' -j RETURN
    "${ipt}" -A "${c}" -i 'br-+' -j RETURN
    for net in ${mang//,/ }; do "${ipt}" -A "${c}" -i "${ifc}" -s "${net}" -j RETURN; done
    for net in ${ts//,/ }; do "${ipt}" -A "${c}" -i tailscale0 -s "${net}" -j RETURN; done
    # Máy công tác (chỉ IPv4): đúng cổng khai báo, đặt SAU dòng máy kỹ thuật để IP nằm trong cả hai danh sách thì quyền máy kỹ thuật thắng
    if [[ "${ipt}" == iptables && -n "${tu}" ]]; then
      for ip in ${tu//,/ }; do
        if [[ "${c}" == "${C_DOCKER}" ]]; then
          # Sau DNAT cổng đích đã đổi: khớp theo cổng gốc (giả định U2 — trượt thì thay vòng lặp này bằng một dòng "-p tcp -j RETURN")
          for cong in ${CONG_TU_XA//,/ }; do
            "${ipt}" -A "${c}" -i tailscale0 -s "${ip}" -p tcp -m conntrack --ctorigdstport "${cong}" -j RETURN
          done
        else
          "${ipt}" -A "${c}" -i tailscale0 -s "${ip}" -p tcp -m multiport --dports "${CONG_TU_XA}" -j RETURN
        fi
      done
    fi
    if [[ "${ipt}" == ip6tables && "${c}" == "${C_BOX}" ]]; then
      "${ipt}" -A "${c}" -p tcp -j REJECT --reject-with tcp-reset
      "${ipt}" -A "${c}" -j REJECT --reject-with icmp6-port-unreachable
    else
      "${ipt}" -A "${c}" -j DROP
    fi
  done
  # Docker tạo DOCKER-USER khi khởi động; tạo trước cũng được (Docker dùng lại)
  "${ipt}" -N DOCKER-USER 2>/dev/null || true
  "${ipt}" -I DOCKER-USER 1 -m conntrack --ctstate NEW -j "${C_DOCKER}"
  "${ipt}" -I INPUT 1 -p tcp -m multiport --dports "${CONG_TREN_BOX}" -m conntrack --ctstate NEW -j "${C_BOX}"
  "${ipt}" -I INPUT 1 -p udp -m multiport --dports "${CONG_UDP_TREN_BOX}" -m conntrack --ctstate NEW -j "${C_BOX}"
  # Dựng SAU các bước nhảy trên: mangle lỗi (set -e dừng ở đây) thì LAN vẫn được lọc, không mở toang.
  # Kết nối mới qua tailscale0: chỉ địa chỉ khai báo (máy kỹ thuật), mọi cổng — chặn trước cả ts-input/ts-forward của tailscaled
  "${ipt}" -t mangle -N "${C_TS}"
  for net in ${ts//,/ }; do "${ipt}" -t mangle -A "${C_TS}" -s "${net}" -j RETURN; done
  # Máy công tác: lớp quyết định, cổng còn là cổng trước DNAT (đặt sau dòng máy kỹ thuật, trước DROP cuối)
  if [[ "${ipt}" == iptables && -n "${tu}" ]]; then
    for ip in ${tu//,/ }; do
      "${ipt}" -t mangle -A "${C_TS}" -s "${ip}" -p tcp -m multiport --dports "${CONG_TU_XA}" -j RETURN
    done
  fi
  "${ipt}" -t mangle -A "${C_TS}" -j DROP
  "${ipt}" -t mangle -I PREROUTING 1 -i tailscale0 -m conntrack --ctstate NEW -j "${C_TS}"
}

# Tách danh sách địa chỉ theo họ: $1 = 4|6, $2 = danh sách (cách nhau dấu phẩy) → in lại, cách nhau dấu phẩy (v6 = có dấu ':')
loc_ho() {
  local ho="$1" x
  for x in ${2//,/ }; do
    if [[ "${x}" == *:* ]]; then [[ "${ho}" == 6 ]] && printf '%s\n' "${x}"; else [[ "${ho}" == 4 ]] && printf '%s\n' "${x}"; fi
  done | paste -sd, -
}

# Lọc TU_XA_CHO_PHEP: chỉ giữ IPv4 đơn (không dải, không ký tự lạ); mục sai in cảnh báo rồi bỏ, dựng tường lửa không dừng
loc_ip_tu_xa() {
  local x n ok hop_le="" p
  for x in ${TU_XA_CHO_PHEP//,/ }; do
    ok=0
    if [[ "${x}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
      IFS=. read -r -a p <<< "${x}"
      ok=1
      for n in "${p[@]}"; do (( n <= 255 )) || { ok=0; break; }; done
    fi
    if (( ok )); then hop_le="${hop_le:+${hop_le},}${x}"; else echo "Cảnh báo: bỏ IP máy công tác sai dạng trong TU_XA_CHO_PHEP: ${x}" >&2; fi
  done
  printf '%s' "${hop_le}"
}

bat() {
  local ifc mang mang6 tu_xa
  ifc="${ONEBEE_CONG_MANG:-$(cong_mang)}"
  [[ -n "${ifc}" ]] || { echo "Không tìm thấy cổng mạng chính (chưa có đường ra mặc định)" >&2; exit 1; }
  mang="${LAN_CHO_PHEP}"
  if [[ -z "${mang}" ]]; then
    mang="$(ip -4 route show dev "${ifc}" scope link | awk '{print $1}' | paste -sd, -)"
  fi
  [[ -n "${mang}" ]] || { echo "Không xác định được mạng LAN của ${ifc}" >&2; exit 1; }
  tu_xa="$(loc_ip_tu_xa)"
  tat
  dung iptables "${ifc}" "${mang}" "$(loc_ho 4 "${TAILSCALE_CHO_PHEP}")" "${tu_xa}"
  # IPv6: các cổng Docker chỉ mở IPv4 (docker-compose.yml) → chỉ cần giữ SSH/Samba trong mạng nội bộ (ngoài mạng nội bộ: REJECT)
  if command -v ip6tables >/dev/null && ip6tables -S >/dev/null 2>&1; then
    mang6="fe80::/10,fc00::/7"
    dung ip6tables "${ifc}" "${mang6}" "$(loc_ho 6 "${TAILSCALE_CHO_PHEP}")"
  fi
  echo "Tường lửa OneBee: mọi cổng mạng trừ lo/docker/br; ${ifc}: chỉ ${mang} (IPv6: ${mang6:-tắt}); tailscale0: ${TAILSCALE_CHO_PHEP:-chặn hết}; máy công tác: ${tu_xa:-không có}"
}

xem() {
  iptables -S "${C_DOCKER}" 2>/dev/null && iptables -S "${C_BOX}" && iptables -t mangle -S "${C_TS}" || echo "Tường lửa OneBee đang tắt"
}

case "${1:-bat}" in
  bat) bat ;;
  tat) tat; echo "Đã tắt tường lửa OneBee" ;;
  xem) xem ;;
  *) echo "Cách dùng: $0 [bat|tat|xem]" >&2; exit 2 ;;
esac

[Unit]
Description=OneBee Box — chạy xu-ly-xin-vao mỗi 15 phút (dọn yêu cầu xin vào quá 24 giờ, cấp yêu cầu đã duyệt còn sót)

[Timer]
OnCalendar=*:0/15
Persistent=true
AccuracySec=1min
Unit=onebee-xin-vao.service

[Install]
WantedBy=timers.target

# Quản lý bởi OneBee OS — cổng vào của OneBee Box
{% set demo_hoat_dong = (onebee_box_che_do_demo | default(false) | bool) and ((onebee_box_domain | default('') | trim | length) > 0) %}
{% set demo_domain = onebee_box_domain | default('') | trim %}
{% if (onebee_https_hieu_luc | bool) or demo_hoat_dong %}
{# Đăng nhập một lần (ADR 0006): forward_auth chép đúng tài liệu Authelia 4.39.28 (integration/proxies/caddy.md).
   Authelia trả 200 kèm Remote-* (Caddy chép vào yêu cầu), 302/303 tới trang đăng nhập, 401 (Accept: application/json) hoặc 403 #}
{% if onebee_sso_hieu_luc | bool %}
(onebee_sso) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}
{% endif %}

{# Danh tính do máy khách tự gửi không bao giờ tới dịch vụ phía sau: xóa ở đầu khối trang (request_header chạy TRƯỚC mọi handle/forward_auth) #}
(onebee_bo_danh_tinh_co_ban) {
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
	request_header -X-OneBee-SSO
	request_header -Proxy-Authorization
}

(onebee_bo_danh_tinh_may_khach) {
	import onebee_bo_danh_tinh_co_ban
	request_header -Authorization
}

{% macro trang_chu() %}
	handle {
		root * /srv
		file_server
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
		}
		# Số liệu tình trạng trên trang chủ đổi mỗi phút (onebee-trang-thai-web.timer) → trình duyệt không giữ bản cũ
		header /trang-thai.json Cache-Control no-store
	}
{% endmacro %}
{% endif %}
{% if onebee_https_hieu_luc | bool %}
{% set cong = onebee_box_ports %}
{% set kuma_san_sang = onebee_kuma_dia_chi | default('0.0.0.0') == '0.0.0.0' %}
{% set cong_tls = [443, cong.tro_ly_ai, cong.n8n, cong.rest_server] + ([cong.uptime_kuma] if kuma_san_sang else []) %}
{# Mỗi cổng TLS có 2 địa chỉ: IP của Box (LAN) và box.<mã>.onebee.internal (kỹ thuật vào qua Tailscale, thêm dòng /etc/hosts trỏ tới IP Tailscale của Box) #}
{% macro dia_chi(c) %}https://{{ onebee_box_ip }}:{{ c }}, https://box.{{ onebee_box_ma_don_vi }}.onebee.internal:{{ c }}{% endmacro %}
{# HTTPS (Pha 4): CA riêng đặt sẵn (gốc + trung gian, ràng buộc tên); Caddy chỉ cấp chứng chỉ lá cho IP của Box và box.<mã>.onebee.internal #}
{
	skip_install_trust
	auto_https disable_redirects
	# Máy nối bằng IP không gửi SNI; Caddy trong mạng Docker chỉ thấy IP container → luôn dùng chứng chỉ của IP Box
	default_sni {{ onebee_box_ip }}
	pki {
		ca local {
			root {
				cert /pki/root.crt
			}
			intermediate {
				cert /pki/inter.crt
				key /pki/inter.key
			}
		}
	}
{% for c in cong_tls %}
	# Kết nối http:// thường tới cổng TLS → chuyển hướng sang https:// (308); chỉ HTTP/1.1 và HTTP/2 (HTTP/3 không dùng được CA tự thêm trong Chrome)
	servers :{{ c }} {
		listener_wrappers {
			http_redirect
			tls
		}
		protocols h1 h2
	}
{% endfor %}
}

# Cổng 80: chỉ phục vụ chứng chỉ gốc CA + trang hướng dẫn (không chuyển hướng sang trang báo lỗi chứng chỉ). Trang này KHÔNG hiện vân tay.
:80 {
	root * /srv-http
	file_server
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

(onebee_tls) {
	tls internal
	header -Server
}

{% set ten_box = 'box.' ~ onebee_box_ma_don_vi ~ '.onebee.internal' %}
{# Vào bằng IP: chỉ trang chủ (công khai, không có dữ liệu nội bộ). Tuyến lõi chỉ phục vụ trên tên (QĐ2) → chuyển sang tên #}
https://{{ onebee_box_ip }}:443 {
	import onebee_tls
	@tuyen_loi path /dangnhap /dangnhap/* /api/* /files/* /ai/* /ai-cli/*
	handle @tuyen_loi {
		redir https://{{ ten_box }}{uri} 308
	}
{{ trang_chu() }}}

https://{{ ten_box }}:443 {
	import onebee_tls
	import onebee_bo_danh_tinh_co_ban
	@khong_phai_ai_cli {
		not path /ai-cli/*
	}
	request_header @khong_phai_ai_cli -Authorization
	# Trang đăng nhập (Authelia, đường dẫn con /dangnhap — QĐ3)
	handle /dangnhap* {
		reverse_proxy authelia:9091
	}
{% if onebee_sso_hieu_luc | bool %}
	# route giữ đúng thứ tự: xác thực trên đường dẫn gốc (luật Authelia khớp ^/api/) rồi mới tới dịch vụ.
	# Không dùng handle_path: nó bỏ tiền tố TRƯỚC forward_auth
	handle /api/* {
		route {
			import onebee_sso
			request_body {
				max_size 1MB
			}
			reverse_proxy cau-noi:8080
		}
	}
	# AI: hai đường dẫn gọi thẳng Ollama khi cần + nhóm RAG nội bộ qua SSO; mọi đường dẫn /ai/* khác trả 404
	@ai_hoi_dap {
		method POST
		path /ai/api/chat /ai/api/generate
	}
	handle @ai_hoi_dap {
		route {
			import onebee_sso
			request_header -Cookie
			request_body {
				max_size 1MB
			}
			uri strip_prefix /ai
			reverse_proxy ollama:11434 {
				flush_interval -1
			}
		}
	}
	@ai_rag {
		path /ai /ai/ /ai/hoi /ai/tom-tat /ai/mau /ai/health /ai/api/v1/*
	}
	handle @ai_rag {
		route {
			import onebee_sso
			request_header -Cookie
			request_body {
				max_size 1MB
			}
			reverse_proxy ai-rag:8092 {
				header_up X-OneBee-SSO 1
				flush_interval -1
			}
		}
	}
	# CLI `hoi` trên máy trạm: giữ Authorization: Bearer (đã xóa mọi Remote-* và Cookie), onebee-ai-rag tự kiểm tra băm SHA-256
	handle /ai-cli/* {
		route {
			request_header -Cookie
			request_body {
				max_size 1MB
			}
			uri strip_prefix /ai-cli
			reverse_proxy ai-rag:8092 {
				flush_interval -1
			}
		}
	}
	handle /ai/* {
		respond 404
	}
	handle /files/* {
		route {
			import onebee_sso
			header Content-Type "text/plain; charset=utf-8"
			respond "Chưa cài kho tệp trên OneBee Box" 503
		}
	}
{% else %}
	# Đăng nhập một lần đang TẠM TẮT (onebee-box tat-sso-tam): không ai vào được dữ liệu — không mở toang khi định danh hỏng
	@tuyen_loi path /api/* /files/* /ai/* /ai-cli/*
	handle @tuyen_loi {
		header Content-Type "text/plain; charset=utf-8"
		respond "Đăng nhập một lần đang tạm tắt để sửa — dữ liệu tạm khóa, thử lại sau" 503
	}
{% endif %}
{{ trang_chu() }}}

{{ dia_chi(cong.tro_ly_ai) }} {
	import onebee_tls
	import onebee_bo_danh_tinh_co_ban
	reverse_proxy ai-rag:8092 {
		stream_close_delay 5m
	}
}

{# Không thêm tiêu đề CSP ở đây: n8n tự đặt CSP sandbox cho biểu mẫu #}
{{ dia_chi(cong.n8n) }} {
	import onebee_tls
	reverse_proxy n8n:5678 {
		stream_close_delay 5m
	}
}

{{ dia_chi(cong.rest_server) }} {
	import onebee_tls
	request_body {
		max_size 256MB
	}
	reverse_proxy rest-server:8000
}
{% if kuma_san_sang and (onebee_sso_hieu_luc | bool) %}

{# Giám sát sau đăng nhập một lần: chỉ ky_thuat, hai lớp (QĐ7). Luật Authelia không phân biệt cổng → Authelia thấy đường dẫn có tiền tố
   /giam-sat (luật riêng của trang giám sát); tiền tố bỏ trước khi tới Uptime Kuma. Uptime Kuma tắt đăng nhập riêng (onebee-kuma.js) #}
https://{{ ten_box }}:{{ cong.uptime_kuma }} {
	import onebee_tls
	import onebee_bo_danh_tinh_may_khach
	route {
		uri strip_prefix /giam-sat
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			header_up X-Forwarded-Uri /giam-sat{http.request.uri}
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy uptime-kuma:3001 {
			stream_close_delay 5m
		}
	}
}

https://{{ onebee_box_ip }}:{{ cong.uptime_kuma }} {
	import onebee_tls
	redir https://{{ ten_box }}:{{ cong.uptime_kuma }}{uri} 308
}
{% elif kuma_san_sang %}

{# Đăng nhập một lần tạm tắt: Uptime Kuma tự đòi đăng nhập (bộ cài bật lại đăng nhập riêng trước khi mở cổng này) #}
{{ dia_chi(cong.uptime_kuma) }} {
	import onebee_tls
	reverse_proxy uptime-kuma:3001 {
		stream_close_delay 5m
	}
}
{% endif %}
{% elif not demo_hoat_dong %}
# Cổng 80: trang chủ cho mọi tên gọi Box (IP, {{ onebee_box_ten_mdns }}.local qua mDNS)
:80 {
	root * /srv
	file_server
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	header /trang-thai.json Cache-Control no-store
}
{% endif %}
{% if demo_hoat_dong %}

{# Bản chạy thử công khai OLP 2026: tên miền Internet thật, dùng Let's Encrypt ACME mặc định của Caddy (KHÔNG tls internal).
   Giới hạn kích thước tải lên 5MB trên các tuyến nghiệp vụ và gắn tiêu đề nhận diện chế độ demo/giới hạn tần suất AI. #}
https://{{ demo_domain }} {
	header -Server
	header X-OneBee-Demo-Mode 1
	import onebee_bo_danh_tinh_co_ban
	@khong_phai_ai_cli_demo {
		not path /ai-cli/*
	}
	request_header @khong_phai_ai_cli_demo -Authorization
	handle /dangnhap* {
		reverse_proxy authelia:9091
	}
{% if onebee_sso_hieu_luc | bool %}
	handle /api/* {
		route {
			import onebee_sso
			request_body {
				max_size 5MB
			}
			reverse_proxy cau-noi:8080
		}
	}
	@ai_hoi_dap_demo {
		method POST
		path /ai/api/chat /ai/api/generate
	}
	handle @ai_hoi_dap_demo {
		route {
			import onebee_sso
			request_header -Cookie
			request_body {
				max_size 5MB
			}
			header X-OneBee-RateLimit-AI 10r/m
			uri strip_prefix /ai
			reverse_proxy ollama:11434 {
				flush_interval -1
			}
		}
	}
	@ai_rag_demo {
		path /ai /ai/ /ai/hoi /ai/tom-tat /ai/mau /ai/health /ai/api/v1/*
	}
	handle @ai_rag_demo {
		route {
			import onebee_sso
			request_header -Cookie
			request_body {
				max_size 5MB
			}
			header X-OneBee-RateLimit-AI 10r/m
			reverse_proxy ai-rag:8092 {
				header_up X-OneBee-SSO 1
				flush_interval -1
			}
		}
	}
	handle /ai-cli/* {
		route {
			request_header -Cookie
			request_body {
				max_size 5MB
			}
			header X-OneBee-RateLimit-AI 10r/m
			uri strip_prefix /ai-cli
			reverse_proxy ai-rag:8092 {
				flush_interval -1
			}
		}
	}
	handle /ai/* {
		respond 404
	}
	handle /files/* {
		route {
			import onebee_sso
			request_body {
				max_size 5MB
			}
			header Content-Type "text/plain; charset=utf-8"
			respond "Chưa cài kho tệp trên OneBee Box" 503
		}
	}
{% else %}
	@tuyen_loi_demo path /api/* /files/* /ai/* /ai-cli/*
	handle @tuyen_loi_demo {
		header Content-Type "text/plain; charset=utf-8"
		respond "Đăng nhập một lần đang tạm tắt để sửa — dữ liệu tạm khóa, thử lại sau" 503
	}
{% endif %}
{{ trang_chu() }}}
{% endif %}

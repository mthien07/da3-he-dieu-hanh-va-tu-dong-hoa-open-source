# Quản lý bởi OneBee OS — cổng vào và API Gateway của OneBee Box (Caddy 2.11.4 + Authelia forward_auth)
{% if onebee_https_hieu_luc | bool %}
{% set cong = onebee_box_ports %}
{% set kuma_san_sang = onebee_kuma_dia_chi | default('0.0.0.0') == '0.0.0.0' %}
{% set cong_tls = [443, cong.tro_ly_ai, cong.quy_trinh, cong.rest_server] + ([cong.uptime_kuma] if kuma_san_sang else []) %}
{# Mỗi cổng TLS có 2 địa chỉ: IP của Box (LAN) và box.<mã>.onebee.internal (tên chuẩn cho SSO và Tailscale) #}
{% macro dia_chi(c) %}https://{{ onebee_box_ip }}:{{ c }}, https://box.{{ onebee_box_ma_don_vi }}.onebee.internal:{{ c }}{% endmacro %}
{
	skip_install_trust
	auto_https disable_redirects
	# Máy nối bằng IP không gửi SNI; Caddy trong mạng Docker chỉ thấy IP container → luôn dùng chứng chỉ của IP Box
	default_sni {{ onebee_box_ip }}
	pki {
		ca local {
			root {
				cert /pki/root.crt
			}
			intermediate {
				cert /pki/inter.crt
				key /pki/inter.key
			}
		}
	}
{% for c in cong_tls %}
	servers :{{ c }} {
		listener_wrappers {
			http_redirect
			tls
		}
		protocols h1 h2
	}
{% endfor %}
}

# Cổng 80: chỉ phục vụ chứng chỉ gốc CA + trang hướng dẫn (không chuyển hướng sang trang báo lỗi chứng chỉ). Trang này KHÔNG hiện vân tay.
:80 {
	root * /srv-http
	file_server
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

(onebee_tls) {
	tls internal
	header -Server
}

(xac_thuc) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

{{ dia_chi(443) }} {
	import onebee_tls
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
	header /trang-thai.json Cache-Control no-store

	handle /dangnhap* {
		reverse_proxy authelia:9091
	}

	handle /so-dieu-hanh* {
		route {
			import xac_thuc
			root * /srv
			file_server
		}
	}

	# route giữ đúng thứ tự: xác thực trên đường dẫn gốc (luật Authelia khớp ^/api/) rồi mới bỏ tiền tố (ADR 0006)
	handle /api/* {
		route {
			import xac_thuc
			uri strip_prefix /api
			reverse_proxy cau-noi:8080
		}
	}

	handle /files/* {
		route {
			import xac_thuc
			uri strip_prefix /files
			request_body {
				max_size 10MB
			}
			reverse_proxy kho-tep:8080
		}
	}

	handle /ai/* {
		route {
			import xac_thuc
			reverse_proxy ai-rag:8080
		}
	}

	handle /webhook/onebee-phe-duyet {
		route {
			import xac_thuc
			reverse_proxy quy-trinh:1880
		}
	}

	handle {
		root * /srv
		file_server
	}
}

{{ dia_chi(cong.tro_ly_ai) }} {
	import onebee_tls
	reverse_proxy ai-rag:8080 {
		stream_close_delay 5m
	}
}

{{ dia_chi(cong.quy_trinh) }} {
	import onebee_tls
	handle /quy-trinh* {
		route {
			import xac_thuc
			reverse_proxy quy-trinh:1880
		}
	}
	handle {
		reverse_proxy quy-trinh:1880 {
			stream_close_delay 5m
		}
	}
}

{{ dia_chi(cong.rest_server) }} {
	import onebee_tls
	request_body {
		max_size 256MB
	}
	reverse_proxy rest-server:8000
}
{% if kuma_san_sang %}

{{ dia_chi(cong.uptime_kuma) }} {
	import onebee_tls
	reverse_proxy uptime-kuma:3001 {
		stream_close_delay 5m
	}
}
{% endif %}
{% else %}
# Cổng 80: trang chủ và cổng nội bộ ở chế độ HTTP (IP, {{ onebee_box_ten_mdns }}.local qua mDNS)
:80 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	header /trang-thai.json Cache-Control no-store

	handle /api/* {
		route {
			uri strip_prefix /api
			reverse_proxy cau-noi:8080
		}
	}
	handle /files/* {
		route {
			uri strip_prefix /files
			request_body {
				max_size 10MB
			}
			reverse_proxy kho-tep:8080
		}
	}
	handle /ai/* {
		reverse_proxy ai-rag:8080
	}
	handle {
		root * /srv
		file_server
	}
}
{% endif %}

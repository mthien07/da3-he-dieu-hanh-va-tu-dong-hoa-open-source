# Quản lý bởi OneBee OS — chứa khóa bí mật, chỉ root đọc được
WEBUI_SECRET_KEY={{ lookup('ansible.builtin.password', onebee_box_secrets ~ '/webui-secret-key', chars=['ascii_letters', 'digits'], length=48) }}
WEBUI_ADMIN_PASSWORD={{ lookup('ansible.builtin.password', onebee_box_secrets ~ '/webui-admin-password', chars=['ascii_letters', 'digits'], length=24) }}
# Dịch vụ dữ liệu (PostgREST) đăng nhập PostgreSQL bằng vai trò xac_thuc (mật khẩu do role box-du-lieu đặt bằng ALTER ROLE)
PGRST_DB_URI=postgres://xac_thuc:{{ lookup('ansible.builtin.password', onebee_box_secrets ~ '/postgrest-password', chars=['ascii_letters', 'digits'], length=32) }}@postgres:5432/onebee

#!/usr/bin/env bash
# onebee-box — lệnh quản trị OneBee Box (quản lý bởi OneBee OS, không sửa tay)
#   onebee-box trang-thai          Xem dịch vụ đang chạy, dung lượng ổ
#   onebee-box them-may <ten-may>  Cấp tài khoản sao lưu, khóa Trợ lý AI, quản lý cho 1 máy trạm; in cấu hình dán vào máy trạm
#   onebee-box may-tram            Tình trạng các máy trạm: sao lưu, cập nhật, ổ đĩa, lần liên lạc cuối
#   onebee-box cap-nhat-may <ten-may>|--tat-ca   Cập nhật phần mềm máy trạm từ Box (qua SSH; máy phải chứng minh được là máy đã cấp)
#   onebee-box dong-bo-may <ten-may>|--tat-ca    Đẩy lại cấu hình (may-tram.env) từ Box xuống máy trạm (qua SSH, như trên)
#   onebee-box thu-hoi-may <ten-may> [--dong-y]  Thu hồi máy trạm (khóa Trợ lý AI, kho sao lưu HTTP, ghim SSH, chỗ báo tình trạng)
#   onebee-box ghim-lai-may <ten-may>            Máy cài lại hệ điều hành: bỏ khóa SSH đã ghim để ghim lại
#   onebee-box bao-cao-tuan [YYYY-MM-DD]   Nhật ký tuần: yêu cầu hỗ trợ, khảo sát, tình trạng máy (Markdown)
#   onebee-box dong-bo-tro-ly      Tạo/cập nhật "Trợ lý OneBee" (model Gemma + lời dặn tiếng Việt) trong Open WebUI
#   onebee-box khoi-tao            Tạo kho sao lưu Box trên ổ ngoài (làm 1 lần sau khi gắn ổ)
#   onebee-box sao-luu             Sao lưu Box ra ổ ngoài + dọn bản cũ (tự chạy 23:00 hằng ngày)
#   onebee-box khoi-phuc-thu       Thử khôi phục 1 file từ bản sao lưu Box (kiểm tra sao lưu dùng được)
#   onebee-box khoi-phuc-toan-bo [file-khóa]   Hỏng ổ Box: trên Box cài lại, lấy lại toàn bộ dữ liệu từ ổ sao lưu
#   onebee-box may-chua-nhan-ca    Máy đã cấp mà chưa nhận CA hiện tại (chặn bật HTTPS)
#   onebee-box go-khoa-hoi-may     Xóa tài khoản/khóa Trợ lý AI theo MÁY (sau khi nhân viên đã dùng khóa riêng; xem onebee_box_hoi_khoa_may)
#   onebee-box xoay-khoa [--may <tên>|--tat-ca] [--box]   Đổi mật khẩu/khóa (kho HTTP + khóa hoi theo máy; --box: mật khẩu quản trị, biểu mẫu, n8n)
#   onebee-box in-ca               In vân tay + thông tin CA riêng của Box (đối chiếu khi cài CA lên thiết bị khác)
#   onebee-box in-khoa             In các khóa bí mật để cất ngoài Box (thiếu khóa thì bản sao lưu vô dụng)
#   onebee-box dat-mat-khau-email  Nhập mật khẩu hộp thư gửi (SMTP) cho n8n
#   onebee-box email-thu           Gửi 1 email thử qua n8n (kiểm tra cấu hình email)
set -euo pipefail
LIB=/usr/local/lib/onebee-box
# shellcheck source=/dev/null
. "${LIB}/common.sh"
# shellcheck source=/dev/null
. "${LIB}/sao-luu.sh"

[[ ${EUID} -eq 0 ]] || die "Hãy chạy bằng quyền quản trị: sudo onebee-box $*"

# File/thư mục tạm có bí mật (cấu hình đẩy xuống máy, inventory…) được dọn khi thoát, KỂ CẢ thoát bằng die (trap RETURN không chạy khi exit)
TAM_DON=()
don_tam() { [[ -z "${TAM_DON[*]:-}" ]] || rm -rf "${TAM_DON[@]}"; }
trap don_tam EXIT

cmd_trang_thai() {
  compose ps --format 'table {{ '{{' }}.Name{{ '}}' }}\t{{ '{{' }}.Status{{ '}}' }}'
  echo; df -h "${DATA}" | tail -1 | awk '{print "Ổ dữ liệu: đã dùng " $3 "/" $2 " (" $5 ")"}'
  if mountpoint -q "${BACKUP_MOUNT}"; then df -h "${BACKUP_MOUNT}" | tail -1 | awk '{print "Ổ sao lưu: đã dùng " $3 "/" $2 " (" $5 ")"}'
  else echo "Ổ sao lưu: CHƯA GẮN (${BACKUP_MOUNT})"; fi
  echo "CA riêng của Box (mã ${BOX_MA_DON_VI}): gốc còn $(ca_con_ngay root) ngày, trung gian còn $(ca_con_ngay inter) ngày (tự gia hạn khi còn < 60 ngày, lúc sao lưu đêm)"
}

# Vân tay + nội dung ràng buộc của CA gốc — quản trị đối chiếu với màn hình/giấy in khi cài CA lên máy quản lý, laptop kỹ thuật, điện thoại
cmd_in_ca() {
  local vt
  [[ -s "${CA_DIR}/root.crt" ]] || die "Chưa có CA — chạy bộ cài OneBee Box (cần khai onebee_box_ma_don_vi trong group_vars)"
  vt="$(ca_van_tay)"
  echo "CA riêng OneBee Box — mã đơn vị ${BOX_MA_DON_VI}, địa chỉ ${BOX_ADDRESS}"
  echo "Vân tay SHA-256 (đối chiếu từng cặp ký tự với bản in; KHÔNG đối chiếu với thứ hiện trên trang web):"
  echo "  $(echo "${vt}" | tr 'a-f' 'A-F' | sed 's/../&:/g; s/:$//')"
  echo "Hiệu lực: gốc còn $(ca_con_ngay root) ngày, trung gian còn $(ca_con_ngay inter) ngày"
  echo "Chỉ được cấp chứng chỉ cho:"
  openssl x509 -in "${CA_DIR}/root.crt" -noout -ext nameConstraints | sed -n '3,$p'
  echo "Tải chứng chỉ gốc: http://${BOX_ADDRESS}/onebee-ca.crt  (hoặc chép bằng USB từ ${CA_DIR}/root.crt)"
}

# In cấu hình dán vào máy trạm — CHỈ ĐỌC bí mật đã có (không tạo tài khoản/khóa, không ghi htpasswd). Thiếu bí mật nào thì dừng (die),
# không in cấu hình thiếu. them-may tạo bí mật trước rồi gọi hàm này; dong-bo-may gọi lại để đẩy cấu hình xuống máy.
in_cau_hinh_may() {
  local ten="$1" ip http_pw repo_pw tram_key="" hoi_key="" f esq
  # Kiểm đủ bí mật TRƯỚC khi in gì (die gọi thẳng ở đây; die trong $(…) chỉ thoát subshell của nó, hàm vẫn in tiếp file thiếu mật khẩu)
  for f in "${SECRETS}/may-${ten}-http" "${SECRETS}/may-${ten}-repo" "${SSH_DIR}/quan-tri.pub" "${CA_DIR}/root.crt"; do
    [[ -s "${f}" ]] || die "Thiếu ${f} — máy ${ten} chưa cấp đủ hoặc đã thu hồi (cấp lại: sudo onebee-box them-may ${ten})"
  done
  ip="$(box_ip)"; [[ -n "${ip}" ]] || die "Không xác định được IP của Box — đặt onebee_box_dia_chi trong group_vars"
  http_pw="$(cat "${SECRETS}/may-${ten}-http")"
  repo_pw="$(cat "${SECRETS}/may-${ten}-repo")"
  if [[ "${TINH_TRANG_KHOA_CHUNG}" == true ]]; then
    [[ -s "${SECRETS}/tinh-trang-key" ]] || die "Thiếu ${SECRETS}/tinh-trang-key — chạy lại bộ cài OneBee Box"
    tram_key="$(cat "${SECRETS}/tinh-trang-key")"
  fi
  # Đã lưu khóa thì dùng. Máy từng có tài khoản Trợ lý AI mà chưa lưu khóa (cấp từ bản cũ) → lấy lại khóa đã cấp, KHÔNG tạo mới;
  # lấy không được thì dừng (không in cấu hình thiếu dòng hoi). Máy chưa từng có tài khoản thì không in dòng hoi
  if [[ "${HOI_KHOA_MAY}" != true ]]; then
    hoi_key=""   # không còn khóa theo máy: nhân viên tự đăng nhập (hoi --dang-nhap)
  elif [[ -s "${SECRETS}/may-${ten}-hoi" ]]; then
    hoi_key="$(cat "${SECRETS}/may-${ten}-hoi")"
  elif [[ -e "${SECRETS}/may-${ten}-webui" ]]; then
    hoi_key="$(webui lay-khoa "${ten}")" || die "Không lấy được khóa Trợ lý AI của máy ${ten} (Open WebUI chưa chạy?) — thử lại sau"
    (umask 077; printf '%s' "${hoi_key}" >"${SECRETS}/may-${ten}-hoi")
  fi
  echo "MAY_TRAM=${ten}"
  echo "BOX_IP=${ip}"
  esq="$(giao_thuc_may)"
  echo "RESTIC_REPOSITORY=rest:${esq}://${ten}:${http_pw}@${ip}:${REST_PORT}/${ten}/"
  echo "RESTIC_PASSWORD=${repo_pw}"
  # Địa chỉ Trợ lý AI luôn in (hoi --dang-nhap cần); khóa của MÁY chỉ in ở giai đoạn chuyển tiếp
  echo "HOI_URL=${esq}://${ip}:${AI_PORT}"
  [[ -z "${hoi_key}" ]] || echo "HOI_API_KEY=${hoi_key}"
  echo "TINH_TRANG_URL=${esq}://${ip}:${N8N_PORT}/webhook/onebee-tinh-trang"
  [[ -z "${tram_key}" ]] || echo "TINH_TRANG_KEY=${tram_key}"
  echo "QUAN_TRI_SSH_KEY=\"$(cat "${SSH_DIR}/quan-tri.pub")\""
  # CA riêng của Box: chứng chỉ gốc (DER, base64 một dòng) + vân tay tính lại từ chứng chỉ. Máy trạm (role ket-noi-box) kiểm vân tay
  # VÀ kiểm chứng chỉ đúng là CA có ràng buộc tên (chỉ IP Box + *.onebee.internal) rồi mới cài
  echo "BOX_CA=$(openssl x509 -in "${CA_DIR}/root.crt" -outform DER | base64 -w0)"
  echo "BOX_CA_VAN_TAY=$(ca_van_tay)"
  # Cờ HTTPS: 1 = máy ghi dấu bền và từ chối http://; 0 = Box hoàn tác HTTPS (chỉ cờ này mới xóa dấu trên máy)
  if https_bat; then echo "BOX_HTTPS=1"; else echo "BOX_HTTPS=0"; fi
}

cmd_them_may() {
  local ten="${1:-}" ip http_pw repo_pw hoi_key thoi_diem
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Tên máy chỉ gồm chữ thường không dấu, số, dấu gạch (vd: ketoan-01)"
  ip="$(box_ip)"; [[ -n "${ip}" ]] || die "Không xác định được IP của Box — đặt onebee_box_dia_chi trong group_vars"
  if [[ -e "${SECRETS}/thu-hoi/${ten}" ]]; then
    # Cấp lại cho máy từng thu hồi: máy cũ (mất cắp, nghi chiếm) vẫn biết MẬT KHẨU KHO cũ — mà mật khẩu kho là khóa ký báo cáo và là bằng chứng
    # danh tính máy → phải đổi. Cất kho + mật khẩu cũ sang tên khác (mở lại dữ liệu cũ bằng restic khi cần; in-khoa vẫn in mật khẩu cũ),
    # máy mới bắt đầu kho mới. Mật khẩu kho HTTP và tài khoản Trợ lý AI cũng được tạo mới.
    thoi_diem="$(date +%Y%m%d-%H%M%S)"
    [[ ! -e "${SECRETS}/may-${ten}-repo" ]] || mv "${SECRETS}/may-${ten}-repo" "${SECRETS}/cu-${ten}-repo-${thoi_diem}"
    [[ ! -d "${DATA}/restic/${ten}" ]] || mv "${DATA}/restic/${ten}" "${DATA}/restic/${ten}.cu-${thoi_diem}"
    rm -f "${SECRETS}/thu-hoi/${ten}"
  fi
  http_pw="$(secret "may-${ten}-http")"
  repo_pw="$(secret "may-${ten}-repo")"
  [[ "${TINH_TRANG_KHOA_CHUNG}" != true ]] || secret tinh-trang-key >/dev/null
  # -i: đọc mật khẩu từ stdin (không lộ trong danh sách tiến trình)
  htpasswd -B -i "${DATA}/restic/.htpasswd" "${ten}" <<<"${http_pw}" 2>/dev/null
  hoi_key=""
  if [[ "${HOI_KHOA_MAY}" == true ]]; then
    hoi_key="$(webui cap-khoa "${ten}")" || {
      warn "Chưa cấp được khóa Trợ lý AI (Open WebUI chưa chạy?) — sao lưu vẫn dùng được; chạy lại lệnh này sau để bật hoi"
      hoi_key=""
    }
  fi
  [[ -z "${hoi_key}" ]] || (umask 077; printf '%s' "${hoi_key}" >"${SECRETS}/may-${ten}-hoi")
  dong_bo_ten_may >/dev/null
  echo "# Dán nội dung dưới đây vào máy trạm ${ten}: /etc/onebee/may-tram.env, rồi chạy lại bộ cài OneBee OS"
  in_cau_hinh_may "${ten}"
}

# Thu hồi 1 máy trạm (mất máy, nhân viên nghỉ, máy bị nghi giả mạo): khóa Trợ lý AI, mật khẩu kho HTTP, ghim SSH và chỗ nhận báo cáo bị gỡ.
# Giữ lại kho sao lưu và mật khẩu kho của máy (để khôi phục dữ liệu / dọn bản cũ). Chạy lại lệnh này an toàn (dọn tiếp phần còn sót).
cmd_thu_hoi_may() {
  local ten="${1:-}" xac_nhan="${2:-}" tra_loi
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ && -e "${SECRETS}/may-${ten}-repo" ]] || die "Cách dùng: sudo onebee-box thu-hoi-may <tên-máy-đã-cấp> [--dong-y]"
  if [[ "${xac_nhan}" != --dong-y ]]; then
    read -rp "Thu hồi máy ${ten}? Máy sẽ không sao lưu, hỏi Trợ lý AI, báo tình trạng hay nhận cập nhật được nữa. Gõ 'thu hoi' để xác nhận: " tra_loi \
      || die "Cần xác nhận: chạy trong cửa sổ dòng lệnh, hoặc thêm --dong-y"
    [[ "${tra_loi}" == "thu hoi" ]] || die "Đã hủy"
  fi
  (umask 077; mkdir -p "${SECRETS}/thu-hoi"; : >"${SECRETS}/thu-hoi/${ten}")   # đánh dấu TRƯỚC: lỡ dừng giữa chừng thì máy đã bị coi là thu hồi
  htpasswd -D "${DATA}/restic/.htpasswd" "${ten}" 2>/dev/null || true
  webui xoa-tai-khoan "${ten}" || warn "Chưa xóa được tài khoản Trợ lý AI may-${ten}@onebee.lan (Open WebUI chưa chạy?) — chạy lại lệnh này sau"
  rm -f "${SECRETS}/may-${ten}-http" "${SECRETS}/may-${ten}-webui" "${SECRETS}/may-${ten}-hoi" "${DATA}/tinh-trang-may/${ten}.json"
  ssh-keygen -R "${ten}" -f "${SSH_DIR}/known_hosts" >/dev/null 2>&1 || true
  dong_bo_ten_may >/dev/null
  echo "Đã thu hồi máy ${ten}. Kho sao lưu của máy vẫn còn trên Box. Cấp lại (mật khẩu kho mới, kho cũ cất riêng): sudo onebee-box them-may ${ten}"
  echo "LƯU Ý: chạy NGAY 'sudo onebee-box sao-luu' để bản sao lưu Box ghi nhận việc thu hồi — nếu ổ hỏng trước lần sao lưu 23:00, khôi phục sẽ cấp lại máy này."
}

# Bỏ khóa Trợ lý AI theo MÁY (Pha 4c): xóa tài khoản may-<tên>@onebee.lan trên Open WebUI + khóa đã lưu. Chỉ sau khi đặt onebee_box_hoi_khoa_may: false
# và chạy lại bộ cài + dong-bo-may --tat-ca (để máy không còn HOI_API_KEY). Nhân viên chưa chạy 'hoi --dang-nhap' sẽ không hỏi được nữa.
cmd_go_khoa_hoi_may() {
  local ten loi=0
  [[ "${HOI_KHOA_MAY}" != true ]] || die "Chưa tắt khóa theo máy: đặt onebee_box_hoi_khoa_may: false trong group_vars, chạy lại bộ cài, rồi dong-bo-may --tat-ca trước"
  while read -r ten; do
    webui xoa-tai-khoan "${ten}" >/dev/null || { warn "Chưa xóa được tài khoản Trợ lý AI của máy ${ten} (Open WebUI chưa chạy?)"; loi=1; continue; }
    rm -f "${SECRETS}/may-${ten}-webui" "${SECRETS}/may-${ten}-hoi"
    echo "Đã bỏ khóa Trợ lý AI theo máy: ${ten}"
  done < <(may_da_cap)
  return "${loi}"
}

# Máy cài lại hệ điều hành (khóa SSH của máy đổi): bỏ khóa đã ghim; lần cap-nhat-may sau máy phải chứng minh lại rồi mới được ghim mới
cmd_ghim_lai_may() {
  local ten="${1:-}"
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Cách dùng: sudo onebee-box ghim-lai-may <tên-máy>"
  ssh-keygen -R "${ten}" -f "${SSH_DIR}/known_hosts" >/dev/null 2>&1 || true
  echo "Đã bỏ khóa SSH đã ghim của máy ${ten}. Máy báo tình trạng lại (có chữ ký) rồi chạy: sudo onebee-box cap-nhat-may ${ten}"
}

cmd_bao_cao_tuan() {
  local ngay="${1:-$(date +%F)}"
  local -a may=()
  [[ "${ngay}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "Ngày theo dạng YYYY-MM-DD, ví dụ $(date +%F)"
  mapfile -t may < <(gio_sao_luu_may)
  may_tram_py payload DAT "" "${may[@]}" | python3 /usr/local/lib/onebee-box/onebee-bao-cao-tuan.py "${DATA}/ho-tro" "${ngay}"
}

cmd_may_tram() {
  local -a may=()
  mapfile -t may < <(gio_sao_luu_may)
  may_tram_py bang "${may[@]}"
}

# ---- Vào máy trạm qua SSH (cap-nhat-may, dong-bo-may) ----
# Địa chỉ IP do máy trạm tự báo qua HTTP nên KHÔNG đủ tin để đem khóa quản trị (root trên máy) tới đó. Quy tắc (rà soát bảo mật F2):
#  - máy CHƯA ghim khóa SSH: chỉ dùng IP trong báo cáo CÓ CHỮ KÝ HỢP LỆ, mới trong 2 giờ; lần đầu vào phải CHỨNG MINH máy biết
#    mật khẩu kho sao lưu (chưa từng đi qua mạng) rồi mới ghim khóa SSH của máy; máy giả không biết mật khẩu → không được ghim/không nhận gì;
#  - máy ĐÃ ghim: SSH với StrictHostKeyChecking=yes (khóa lệch thì dừng) và chứng minh lại mỗi lần (phòng khóa ghim cũ do bản trước tạo).

la_may_da_cap() {
  local t
  while read -r t; do [[ "${t}" == "$1" ]] && return 0; done < <(may_da_cap)
  return 1
}

# Tên máy được chọn bởi <tên>|--tat-ca (chỉ máy đã cấp, chưa thu hồi) → mảng CHON_MAY
chon_may() {
  local muc="${1:-}"
  CHON_MAY=()
  if [[ "${muc}" == --tat-ca ]]; then
    mapfile -t CHON_MAY < <(may_da_cap)
  elif [[ "${muc}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] && la_may_da_cap "${muc}"; then
    CHON_MAY=("${muc}")
  else
    return 1
  fi
  [[ -n "${CHON_MAY[*]:-}" ]]
}

# SSH vào máy bằng khóa quản trị, đọc mật khẩu kho sao lưu trên máy, so với bản Box giữ. Thành công = đúng máy đã cấp.
# $1=tên $2=IP $3=file known_hosts $4=StrictHostKeyChecking (yes | accept-new). Lý do thất bại in ra stderr (không in mật khẩu).
chung_minh_may() {
  local ten="$1" ip="$2" kh="$3" mode="$4" pw dong loi
  pw="$(secret_co_san "may-${ten}-repo")"
  loi="$(mktemp)"
  # -n: ssh KHÔNG được đọc stdin — hàm này chạy trong vòng lặp "while read" đọc danh sách máy; thiếu -n thì ssh nuốt các dòng còn lại
  if ! dong="$(ssh -n -i "${SSH_DIR}/quan-tri" -o BatchMode=yes -o IdentitiesOnly=yes -o UserKnownHostsFile="${kh}" \
        -o StrictHostKeyChecking="${mode}" -o HostKeyAlias="${ten}" -o UpdateHostKeys=no -o ConnectTimeout=10 \
        "onebee-quantri@${ip}" 'sudo grep -m1 "^RESTIC_PASSWORD=" /etc/onebee/may-tram.env' 2>"${loi}")"; then
    warn "Không SSH vào ${ten} (${ip}) được: $(tail -n 1 "${loi}")"
    rm -f "${loi}"; return 1
  fi
  rm -f "${loi}"
  dong="${dong#RESTIC_PASSWORD=}"; dong="${dong//$'\r'/}"; dong="${dong#\"}"; dong="${dong%\"}"
  [[ -n "${pw}" && "${dong}" == "${pw}" ]]
}

# Ghi inventory $1 với các máy (tên ở các tham số còn lại) đủ điều kiện vào được → mảng VAO_DUOC
chuan_bi_may() {
  local inv="$1"; shift
  local -a ghim=()
  local t ip trang tmp kh="${SSH_DIR}/known_hosts"
  VAO_DUOC=()
  mkdir -p "${SSH_DIR}"; (umask 077; touch "${kh}")
  for t in "$@"; do
    if ssh-keygen -F "${t}" -f "${kh}" >/dev/null 2>&1; then ghim+=("${t}"); fi
  done
  echo "[may_tram]" >"${inv}"
  while read -r t ip trang; do
    if [[ "${trang}" == chua-ghim ]]; then
      tmp="$(mktemp)"
      if ! chung_minh_may "${t}" "${ip}" "${tmp}" accept-new; then
        warn "Bỏ qua ${t}: máy ở ${ip} KHÔNG chứng minh được là máy đã cấp (mật khẩu kho sao lưu trên máy khác Box giữ, hoặc không vào được) — không ghim, không gửi gì"
        rm -f "${tmp}"; continue
      fi
      cat "${tmp}" >>"${kh}"
      echo "Đã ghim khóa SSH của ${t} ($(ssh-keygen -lf "${tmp}" 2>/dev/null | awk 'NR==1 {print $2}')) sau khi máy chứng minh biết mật khẩu kho sao lưu"
      rm -f "${tmp}"
    elif ! chung_minh_may "${t}" "${ip}" "${kh}" yes; then
      warn "Bỏ qua ${t}: khóa SSH đã ghim không khớp hoặc máy không chứng minh được. Máy vừa cài lại hệ điều hành? → sudo onebee-box ghim-lai-may ${t}. (Địa chỉ ${ip} có thể lấy từ báo cáo chưa ký — nếu máy không hề cài lại, có thể có máy khác đang giả danh.)"
      continue
    fi
    echo "${t} ansible_host=${ip} ansible_ssh_extra_args='-o HostKeyAlias=${t}'" >>"${inv}"
    VAO_DUOC+=("${t}")
  done < <(export ONEBEE_DA_GHIM; ONEBEE_DA_GHIM="$(IFS=,; echo "${ghim[*]-}")"; may_tram_py kho "$@")
  for t in "$@"; do
    trong_mang "${t}" "${VAO_DUOC[@]}" || printf '%s\n' "${t}" >>"${TEN_BO_QUA}"
  done
}

# Chạy playbook $1 (trong ${LIB}) trên các máy đang chọn trong CHON_MAY; $2 = tên viết tắt cho file nhật ký; $3.. = tham số ansible thêm
chay_playbook_chon() {
  local playbook="$1" ten_log="$2"; shift 2
  local inv log st t
  inv="$(mktemp)"; TEN_BO_QUA="$(mktemp)"
  TAM_DON+=("${inv}" "${TEN_BO_QUA}")
  chuan_bi_may "${inv}" "${CHON_MAY[@]}"
  while read -r t; do
    [[ -z "${t}" ]] || warn "Bỏ qua ${t}: máy chưa báo tình trạng hợp lệ trong 2 giờ qua (máy tắt? chưa chạy bộ cài mới có ký báo cáo? chưa biết địa chỉ)"
  done <"${TEN_BO_QUA}"
  [[ -n "${VAO_DUOC[*]:-}" ]] || die "Không có máy nào để làm"
  # Nhật ký chứa tên máy, địa chỉ → chỉ root đọc; mọi task đụng mật khẩu đều có no_log trong playbook
  install -d -m 0700 /var/log/onebee-box
  log="/var/log/onebee-box/${ten_log}-$(date +%Y%m%d-%H%M%S).log"
  (umask 077; : >"${log}")
  set +e
  ANSIBLE_SSH_ARGS="-o UserKnownHostsFile=${SSH_DIR}/known_hosts -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=6 -o ControlMaster=auto -o ControlPersist=60s" \
  ANSIBLE_ROLES_PATH="${LIB}/roles" ANSIBLE_PYTHON_INTERPRETER=/usr/bin/python3 ANSIBLE_RETRY_FILES_ENABLED=False ANSIBLE_NOCOLOR=1 ANSIBLE_LOCAL_TEMP=/root/.ansible/tmp \
    ansible-playbook -i "${inv}" -u onebee-quantri --private-key "${SSH_DIR}/quan-tri" "$@" "${LIB}/${playbook}" 2>&1 | tee -a "${log}"
  st=${PIPESTATUS[0]}
  set -e
  [[ ${st} -eq 0 ]] || warn "Có máy chưa xong (máy tắt, mất mạng hoặc lỗi) — xem ${log}. Máy đã cài lại hệ điều hành (báo HOST IDENTIFICATION HAS CHANGED / khóa SSH không khớp): sudo onebee-box ghim-lai-may <tên-máy> rồi chạy lại"
  return "${st}"
}

cmd_cap_nhat_may() {
  chon_may "${1:-}" || die "Cách dùng: sudo onebee-box cap-nhat-may <tên-máy-đã-cấp> | --tat-ca   (chưa cấp máy nào: sudo onebee-box them-may <tên-máy>)"
  chay_playbook_chon cap-nhat-may-tram.yml cap-nhat-may
}

# Đẩy lại cấu hình (/etc/onebee/may-tram.env) từ Box xuống máy trạm — dùng khi đổi khóa/URL; nguồn cấu hình duy nhất là in_cau_hinh_may.
# Chỉ đẩy tới máy đã chứng minh được; thiếu bí mật nào của máy thì bỏ qua máy đó (không đẩy file thiếu). File cũ được giữ lại .~ trên máy.
# Chỉ cập nhật FILE cấu hình và kiểm báo cáo chạy được; các file sinh từ cấu hình (/etc/onebee-hoi.conf, mục menu…) do bộ cài desktop
# tạo lại — chạy lại bộ cài trên máy sau khi đổi hoi/URL (từ Pha 3 Box sẽ tự làm bước này).
cmd_dong_bo_may() {
  if [[ "${1:-}" == --tat-ca && -z "$(may_da_cap)" ]]; then echo "Chưa cấp máy trạm nào — không có gì để đồng bộ."; return 0; fi
  chon_may "${1:-}" || die "Cách dùng: sudo onebee-box dong-bo-may <tên-máy-đã-cấp> | --tat-ca"
  cmd_dong_bo_may_da_chon
}

# Đẩy cấu hình xuống các máy đang nằm trong CHON_MAY (đã qua chon_may)
cmd_dong_bo_may_da_chon() {
  local thu_muc t
  local -a co=()
  thu_muc="$(mktemp -d)"   # 0700; nội dung cấu hình chứa mật khẩu → xóa khi thoát (kể cả thoát lỗi)
  TAM_DON+=("${thu_muc}")
  for t in "${CHON_MAY[@]}"; do
    # Dựng trong subshell: thiếu bí mật thì die chỉ dừng subshell → bỏ qua máy đó, KHÔNG đẩy file thiếu
    if ( umask 077; in_cau_hinh_may "${t}" >"${thu_muc}/${t}.env" ); then co+=("${t}")
    else warn "Bỏ qua ${t}: không dựng được cấu hình (thiếu bí mật — máy mới cấp dở?)"; rm -f "${thu_muc}/${t}.env"; fi
  done
  [[ -n "${co[*]:-}" ]] || die "Không dựng được cấu hình cho máy nào"
  CHON_MAY=("${co[@]}")
  # Dấu "máy đã nhận CA" do playbook ghi (task cuối, chỉ khi CA đã cài đúng vân tay) — cổng chặn bật HTTPS dựa vào dấu này
  (umask 077; mkdir -p "${SECRETS}/ca-da-dong-bo")
  chay_playbook_chon dong-bo-may-tram.yml dong-bo-may -e "onebee_cau_hinh_dir=${thu_muc}" -e "onebee_dau_ca_dir=${SECRETS}/ca-da-dong-bo"
}

# ---- Xoay khóa (Pha 4b) ----
# Lý do: trước khi có HTTPS, mật khẩu/khóa đã đi qua LAN dạng rõ — còn hiệu lực dù hôm nay đã mã hóa. Cũng dùng khi nghi ngờ lộ khóa.
# RESTIC_PASSWORD KHÔNG xoay (chưa từng đi qua mạng; đổi là mất bản sao lưu cũ). N8N_ENCRYPTION_KEY KHÔNG xoay (đổi là mất thông tin đăng nhập đã lưu trong n8n).

# Một máy: mật khẩu kho HTTP mới (htpasswd) + khóa Trợ lý AI theo máy mới (nếu còn dùng). Ghi bí mật mới TRƯỚC khi đẩy xuống máy
xoay_khoa_may() {
  local ten="$1" khoa_moi
  rm -f "${SECRETS}/may-${ten}-http"
  htpasswd -B -i "${DATA}/restic/.htpasswd" "${ten}" <<<"$(secret "may-${ten}-http")" 2>/dev/null
  if [[ "${HOI_KHOA_MAY}" == true && -e "${SECRETS}/may-${ten}-webui" ]]; then
    khoa_moi="$(webui xoay-khoa "${ten}")" || { warn "Chưa đổi được khóa Trợ lý AI của máy ${ten} (Open WebUI chưa chạy?) — giữ khóa cũ"; return 0; }
    (umask 077; printf '%s' "${khoa_moi}" >"${SECRETS}/may-${ten}-hoi")
  fi
  echo "Đã tạo mật khẩu mới cho máy ${ten}"
}

# Phía Box: mật khẩu quản trị Trợ lý AI + giám sát (đổi trong CSDL của dịch vụ), mật khẩu chủ n8n, mật khẩu biểu mẫu, khóa webhook n8n,
# WEBUI_SECRET_KEY (hủy mọi phiên đăng nhập Open WebUI). Phần Ansible áp dụng (.env, thông tin đăng nhập n8n) cần chạy lại bộ cài ngay sau đó
xoay_khoa_box() {
  local moi
  moi="$(ngau_nhien 24)"
  ONEBEE_MAT_KHAU_MOI="${moi}" webui doi-mat-khau-quan-tri
  (umask 077; printf '%s' "${moi}" >"${SECRETS}/webui-admin-password")
  if [[ -e "${SECRETS}/uptime-kuma-da-co-quan-tri" ]]; then
    moi="$(ngau_nhien 24)"
    KUMA_USER=quantri KUMA_PASS="$(cat "${SECRETS}/uptime-kuma-password")" KUMA_PASS_MOI="${moi}" \
      docker exec -i -w /app -e KUMA_USER -e KUMA_PASS -e KUMA_PASS_MOI onebee-uptime-kuma node - </usr/local/lib/onebee-box/onebee-kuma.js \
      || die "Không đổi được mật khẩu giám sát — các mật khẩu khác CHƯA đổi thêm. Kiểm tra: sudo onebee-box trang-thai"
    (umask 077; printf '%s' "${moi}" >"${SECRETS}/uptime-kuma-password")
  fi
  moi="$(ngau_nhien 24)"
  (umask 077; printf '%s' "${moi}" >"${SECRETS}/n8n-owner-password"
   htpasswd -niBC 10 onebee <<<"${moi}" | cut -d: -f2 | tr -d '\n' >"${SECRETS}/n8n-owner-hash")
  # Khóa gửi tình trạng dùng chung (nếu còn dùng): bộ cài sinh lại; PHẢI đẩy xuống máy bằng dong-bo-may --tat-ca ngay sau đó
  [[ "${TINH_TRANG_KHOA_CHUNG}" != true ]] || { rm -f "${SECRETS}/tinh-trang-key"; echo "LƯU Ý: sau bộ cài, chạy: sudo onebee-box dong-bo-may --tat-ca (khóa gửi tình trạng đã đổi)"; }
  rm -f "${SECRETS}/webui-secret-key" "${SECRETS}/bieu-mau-nhanvien" "${SECRETS}/bieu-mau-kythuat" "${SECRETS}/n8n-webhook-key"
  # Bộ cài (Ansible lookup password) sinh lại các file vừa xóa; n8n-webhook-key cần có NGAY cho bao_cao_n8n ở lần chạy sau
  secret n8n-webhook-key >/dev/null
  echo "Đã đổi: mật khẩu quản trị Trợ lý AI và giám sát (trong dịch vụ); đã tạo mới: mật khẩu chủ n8n, mật khẩu biểu mẫu (nhanvien, kythuat), khóa webhook n8n, WEBUI_SECRET_KEY."
}

cmd_xoay_khoa() {
  local box=0 muc="" a tra_loi t bo_cai
  local -a ds=()
  while [[ $# -gt 0 ]]; do
    a="$1"; shift
    case "${a}" in
      --box) box=1 ;;
      --tat-ca) muc=--tat-ca ;;
      --may) muc="${1:-}"; [[ $# -eq 0 ]] || shift ;;
      --dong-y) tra_loi="dong-y" ;;
      *) die "Cách dùng: sudo onebee-box xoay-khoa [--may <tên-máy> | --tat-ca] [--box] [--dong-y]" ;;
    esac
  done
  [[ -n "${muc}" || ${box} -eq 1 ]] || die "Cách dùng: sudo onebee-box xoay-khoa [--may <tên-máy> | --tat-ca] [--box] [--dong-y]"
  if [[ -n "${muc}" ]]; then chon_may "${muc}" || die "Máy không tồn tại hoặc chưa cấp: ${muc}"; ds=("${CHON_MAY[@]}"); fi
  if [[ "${tra_loi:-}" != dong-y ]]; then
    read -rp "Xoay khóa: ${ds[*]:-} $([[ ${box} -eq 1 ]] && echo '+ khóa của Box') — máy tắt sẽ mất quyền sao lưu/hỏi AI tới khi 'dong-bo-may'. Gõ 'xoay khoa' để xác nhận: " tra_loi \
      || die "Cần xác nhận: chạy trong cửa sổ dòng lệnh, hoặc thêm --dong-y"
    [[ "${tra_loi}" == "xoay khoa" ]] || die "Đã hủy"
  fi
  for t in "${ds[@]}"; do xoay_khoa_may "${t}"; done
  if [[ ${box} -eq 1 ]]; then
    xoay_khoa_box
    bo_cai="$(cat "${LIB}/duong-dan-bo-cai" 2>/dev/null || true)"
    if [[ -x "${bo_cai}" ]]; then
      echo "Chạy bộ cài để áp dụng (.env, thông tin đăng nhập n8n)..."
      "${bo_cai}" || die "Bộ cài chưa xong — chạy lại NGAY: sudo ${bo_cai} (Box đang ở trạng thái nửa chừng)"
    else
      warn "KHÔNG tìm thấy bộ cài — chạy NGAY bộ cài OneBee Box (sudo ./box/onebee-box-install.sh) để áp dụng; trước đó n8n/biểu mẫu/báo cáo sao lưu có thể lỗi"
    fi
  fi
  if [[ -n "${ds[*]:-}" ]]; then
    echo "Đẩy cấu hình mới xuống máy..."
    CHON_MAY=("${ds[@]}")
    cmd_dong_bo_may_da_chon || warn "Có máy chưa nhận được mật khẩu mới (tắt/mất mạng): bật máy lên rồi chạy: sudo onebee-box dong-bo-may <tên-máy>"
  fi
  echo "Xong. In lại khóa để cất: sudo onebee-box in-khoa. Nhân viên đổi mật khẩu Trợ lý AI đã từng gõ qua HTTP (hướng dẫn trong buổi đào tạo)."
}

cmd_in_khoa() {
  echo "# KHÓA BÍ MẬT ONEBEE BOX — in ra giấy hoặc chép vào USB cất két. KHÔNG gửi qua Zalo/email."
  echo "# Hỏng ổ Box thì cần các khóa này để mở bản sao lưu trên ổ ngoài."
  local f
  for f in "${SECRETS}"/*; do [[ -f "${f}" ]] && printf '%s=%s\n' "$(basename "${f}")" "$(cat "${f}")"; done
  # Khóa CA riêng nằm trong thư mục ${SECRETS}/ca (có trong bản sao lưu Box). Vân tay để đối chiếu khi cài CA lên thiết bị khác
  [[ ! -s "${CA_DIR}/root.crt" ]] || echo "van-tay-ca-onebee-box=$(ca_van_tay)"
}

cmd_dat_mat_khau_email() {
  local pw
  read -rsp "Mật khẩu hộp thư gửi ("{{ (onebee_box_email.smtp_user or 'chưa khai báo smtp_user') | quote }}"): " pw; echo
  [[ -n "${pw}" ]] || die "Chưa nhập mật khẩu"
  (umask 077; printf '%s' "${pw}" >"${SECRETS}/smtp-password")
  echo "Đã lưu. Chạy lại bộ cài OneBee Box để n8n dùng mật khẩu mới, rồi: sudo onebee-box email-thu"
}

# Không cho 2 lệnh sao lưu chạy chồng nhau (lịch tự động + chạy tay)
with_lock() { exec 9>/run/onebee-box.lock; flock -n 9 || die "Đang có lệnh sao lưu khác chạy — thử lại sau"; "$@"; }

case "${1:-}" in
  trang-thai) cmd_trang_thai ;;
  them-may) shift; cmd_them_may "$@" ;;
  may-tram) cmd_may_tram ;;
  bao-cao-tuan) shift; cmd_bao_cao_tuan "$@" ;;
  cap-nhat-may) shift; cmd_cap_nhat_may "$@" ;;
  dong-bo-may) shift; cmd_dong_bo_may "$@" ;;
  thu-hoi-may) shift; cmd_thu_hoi_may "$@" ;;
  ghim-lai-may) shift; cmd_ghim_lai_may "$@" ;;
  dong-bo-ten-may) dong_bo_ten_may ;;
  dong-bo-tro-ly) webui dong-bo-tro-ly ;;
  khoi-tao) with_lock cmd_khoi_tao ;;
  sao-luu) with_lock cmd_sao_luu_co_bao_cao ;;
  khoi-phuc-thu) with_lock cmd_khoi_phuc_thu ;;
  khoi-phuc-toan-bo) shift; with_lock cmd_khoi_phuc_toan_bo "$@" ;;
  in-khoa) cmd_in_khoa ;;
  xoay-khoa) shift; cmd_xoay_khoa "$@" ;;
  in-ca) cmd_in_ca ;;
  go-khoa-hoi-may) cmd_go_khoa_hoi_may ;;
  may-chua-nhan-ca) may_chua_nhan_ca ;;
  dat-mat-khau-email) cmd_dat_mat_khau_email ;;
  email-thu) bao_cao_n8n THU "Email thử từ OneBee Box lúc $(date '+%H:%M %d/%m/%Y') — cấu hình email đã dùng được." \
               && echo "Đã chuyển cho n8n gửi — kiểm tra hộp thư "{{ onebee_box_email.nhan | quote }}" (cả mục Spam)." ;;
  *) sed -n '2,22p' "$0" | sed 's/^# //'; exit 1 ;;
esac

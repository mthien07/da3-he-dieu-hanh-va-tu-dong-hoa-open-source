# onebee-box — lệnh quản trị OneBee Box (quản lý bởi OneBee OS, không sửa tay)
#   onebee-box trang-thai          Xem dịch vụ đang chạy, dung lượng ổ
#   onebee-box chan-doan [--json]  Tự chẩn đoán 8 hạng mục (mạng, tài nguyên, Docker, AI, Samba, kho tệp, sao lưu, chứng chỉ) + gợi ý cách sửa
#   onebee-box them-may <ten-may>  Cấp tài khoản sao lưu, khóa Trợ lý AI, quản lý cho 1 máy trạm; in cấu hình dán vào máy trạm
#   onebee-box may-tram            Tình trạng các máy trạm: sao lưu, cập nhật, ổ đĩa, lần liên lạc cuối
#   onebee-box cap-nhat-may <ten-may>|--tat-ca   Cập nhật phần mềm máy trạm từ Box (qua SSH; máy phải chứng minh được là máy đã cấp)
#   onebee-box dong-bo-may <ten-may>|--tat-ca    Đẩy lại cấu hình (may-tram.env) từ Box xuống máy trạm (qua SSH, như trên)
#   onebee-box thu-hoi-may <ten-may> [--dong-y]  Thu hồi máy trạm (khóa Trợ lý AI, kho sao lưu HTTP, ghim SSH, chỗ báo tình trạng)
#   onebee-box ghim-lai-may <ten-may>            Máy cài lại hệ điều hành: bỏ khóa SSH đã ghim để ghim lại
#   onebee-box bao-cao-tuan [YYYY-MM-DD]   Nhật ký tuần: yêu cầu hỗ trợ, khảo sát, tình trạng máy (Markdown) — đọc từ CSDL sau khi chuyển sổ cũ
#   onebee-box chuyen-du-lieu      Chuyển sổ cũ (CSV đơn hàng, hỗ trợ, khảo sát; JSON tình trạng máy) vào CSDL — chạy lại chỉ nạp dòng mới
#   onebee-box nap-tri-thuc        Nạp kho tri thức (NĐ 30, mẫu soạn văn bản, tài liệu đơn vị) vào CSDL; chạy lại không tạo trùng
#   onebee-box cap-khoa-hoi <tên>  Cấp lại khóa Trợ lý AI của một người (khóa cũ mất hiệu lực), in khóa MỘT lần
#   onebee-box go-khoa-hoi <tên>   Thu hồi khóa Trợ lý AI của một người
#   onebee-box khoi-tao            Tạo kho sao lưu Box trên ổ ngoài (làm 1 lần sau khi gắn ổ)
#   onebee-box sao-luu             Sao lưu Box ra ổ ngoài + dọn bản cũ (tự chạy 23:00 hằng ngày)
#   onebee-box khoi-phuc-thu       Thử khôi phục 1 file từ bản sao lưu Box (kiểm tra sao lưu dùng được)
#   onebee-box khoi-phuc-toan-bo [file-khóa]   Hỏng ổ Box: trên Box cài lại, lấy lại toàn bộ dữ liệu từ ổ sao lưu
#   onebee-box may-chua-nhan-ca    Máy đã cấp mà chưa nhận CA hiện tại (chặn bật HTTPS)
#   onebee-box go-khoa-hoi-may     Xóa tài khoản/khóa Trợ lý AI theo MÁY (sau khi nhân viên đã dùng khóa riêng; xem onebee_box_hoi_khoa_may)
#   onebee-box xoay-khoa [--may <tên>|--tat-ca] [--box]   Đổi mật khẩu/khóa (kho HTTP + khóa hoi theo máy; --box: mật khẩu soạn luồng, khóa webhook, giám sát, CSDL, phiên đăng nhập)
#   onebee-box gia-han-ca          Gia hạn CA trung gian ngay (còn < 60 ngày) — tự chạy mỗi đêm sao lưu
#   onebee-box in-ca               In vân tay + thông tin CA riêng của Box (đối chiếu khi cài CA lên thiết bị khác)
#   onebee-box in-khoa             In các khóa bí mật để cất ngoài Box (thiếu khóa thì bản sao lưu vô dụng)
#   onebee-box dat-mat-khau-email  Nhập mật khẩu hộp thư gửi (SMTP) cho động cơ quy trình
#   onebee-box dat-telegram        Cấu hình Bot Token và Chat ID nhận tin cảnh báo Telegram
#   onebee-box canh-bao <MỨC> <TIÊU_ĐỀ> [NỘI_DUNG]  Gửi cảnh báo tức thời qua Telegram & động cơ quy trình
#   onebee-box email-thu           Gửi 1 email thử qua động cơ quy trình (kiểm tra cấu hình email)
#   onebee-box them-nguoi <tên> <nhóm>   Tạo tài khoản đăng nhập một lần (nhóm: {{ onebee_box_nhom_nguoi_dung | join(', ') }}); in mật khẩu tạm MỘT lần
#   onebee-box xoa-nguoi <tên>     Xóa tài khoản (kèm ghi danh hai lớp); người đó mất quyền ngay
#   onebee-box danh-sach-nguoi     Liệt kê tài khoản và nhóm (không in mật khẩu)
#   onebee-box ma-xac-nhan         In mã xác minh mới nhất (người dùng ghi danh hai lớp trên trang đăng nhập khi Box chưa có email)
#   onebee-box tat-sso-tam         Dịch vụ định danh hỏng: TẠM tắt đăng nhập một lần (dữ liệu khóa 503, giám sát dùng mật khẩu riêng)
#   onebee-box bat-sso-lai         Bật lại đăng nhập một lần sau khi đã sửa
#   onebee-box cap-nhat-chu-ky-clamav <thư-mục>  Nạp chữ ký ClamAV ngoại tuyến (.cvd/.cld) từ USB vào kho kiểm dịch
set -euo pipefail
LIB=/usr/local/lib/onebee-box
# shellcheck source=/dev/null
. "${LIB}/common.sh"
# shellcheck source=/dev/null
. "${LIB}/sao-luu.sh"
# shellcheck source=/dev/null
. "${LIB}/chan-doan.sh"

[[ ${EUID} -eq 0 ]] || die "Hãy chạy bằng quyền quản trị: sudo onebee-box $*"

# File/thư mục tạm có bí mật (cấu hình đẩy xuống máy, inventory…) được dọn khi thoát, KỂ CẢ thoát bằng die (trap RETURN không chạy khi exit)
TAM_DON=()
don_tam() { [[ -z "${TAM_DON[*]:-}" ]] || rm -rf "${TAM_DON[@]}"; }
trap don_tam EXIT

cmd_trang_thai() {
  compose ps --format 'table {{ '{{' }}.Name{{ '}}' }}\t{{ '{{' }}.Status{{ '}}' }}'
  echo; df -h "${DATA}" | tail -1 | awk '{print "Ổ dữ liệu: đã dùng " $3 "/" $2 " (" $5 ")"}'
  if mountpoint -q "${BACKUP_MOUNT}"; then df -h "${BACKUP_MOUNT}" | tail -1 | awk '{print "Ổ sao lưu: đã dùng " $3 "/" $2 " (" $5 ")"}'
  else echo "Ổ sao lưu: CHƯA GẮN (${BACKUP_MOUNT})"; fi
  echo "CA riêng của Box (mã ${BOX_MA_DON_VI}): gốc còn $(ca_con_ngay root) ngày, trung gian còn $(ca_con_ngay inter) ngày (tự gia hạn khi còn < 60 ngày, lúc sao lưu đêm)"
}

# Vân tay + nội dung ràng buộc của CA gốc — quản trị đối chiếu với màn hình/giấy in khi cài CA lên máy quản lý, laptop kỹ thuật, điện thoại
cmd_in_ca() {
  local vt
  [[ -s "${CA_DIR}/root.crt" ]] || die "Chưa có CA — chạy bộ cài OneBee Box (cần khai onebee_box_ma_don_vi trong group_vars)"
  vt="$(ca_van_tay)"
  echo "CA riêng OneBee Box — mã đơn vị ${BOX_MA_DON_VI}, địa chỉ ${BOX_ADDRESS}"
  echo "Vân tay SHA-256 (đối chiếu từng cặp ký tự với bản in; KHÔNG đối chiếu với thứ hiện trên trang web):"
  echo "  $(echo "${vt}" | tr 'a-f' 'A-F' | sed 's/../&:/g; s/:$//')"
  echo "Hiệu lực: gốc còn $(ca_con_ngay root) ngày, trung gian còn $(ca_con_ngay inter) ngày"
  echo "Chỉ được cấp chứng chỉ cho:"
  openssl x509 -in "${CA_DIR}/root.crt" -noout -ext nameConstraints | sed -n '3,$p'
  echo "Tải chứng chỉ gốc: http://${BOX_ADDRESS}/onebee-ca.crt  (hoặc chép bằng USB từ ${CA_DIR}/root.crt)"
}

# In cấu hình dán vào máy trạm — CHỈ ĐỌC bí mật đã có (không tạo tài khoản/khóa, không ghi htpasswd). Thiếu bí mật nào thì dừng (die),
# không in cấu hình thiếu. them-may tạo bí mật trước rồi gọi hàm này; dong-bo-may gọi lại để đẩy cấu hình xuống máy.
in_cau_hinh_may() {
  local ten="$1" ip http_pw repo_pw tram_key="" hoi_key="" f esq
  # Kiểm đủ bí mật TRƯỚC khi in gì (die gọi thẳng ở đây; die trong $(…) chỉ thoát subshell của nó, hàm vẫn in tiếp file thiếu mật khẩu)
  for f in "${SECRETS}/may-${ten}-http" "${SECRETS}/may-${ten}-repo" "${SSH_DIR}/quan-tri.pub" "${CA_DIR}/root.crt"; do
    [[ -s "${f}" ]] || die "Thiếu ${f} — máy ${ten} chưa cấp đủ hoặc đã thu hồi (cấp lại: sudo onebee-box them-may ${ten})"
  done
  ip="$(box_ip)"; [[ -n "${ip}" ]] || die "Không xác định được IP của Box — đặt onebee_box_dia_chi trong group_vars"
  http_pw="$(cat "${SECRETS}/may-${ten}-http")"
  repo_pw="$(cat "${SECRETS}/may-${ten}-repo")"
  if [[ "${TINH_TRANG_KHOA_CHUNG}" == true ]]; then
    [[ -s "${SECRETS}/tinh-trang-key" ]] || die "Thiếu ${SECRETS}/tinh-trang-key — chạy lại bộ cài OneBee Box"
    tram_key="$(cat "${SECRETS}/tinh-trang-key")"
  fi
  # Đã lưu khóa thì dùng. Máy đã cấp trước bản này (khóa cũ của dịch vụ khác) → cấp khóa mới cho đúng dịch vụ Trợ lý AI.
  # Cấp không được thì dừng (không in cấu hình thiếu dòng hoi). Máy chưa từng có khóa thì không in dòng hoi
  if [[ "${HOI_KHOA_MAY}" != true ]]; then
    hoi_key=""   # không còn khóa theo máy: mỗi người dùng khóa riêng (hoi --dan-khoa)
  elif [[ -s "${SECRETS}/may-${ten}-khoa" ]]; then
    hoi_key="$(cat "${SECRETS}/may-${ten}-khoa")"
  elif [[ -e "${SECRETS}/may-${ten}-hoi" || -e "${SECRETS}/may-${ten}-webui" ]]; then
    hoi_key="$(hoi_khoa cap may "${ten}")" || die "Không cấp được khóa Trợ lý AI của máy ${ten} — thử lại sau"
    (umask 077; printf '%s' "${hoi_key}" >"${SECRETS}/may-${ten}-khoa")
    rm -f "${SECRETS}/may-${ten}-hoi" "${SECRETS}/may-${ten}-webui"
  fi
  echo "MAY_TRAM=${ten}"
  echo "BOX_IP=${ip}"
  # Tên Box (nằm trong ràng buộc tên của CA): máy trạm thêm dòng /etc/hosts "<BOX_IP> <BOX_TEN>" — đăng nhập một lần chỉ mở bằng tên
  echo "BOX_TEN=box.${BOX_MA_DON_VI}.onebee.internal"
  esq="$(giao_thuc_may)"
  echo "RESTIC_REPOSITORY=rest:${esq}://${ten}:${http_pw}@${ip}:${REST_PORT}/${ten}/"
  echo "RESTIC_PASSWORD=${repo_pw}"
  # Trợ lý AI chỉ phục vụ trên tên Box qua HTTPS (tuyến lõi); khóa của MÁY chỉ in ở giai đoạn chuyển tiếp
  echo "HOI_URL=${AI_URL}"
  [[ -z "${hoi_key}" ]] || echo "HOI_API_KEY=${hoi_key}"
  # Máy trạm gọi Caddy trên LAN: HTTPS qua tên Box (có CA), HTTP qua IP:cổng 80 (HTTPS chưa bật)
  if https_bat; then tt_url="https://${TEN_BOX}/webhook/onebee-tinh-trang"; else tt_url="http://${ip}:{{ onebee_box_ports.portal }}/webhook/onebee-tinh-trang"; fi
  echo "TINH_TRANG_URL=${tt_url}"
  [[ -z "${tram_key}" ]] || echo "TINH_TRANG_KEY=${tram_key}"
  echo "QUAN_TRI_SSH_KEY=\"$(cat "${SSH_DIR}/quan-tri.pub")\""
  # CA riêng của Box: chứng chỉ gốc (DER, base64 một dòng) + vân tay tính lại từ chứng chỉ. Máy trạm (role ket-noi-box) kiểm vân tay
  # VÀ kiểm chứng chỉ đúng là CA có ràng buộc tên (chỉ IP Box + *.onebee.internal) rồi mới cài
  echo "BOX_CA=$(openssl x509 -in "${CA_DIR}/root.crt" -outform DER | base64 -w0)"
  echo "BOX_CA_VAN_TAY=$(ca_van_tay)"
  # Cờ HTTPS: 1 = máy ghi dấu bền và từ chối http://; 0 = Box hoàn tác HTTPS (chỉ cờ này mới xóa dấu trên máy)
  if https_bat; then echo "BOX_HTTPS=1"; else echo "BOX_HTTPS=0"; fi
}

cmd_them_may() {
  local ten="${1:-}" ip http_pw repo_pw hoi_key thoi_diem
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Tên máy chỉ gồm chữ thường không dấu, số, dấu gạch (vd: ketoan-01)"
  ip="$(box_ip)"; [[ -n "${ip}" ]] || die "Không xác định được IP của Box — đặt onebee_box_dia_chi trong group_vars"
  if [[ -e "${SECRETS}/thu-hoi/${ten}" ]]; then
    # Cấp lại cho máy từng thu hồi: máy cũ (mất cắp, nghi chiếm) vẫn biết MẬT KHẨU KHO cũ — mà mật khẩu kho là khóa ký báo cáo và là bằng chứng
    # danh tính máy → phải đổi. Cất kho + mật khẩu cũ sang tên khác (mở lại dữ liệu cũ bằng restic khi cần; in-khoa vẫn in mật khẩu cũ),
    # máy mới bắt đầu kho mới. Mật khẩu kho HTTP và tài khoản Trợ lý AI cũng được tạo mới.
    thoi_diem="$(date +%Y%m%d-%H%M%S)"
    [[ ! -e "${SECRETS}/may-${ten}-repo" ]] || mv "${SECRETS}/may-${ten}-repo" "${SECRETS}/cu-${ten}-repo-${thoi_diem}"
    [[ ! -d "${DATA}/restic/${ten}" ]] || mv "${DATA}/restic/${ten}" "${DATA}/restic/${ten}.cu-${thoi_diem}"
    rm -f "${SECRETS}/thu-hoi/${ten}"
  fi
  http_pw="$(secret "may-${ten}-http")"
  repo_pw="$(secret "may-${ten}-repo")"
  [[ "${TINH_TRANG_KHOA_CHUNG}" != true ]] || secret tinh-trang-key >/dev/null
  # -i: đọc mật khẩu từ stdin (không lộ trong danh sách tiến trình)
  htpasswd -B -i "${DATA}/restic/.htpasswd" "${ten}" <<<"${http_pw}" 2>/dev/null
  nap_lai_kho_http
  hoi_key=""
  if [[ "${HOI_KHOA_MAY}" == true ]]; then
    hoi_key="$(hoi_khoa cap may "${ten}")" || {
      warn "Chưa cấp được khóa Trợ lý AI — sao lưu vẫn dùng được; chạy lại lệnh này sau để bật hoi"
      hoi_key=""
    }
  fi
  [[ -z "${hoi_key}" ]] || (umask 077; printf '%s' "${hoi_key}" >"${SECRETS}/may-${ten}-khoa")
  dong_bo_ten_may >/dev/null
  echo "# Dán nội dung dưới đây vào máy trạm ${ten}: /etc/onebee/may-tram.env, rồi chạy lại bộ cài OneBee OS"
  in_cau_hinh_may "${ten}"
}

# Thu hồi 1 máy trạm (mất máy, nhân viên nghỉ, máy bị nghi giả mạo): khóa Trợ lý AI, mật khẩu kho HTTP, ghim SSH và chỗ nhận báo cáo bị gỡ.
# Giữ lại kho sao lưu và mật khẩu kho của máy (để khôi phục dữ liệu / dọn bản cũ). Chạy lại lệnh này an toàn (dọn tiếp phần còn sót).
cmd_thu_hoi_may() {
  local ten="${1:-}" xac_nhan="${2:-}" tra_loi
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ && -e "${SECRETS}/may-${ten}-repo" ]] || die "Cách dùng: sudo onebee-box thu-hoi-may <tên-máy-đã-cấp> [--dong-y]"
  if [[ "${xac_nhan}" != --dong-y ]]; then
    read -rp "Thu hồi máy ${ten}? Máy sẽ không sao lưu, hỏi Trợ lý AI, báo tình trạng hay nhận cập nhật được nữa. Gõ 'thu hoi' để xác nhận: " tra_loi \
      || die "Cần xác nhận: chạy trong cửa sổ dòng lệnh, hoặc thêm --dong-y"
    [[ "${tra_loi}" == "thu hoi" ]] || die "Đã hủy"
  fi
  (umask 077; mkdir -p "${SECRETS}/thu-hoi"; : >"${SECRETS}/thu-hoi/${ten}")   # đánh dấu TRƯỚC: lỡ dừng giữa chừng thì máy đã bị coi là thu hồi
  htpasswd -D "${DATA}/restic/.htpasswd" "${ten}" 2>/dev/null || true
  nap_lai_kho_http   # máy thu hồi mất quyền vào kho ngay, không chờ rest-server tự đọc lại
  hoi_khoa go may "${ten}" >/dev/null 2>&1 || true
  rm -f "${SECRETS}/may-${ten}-http" "${SECRETS}/may-${ten}-khoa" "${SECRETS}/may-${ten}-hoi" "${SECRETS}/may-${ten}-webui" \
        "${DATA}/tinh-trang-may/${ten}.json"
  ssh-keygen -R "${ten}" -f "${SSH_DIR}/known_hosts" >/dev/null 2>&1 || true
  dong_bo_ten_may >/dev/null
  echo "Đã thu hồi máy ${ten}. Kho sao lưu của máy vẫn còn trên Box. Cấp lại (mật khẩu kho mới, kho cũ cất riêng): sudo onebee-box them-may ${ten}"
  echo "LƯU Ý: chạy NGAY 'sudo onebee-box sao-luu' để bản sao lưu Box ghi nhận việc thu hồi — nếu ổ hỏng trước lần sao lưu 23:00, khôi phục sẽ cấp lại máy này."
}

# Bỏ khóa Trợ lý AI theo MÁY: thu hồi khóa may-<tên> + khóa đã lưu. Chỉ sau khi đặt onebee_box_hoi_khoa_may: false
# và chạy lại bộ cài + dong-bo-may --tat-ca (để máy không còn HOI_API_KEY). Người chưa có khóa riêng sẽ không hỏi được nữa.
cmd_go_khoa_hoi_may() {
  local ten
  [[ "${HOI_KHOA_MAY}" != true ]] || die "Chưa tắt khóa theo máy: đặt onebee_box_hoi_khoa_may: false trong group_vars, chạy lại bộ cài, rồi dong-bo-may --tat-ca trước"
  while read -r ten; do
    hoi_khoa go may "${ten}" >/dev/null 2>&1 || true
    rm -f "${SECRETS}/may-${ten}-khoa" "${SECRETS}/may-${ten}-hoi" "${SECRETS}/may-${ten}-webui"
    echo "Đã bỏ khóa Trợ lý AI theo máy: ${ten}"
  done < <(may_da_cap)
}

# Máy cài lại hệ điều hành (khóa SSH của máy đổi): bỏ khóa đã ghim; lần cap-nhat-may sau máy phải chứng minh lại rồi mới được ghim mới
cmd_ghim_lai_may() {
  local ten="${1:-}"
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Cách dùng: sudo onebee-box ghim-lai-may <tên-máy>"
  ssh-keygen -R "${ten}" -f "${SSH_DIR}/known_hosts" >/dev/null 2>&1 || true
  echo "Đã bỏ khóa SSH đã ghim của máy ${ten}. Máy báo tình trạng lại (có chữ ký) rồi chạy: sudo onebee-box cap-nhat-may ${ten}"
}

cmd_bao_cao_tuan() {
  local ngay="${1:-$(date +%F)}"
  local -a may=()
  [[ "${ngay}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "Ngày theo dạng YYYY-MM-DD, ví dụ $(date +%F)"
  # Bản cũ vẫn ghi sổ CSV → chuyển dòng mới vào CSDL trước rồi mới đọc. Chuyển lỗi (vd một tệp có dòng hỏng) thì vẫn báo cáo,
  # kèm cảnh báo (dòng lỗi đã in ra ở trên): báo cáo thiếu dòng mới của tệp đó, không im lặng bỏ qua
  chuyen_du_lieu >/dev/null || warn "Chuyển sổ cũ vào CSDL chưa xong (xem lỗi ở trên) — báo cáo có thể thiếu dòng mới. Sửa rồi chạy: sudo onebee-box chuyen-du-lieu"
  mapfile -t may < <(gio_sao_luu_may)
  may_tram_py payload DAT "" "${may[@]}" | python3 /usr/local/lib/onebee-box/onebee-bao-cao-tuan.py csdl "${ngay}"
}

cmd_may_tram() {
  local -a may=()
  mapfile -t may < <(gio_sao_luu_may)
  may_tram_py bang "${may[@]}"
}

# ---- Vào máy trạm qua SSH (cap-nhat-may, dong-bo-may) ----
# Địa chỉ IP do máy trạm tự báo qua HTTP nên KHÔNG đủ tin để đem khóa quản trị (root trên máy) tới đó. Quy tắc (rà soát bảo mật F2):
#  - máy CHƯA ghim khóa SSH: chỉ dùng IP trong báo cáo CÓ CHỮ KÝ HỢP LỆ, mới trong 2 giờ; lần đầu vào phải CHỨNG MINH máy biết
#    mật khẩu kho sao lưu (chưa từng đi qua mạng) rồi mới ghim khóa SSH của máy; máy giả không biết mật khẩu → không được ghim/không nhận gì;
#  - máy ĐÃ ghim: SSH với StrictHostKeyChecking=yes (khóa lệch thì dừng) và chứng minh lại mỗi lần (phòng khóa ghim cũ do bản trước tạo).

la_may_da_cap() {
  local t
  while read -r t; do [[ "${t}" == "$1" ]] && return 0; done < <(may_da_cap)
  return 1
}

# Tên máy được chọn bởi <tên>|--tat-ca (chỉ máy đã cấp, chưa thu hồi) → mảng CHON_MAY
chon_may() {
  local muc="${1:-}"
  CHON_MAY=()
  if [[ "${muc}" == --tat-ca ]]; then
    mapfile -t CHON_MAY < <(may_da_cap)
  elif [[ "${muc}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] && la_may_da_cap "${muc}"; then
    CHON_MAY=("${muc}")
  else
    return 1
  fi
  [[ -n "${CHON_MAY[*]:-}" ]]
}

# SSH vào máy bằng khóa quản trị, đọc mật khẩu kho sao lưu trên máy, so với bản Box giữ. Thành công = đúng máy đã cấp.
# $1=tên $2=IP $3=file known_hosts $4=StrictHostKeyChecking (yes | accept-new). Lý do thất bại in ra stderr (không in mật khẩu).
chung_minh_may() {
  local ten="$1" ip="$2" kh="$3" mode="$4" pw dong loi
  pw="$(secret_co_san "may-${ten}-repo")"
  loi="$(mktemp)"
  # -n: ssh KHÔNG được đọc stdin — hàm này chạy trong vòng lặp "while read" đọc danh sách máy; thiếu -n thì ssh nuốt các dòng còn lại
  if ! dong="$(ssh -n -i "${SSH_DIR}/quan-tri" -o BatchMode=yes -o IdentitiesOnly=yes -o UserKnownHostsFile="${kh}" \
        -o StrictHostKeyChecking="${mode}" -o HostKeyAlias="${ten}" -o UpdateHostKeys=no -o ConnectTimeout=10 \
        "onebee-quantri@${ip}" 'sudo grep -m1 "^RESTIC_PASSWORD=" /etc/onebee/may-tram.env' 2>"${loi}")"; then
    warn "Không SSH vào ${ten} (${ip}) được: $(tail -n 1 "${loi}")"
    rm -f "${loi}"; return 1
  fi
  rm -f "${loi}"
  dong="${dong#RESTIC_PASSWORD=}"; dong="${dong//$'\r'/}"; dong="${dong#\"}"; dong="${dong%\"}"
  [[ -n "${pw}" && "${dong}" == "${pw}" ]]
}

# Ghi inventory $1 với các máy (tên ở các tham số còn lại) đủ điều kiện vào được → mảng VAO_DUOC
chuan_bi_may() {
  local inv="$1"; shift
  local -a ghim=()
  local t ip trang tmp kh="${SSH_DIR}/known_hosts"
  VAO_DUOC=()
  mkdir -p "${SSH_DIR}"; (umask 077; touch "${kh}")
  for t in "$@"; do
    if ssh-keygen -F "${t}" -f "${kh}" >/dev/null 2>&1; then ghim+=("${t}"); fi
  done
  echo "[may_tram]" >"${inv}"
  while read -r t ip trang; do
    if [[ "${trang}" == chua-ghim ]]; then
      tmp="$(mktemp)"
      if ! chung_minh_may "${t}" "${ip}" "${tmp}" accept-new; then
        warn "Bỏ qua ${t}: máy ở ${ip} KHÔNG chứng minh được là máy đã cấp (mật khẩu kho sao lưu trên máy khác Box giữ, hoặc không vào được) — không ghim, không gửi gì"
        rm -f "${tmp}"; continue
      fi
      cat "${tmp}" >>"${kh}"
      echo "Đã ghim khóa SSH của ${t} ($(ssh-keygen -lf "${tmp}" 2>/dev/null | awk 'NR==1 {print $2}')) sau khi máy chứng minh biết mật khẩu kho sao lưu"
      rm -f "${tmp}"
    elif ! chung_minh_may "${t}" "${ip}" "${kh}" yes; then
      warn "Bỏ qua ${t}: khóa SSH đã ghim không khớp hoặc máy không chứng minh được. Máy vừa cài lại hệ điều hành? → sudo onebee-box ghim-lai-may ${t}. (Địa chỉ ${ip} có thể lấy từ báo cáo chưa ký — nếu máy không hề cài lại, có thể có máy khác đang giả danh.)"
      continue
    fi
    echo "${t} ansible_host=${ip} ansible_ssh_extra_args='-o HostKeyAlias=${t}'" >>"${inv}"
    VAO_DUOC+=("${t}")
  done < <(export ONEBEE_DA_GHIM; ONEBEE_DA_GHIM="$(IFS=,; echo "${ghim[*]-}")"; may_tram_py kho "$@")
  for t in "$@"; do
    trong_mang "${t}" "${VAO_DUOC[@]}" || printf '%s\n' "${t}" >>"${TEN_BO_QUA}"
  done
}

# Chạy playbook $1 (trong ${LIB}) trên các máy đang chọn trong CHON_MAY; $2 = tên viết tắt cho file nhật ký; $3.. = tham số ansible thêm
chay_playbook_chon() {
  local playbook="$1" ten_log="$2"; shift 2
  local inv log st t
  inv="$(mktemp)"; TEN_BO_QUA="$(mktemp)"
  TAM_DON+=("${inv}" "${TEN_BO_QUA}")
  chuan_bi_may "${inv}" "${CHON_MAY[@]}"
  while read -r t; do
    [[ -z "${t}" ]] || warn "Bỏ qua ${t}: máy chưa báo tình trạng hợp lệ trong 2 giờ qua (máy tắt? chưa chạy bộ cài mới có ký báo cáo? chưa biết địa chỉ)"
  done <"${TEN_BO_QUA}"
  # Không die: xoay-khoa gọi tới đây SAU khi đã đổi mật khẩu trên Box — còn phải nhắc quản trị đồng bộ lại từng máy
  [[ -n "${VAO_DUOC[*]:-}" ]] || { warn "Không có máy nào để làm"; return 1; }
  # Nhật ký chứa tên máy, địa chỉ → chỉ root đọc; mọi task đụng mật khẩu đều có no_log trong playbook
  install -d -m 0700 /var/log/onebee-box
  log="/var/log/onebee-box/${ten_log}-$(date +%Y%m%d-%H%M%S).log"
  (umask 077; : >"${log}")
  set +e
  # LC_ALL: Ansible đòi locale UTF-8; quản trị SSH từ máy trạm Mint mang theo LANG=vi_VN (bảng mã TCVN với Python)
  LC_ALL=C.UTF-8 ANSIBLE_SSH_ARGS="-o UserKnownHostsFile=${SSH_DIR}/known_hosts -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=6 -o ControlMaster=auto -o ControlPersist=60s" \
  ANSIBLE_ROLES_PATH="${LIB}/roles" ANSIBLE_PYTHON_INTERPRETER=/usr/bin/python3 ANSIBLE_RETRY_FILES_ENABLED=False ANSIBLE_NOCOLOR=1 ANSIBLE_LOCAL_TEMP=/root/.ansible/tmp \
    ansible-playbook -i "${inv}" -u onebee-quantri --private-key "${SSH_DIR}/quan-tri" "$@" "${LIB}/${playbook}" 9>&- 2>&1 | tee -a "${log}"
  st=${PIPESTATUS[0]}
  set -e
  [[ ${st} -eq 0 ]] || warn "Có máy chưa xong (máy tắt, mất mạng hoặc lỗi) — xem ${log}. Máy đã cài lại hệ điều hành (báo HOST IDENTIFICATION HAS CHANGED / khóa SSH không khớp): sudo onebee-box ghim-lai-may <tên-máy> rồi chạy lại"
  return "${st}"
}

cmd_cap_nhat_may() {
  chon_may "${1:-}" || die "Cách dùng: sudo onebee-box cap-nhat-may <tên-máy-đã-cấp> | --tat-ca   (chưa cấp máy nào: sudo onebee-box them-may <tên-máy>)"
  chay_playbook_chon cap-nhat-may-tram.yml cap-nhat-may
}

# Đẩy lại cấu hình (/etc/onebee/may-tram.env) từ Box xuống máy trạm — dùng khi đổi khóa/URL; nguồn cấu hình duy nhất là in_cau_hinh_may.
# Chỉ đẩy tới máy đã chứng minh được; thiếu bí mật nào của máy thì bỏ qua máy đó (không đẩy file thiếu). File cũ được giữ lại .~ trên máy.
# Sau khi ghi file, playbook dong-bo-may-tram.yml chạy lại trên máy đúng các task của bộ cài desktop (ket-noi-box: CA + trình duyệt,
# cau-hinh-hoi: /etc/onebee-hoi.conf, muc-menu) rồi kiểm báo cáo chạy được — không cần chạy lại bộ cài desktop bằng tay.
cmd_dong_bo_may() {
  if [[ "${1:-}" == --tat-ca && -z "$(may_da_cap)" ]]; then echo "Chưa cấp máy trạm nào — không có gì để đồng bộ."; return 0; fi
  chon_may "${1:-}" || die "Cách dùng: sudo onebee-box dong-bo-may <tên-máy-đã-cấp> | --tat-ca"
  cmd_dong_bo_may_da_chon
}

# Đẩy cấu hình xuống các máy đang nằm trong CHON_MAY (đã qua chon_may)
cmd_dong_bo_may_da_chon() {
  local thu_muc t
  local -a co=()
  thu_muc="$(mktemp -d)"   # 0700; nội dung cấu hình chứa mật khẩu → xóa khi thoát (kể cả thoát lỗi)
  TAM_DON+=("${thu_muc}")
  for t in "${CHON_MAY[@]}"; do
    # Dựng trong subshell: thiếu bí mật thì die chỉ dừng subshell → bỏ qua máy đó, KHÔNG đẩy file thiếu
    if ( umask 077; in_cau_hinh_may "${t}" >"${thu_muc}/${t}.env" ); then co+=("${t}")
    else warn "Bỏ qua ${t}: không dựng được cấu hình (thiếu bí mật — máy mới cấp dở?)"; rm -f "${thu_muc}/${t}.env"; fi
  done
  CHON_MAY=("${co[@]}")   # xoay-khoa đọc lại để biết máy nào không dựng được cấu hình
  # Không die: xoay-khoa gọi tới đây SAU khi đã đổi mật khẩu trên Box — còn phải nhắc từng máy
  [[ -n "${co[*]:-}" ]] || { warn "Không dựng được cấu hình cho máy nào"; return 1; }
  # Dấu "máy đã nhận CA" do playbook ghi (task cuối, chỉ khi CA đã cài đúng vân tay) — cổng chặn bật HTTPS dựa vào dấu này
  (umask 077; mkdir -p "${SECRETS}/ca-da-dong-bo")
  chay_playbook_chon dong-bo-may-tram.yml dong-bo-may -e "onebee_cau_hinh_dir=${thu_muc}" -e "onebee_dau_ca_dir=${SECRETS}/ca-da-dong-bo"
}

# ---- Xoay khóa (Pha 4b) ----
# Lý do: trước khi có HTTPS, mật khẩu/khóa đã đi qua LAN dạng rõ — còn hiệu lực dù hôm nay đã mã hóa. Cũng dùng khi nghi ngờ lộ khóa.
# RESTIC_PASSWORD KHÔNG xoay (chưa từng đi qua mạng; đổi là mất bản sao lưu cũ). Mật khẩu soạn luồng CÓ xoay (bộ cài đọc lại khi chạy lại).

# Một máy: mật khẩu kho HTTP mới (htpasswd) + khóa Trợ lý AI theo máy mới (nếu còn dùng). Ghi bí mật mới TRƯỚC khi đẩy xuống máy
xoay_khoa_may() {
  local ten="$1" khoa_moi
  rm -f "${SECRETS}/may-${ten}-http"
  htpasswd -B -i "${DATA}/restic/.htpasswd" "${ten}" <<<"$(secret "may-${ten}-http")" 2>/dev/null
  nap_lai_kho_http   # mật khẩu cũ hết hiệu lực ngay (không còn khoảng ≤30 giây)
  if [[ "${HOI_KHOA_MAY}" == true ]] && [[ -e "${SECRETS}/may-${ten}-khoa" || -e "${SECRETS}/may-${ten}-hoi" || -e "${SECRETS}/may-${ten}-webui" ]]; then
    khoa_moi="$(hoi_khoa cap may "${ten}")" || { warn "Chưa đổi được khóa Trợ lý AI của máy ${ten} — giữ khóa cũ"; return 0; }
    (umask 077; printf '%s' "${khoa_moi}" >"${SECRETS}/may-${ten}-khoa")
    rm -f "${SECRETS}/may-${ten}-hoi" "${SECRETS}/may-${ten}-webui"
  fi
  echo "Đã tạo mật khẩu mới cho máy ${ten}"
}

# Phía Box: mật khẩu giám sát + vai trò CSDL (đổi trong dịch vụ trước), mật khẩu soạn luồng, khóa webhook động cơ quy trình,
# khóa phiên đăng nhập một lần. Phần Ansible áp dụng (.env, cấu hình Node-RED) cần chạy lại bộ cài ngay sau đó
xoay_khoa_box() {
  local moi lan rc=0
  if [[ -e "${SECRETS}/uptime-kuma-da-co-quan-tri" ]]; then
    moi="$(ngau_nhien 24)"
    # Uptime Kuma mở cổng web trước khi đọc xong CSDL (vừa khởi động lại) → mã 1 là chưa sẵn sàng, thử lại giống bộ cài (mã 3 = sai mật khẩu, dừng ngay)
    for lan in 1 2 3 4 5 6; do
      [[ "${lan}" -eq 1 ]] || sleep 5
      KUMA_USER=quantri KUMA_PASS="$(cat "${SECRETS}/uptime-kuma-password")" KUMA_PASS_MOI="${moi}" \
        docker exec -i -w /app -e KUMA_USER -e KUMA_PASS -e KUMA_PASS_MOI onebee-uptime-kuma node - </usr/local/lib/onebee-box/onebee-kuma.js \
        && { rc=0; break; } || rc=$?
      [[ "${rc}" -eq 1 ]] || break
    done
    [[ "${rc}" -eq 0 ]] || die "Không đổi được mật khẩu giám sát — các mật khẩu khác CHƯA đổi thêm. Kiểm tra: sudo onebee-box trang-thai"
    (umask 077; printf '%s' "${moi}" >"${SECRETS}/uptime-kuma-password")
  fi
  # CSDL: đổi trong PostgreSQL (ALTER ROLE) TRƯỚC, ghi tệp bí mật SAU — lỗi thì giữ tệp cũ (vẫn khớp CSDL) và dừng.
  # PostgREST đọc mật khẩu mới từ .env khi bộ cài chạy ngay sau đây (compose tạo lại dịch vụ)
  local muc
  for muc in "${VAI_TRO_CSDL[@]}"; do
    moi="$(ngau_nhien 32)"
    dat_mat_khau_csdl "${muc%%:*}" "${moi}" \
      || die "Không đổi được mật khẩu CSDL của ${muc%%:*} (PostgreSQL chưa chạy?) — mật khẩu này giữ nguyên. Kiểm tra: sudo onebee-box chan-doan"
    (umask 077; printf '%s' "${moi}" >"${SECRETS}/${muc#*:}")
  done
  moi="$(ngau_nhien 24)"
  (umask 077; printf '%s' "${moi}" >"${SECRETS}/quy-trinh-soan-luong"
   htpasswd -niBC 10 kythuat <<<"${moi}" | cut -d: -f2 | tr -d '\n' >"${SECRETS}/quy-trinh-soan-hash")
  # Khóa gửi tình trạng dùng chung (nếu còn dùng): bộ cài sinh lại; cmd_xoay_khoa đẩy xuống mọi máy ngay sau bộ cài
  [[ "${TINH_TRANG_KHOA_CHUNG}" != true ]] || rm -f "${SECRETS}/tinh-trang-key"
  rm -f "${SECRETS}/webui-secret-key" "${SECRETS}/webui-admin-password" \
        "${SECRETS}/bieu-mau-nhanvien" "${SECRETS}/bieu-mau-kythuat" "${SECRETS}/quy-trinh-webhook-key"
  # Đăng nhập một lần: khóa phiên (mọi cookie phiên cũ hết hiệu lực) và khóa ký JWT của cầu nối — bộ cài sinh lại, tạo lại hai dịch vụ.
  # KHÔNG xóa authelia-storage-key: khóa mã hóa ghi danh hai lớp trong CSDL, mất là mọi người phải ghi danh lại
  rm -f "${SECRETS}/authelia-session-secret" "${SECRETS}/cau-noi-jwt-secret"
  # Bộ cài (Ansible lookup password) sinh lại các file vừa xóa; quy-trinh-webhook-key cần có NGAY cho bao_cao_quy_trinh ở lần chạy sau
  secret quy-trinh-webhook-key >/dev/null
  echo "Đã đổi: mật khẩu giám sát, CSDL (trong dịch vụ); đã tạo mới: mật khẩu soạn luồng (kythuat), khóa webhook động cơ quy trình, khóa phiên đăng nhập một lần (mọi người đăng nhập lại), khóa ký JWT của cầu nối."
}

cmd_xoay_khoa() {
  local box=0 muc="" a tra_loi t bo_cai ly_do rc
  local -a ds=() doi_may=()
  while [[ $# -gt 0 ]]; do
    a="$1"; shift
    case "${a}" in
      --box) box=1 ;;
      --tat-ca) muc=--tat-ca ;;
      --may) muc="${1:-}"; [[ $# -eq 0 ]] || shift ;;
      --dong-y) tra_loi="dong-y" ;;
      *) die "Cách dùng: sudo onebee-box xoay-khoa [--may <tên-máy> | --tat-ca] [--box] [--dong-y]" ;;
    esac
  done
  [[ -n "${muc}" || ${box} -eq 1 ]] || die "Cách dùng: sudo onebee-box xoay-khoa [--may <tên-máy> | --tat-ca] [--box] [--dong-y]"
  if [[ -n "${muc}" ]]; then chon_may "${muc}" || die "Máy không tồn tại hoặc chưa cấp: ${muc}"; ds=("${CHON_MAY[@]}"); fi
  if [[ "${tra_loi:-}" != dong-y ]]; then
    read -rp "Xoay khóa: ${ds[*]:-} $([[ ${box} -eq 1 ]] && echo '+ khóa của Box') — máy tắt sẽ mất quyền sao lưu/hỏi AI tới khi 'dong-bo-may'. Gõ 'xoay khoa' để xác nhận: " tra_loi \
      || die "Cần xác nhận: chạy trong cửa sổ dòng lệnh, hoặc thêm --dong-y"
    [[ "${tra_loi}" == "xoay khoa" ]] || die "Đã hủy"
  fi
  lay_khoa   # SAU bước xác nhận: dấu nhắc để treo không được giữ khóa (sao lưu đêm sẽ bị bỏ)
  for t in "${ds[@]}"; do xoay_khoa_may "${t}"; done
  doi_may=("${ds[@]}")
  if [[ ${box} -eq 1 ]]; then
    xoay_khoa_box
    bo_cai="$(cat "${LIB}/duong-dan-bo-cai" 2>/dev/null || true)"
    if [[ -x "${bo_cai}" ]]; then
      echo "Chạy bộ cài để áp dụng (.env, cấu hình động cơ quy trình)..."
      "${bo_cai}" 9>&- || die "Bộ cài chưa xong — chạy lại NGAY: sudo ${bo_cai} (Box đang ở trạng thái nửa chừng)"
      # Khóa gửi tình trạng dùng chung vừa được bộ cài sinh lại → MỌI máy cần khóa mới (thiếu thì báo tình trạng bị 403)
      if [[ "${TINH_TRANG_KHOA_CHUNG}" == true && -n "$(may_da_cap)" ]]; then chon_may --tat-ca; ds=("${CHON_MAY[@]}"); fi
    else
      warn "KHÔNG tìm thấy bộ cài — chạy NGAY bộ cài OneBee Box (sudo ./box/onebee-box-install.sh) để áp dụng; trước đó động cơ quy trình/báo cáo sao lưu có thể lỗi"
      [[ "${TINH_TRANG_KHOA_CHUNG}" != true ]] || echo "LƯU Ý: sau bộ cài, chạy: sudo onebee-box dong-bo-may --tat-ca (khóa gửi tình trạng đã đổi)"
    fi
  fi
  if [[ -n "${ds[*]:-}" ]]; then
    echo "Đẩy cấu hình mới xuống máy..."
    CHON_MAY=("${ds[@]}"); VAO_DUOC=(); rc=0
    cmd_dong_bo_may_da_chon || rc=$?   # máy chưa nhận được: nhắc riêng từng máy ngay dưới
    for t in "${ds[@]}"; do
      ly_do="khóa gửi tình trạng đã đổi trên Box"
      ! trong_mang "${t}" "${doi_may[@]}" || ly_do="mật khẩu kho đã đổi trên Box"
      if ! trong_mang "${t}" "${CHON_MAY[@]}"; then
        warn "Máy trạm ${t} chưa nhận cấu hình mới — không dựng được cấu hình (thiếu bí mật, xem cảnh báo bên trên); ${ly_do}. Sửa xong chạy: sudo onebee-box dong-bo-may ${t}"
      elif ! trong_mang "${t}" "${VAO_DUOC[@]}"; then
        warn "Máy trạm ${t} hiện đang tắt (hoặc không vào được) — ${ly_do}. Khi máy bật lại, quản trị viên cần chạy: sudo onebee-box dong-bo-may ${t}"
      elif [[ ${rc} -ne 0 ]]; then   # VAO_DUOC = SSH vào được, chưa chắc playbook xong trên máy này
        warn "Máy trạm ${t} có thể chưa nhận cấu hình mới (đẩy xuống bị lỗi — xem nhật ký ở trên) — ${ly_do}. Chạy lại: sudo onebee-box dong-bo-may ${t}"
      fi
    done
  fi
  echo "Xong. In lại khóa để cất: sudo onebee-box in-khoa."
}

cmd_in_khoa() {
  echo "# KHÓA BÍ MẬT ONEBEE BOX — in ra giấy hoặc chép vào USB cất két. KHÔNG gửi qua Zalo/email."
  echo "# Hỏng ổ Box thì cần các khóa này để mở bản sao lưu trên ổ ngoài."
  local f
  for f in "${SECRETS}"/*; do [[ -f "${f}" ]] && printf '%s=%s\n' "$(basename "${f}")" "$(cat "${f}")"; done
  # Khóa CA riêng nằm trong thư mục ${SECRETS}/ca (có trong bản sao lưu Box). Vân tay để đối chiếu khi cài CA lên thiết bị khác
  [[ ! -s "${CA_DIR}/root.crt" ]] || echo "van-tay-ca-onebee-box=$(ca_van_tay)"
  echo "# Khóa Trợ lý AI của từng người chỉ in MỘT lần lúc cấp (Box chỉ giữ bản băm). Cấp lại: sudo onebee-box cap-khoa-hoi <tên>"
}

# Cấp lại khóa Trợ lý AI của một người: khóa cũ mất hiệu lực ngay, in khóa mới MỘT lần
cmd_cap_khoa_hoi() {
  local ten="${1:-}"
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Cách dùng: sudo onebee-box cap-khoa-hoi <tên-người-dùng>"
  hoi_khoa cap nguoi "${ten}"
  echo "Khóa trên chỉ hiện MỘT lần. Đưa trực tiếp cho ${ten}; trên máy trạm họ chạy: hoi --dan-khoa" >&2
}

cmd_go_khoa_hoi() {
  local ten="${1:-}"
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Cách dùng: sudo onebee-box go-khoa-hoi <tên-người-dùng>"
  hoi_khoa go nguoi "${ten}" || die "Không có khóa Trợ lý AI của ${ten} để thu hồi"
  echo "Đã thu hồi khóa Trợ lý AI của ${ten}"
}

# Nạp kho tri thức vào CSDL: dịch vụ nhúng tài liệu bằng Ollama rồi in câu lệnh SQL; đưa vào PostgreSQL bằng quyền chủ CSDL
cmd_nap_tri_thuc() {
  local tep rc
  tep="$(mktemp)"; TAM_DON+=("${tep}")
  docker exec onebee-ai-rag python3 -I /app/onebee-ai-rag.py nap-tri-thuc >"${tep}" || {
    rc=$?
    rm -f "${tep}"
    [[ ${rc} -eq 3 ]] && return 3
    die "Không nhúng được kho tri thức (xem lỗi ở trên)"
  }
  [[ -s "${tep}" ]] || die "Không có tài liệu tri thức để nạp"
  csdl <"${tep}"
  echo "Đã nạp kho tri thức vào CSDL"
}

cmd_dat_mat_khau_email() {
  local pw
  read -rsp "Mật khẩu hộp thư gửi ("{{ (onebee_box_email.smtp_user or 'chưa khai báo smtp_user') | quote }}"): " pw; echo
  [[ -n "${pw}" ]] || die "Chưa nhập mật khẩu"
  (umask 077; printf '%s' "${pw}" >"${SECRETS}/smtp-password")
  echo "Đã lưu. Chạy lại bộ cài OneBee Box để động cơ quy trình dùng mật khẩu mới, rồi: sudo onebee-box email-thu"
}

cmd_dat_telegram() {
  local token chat_id env_file="${SECRETS}/telegram.env"
  mkdir -p "${SECRETS}"
  read -r -p "Nhập Telegram Bot Token (từ @BotFather): " token
  read -r -p "Nhập Telegram Chat ID (hoặc Group ID nhận tin): " chat_id
  if [[ -z "${token}" || -z "${chat_id}" ]]; then
    die "Bot Token và Chat ID không được để trống"
  fi
  (
    umask 077
    cat >"${env_file}" <<EOF
TELEGRAM_BOT_TOKEN="${token}"
TELEGRAM_CHAT_ID="${chat_id}"
EOF
  )
  echo "Đã lưu cấu hình Telegram vào ${env_file}."
  echo "Gửi thử thông báo kiểm tra kết nối..."
  /usr/local/bin/onebee-canh-bao INFO "Kiểm tra kết nối Telegram" "OneBee Box đã kết nối thành công với bot Telegram này."
}

# ---- Tài khoản đăng nhập một lần (Authelia) ----
# Mật khẩu tạm do Authelia sinh và băm trong container (--random): mật khẩu không nằm trên dòng lệnh nào (ps), không ghi vào tệp hay nhật ký —
# chỉ in ra màn hình đúng một lần. Tệp người dùng chỉ giữ bản băm argon2id.
cmd_them_nguoi() {
  local ten="${1:-}" nhom="${2:-}" kq mk bam khoa
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] \
    || die "Cách dùng: sudo onebee-box them-nguoi <tên> <nhóm> — tên chỉ gồm chữ thường không dấu, số, dấu gạch (vd: an, ke-toan-1)"
  trong_mang "${nhom}" "${NHOM_NGUOI_DUNG[@]}" || die "Nhóm phải là một trong: ${NHOM_NGUOI_DUNG[*]}"
  [[ -f "${NGUOI_DUNG_TEP}" ]] || die "Chưa có tệp người dùng ${NGUOI_DUNG_TEP} — chạy bộ cài OneBee Box"
  ! nguoi_dung_py co "${NGUOI_DUNG_TEP}" "${ten}" || die "Đã có tài khoản ${ten} (đổi nhóm/cấp lại mật khẩu: xoa-nguoi rồi them-nguoi)"
  kq="$(docker exec onebee-authelia authelia crypto hash generate argon2 --random --random.length 16 --random.charset alphanumeric)" \
    || die "Không tạo được mật khẩu: dịch vụ định danh (onebee-authelia) chưa chạy — xem: sudo onebee-box trang-thai"
  mk="$(sed -n 's/^Random Password: //p' <<<"${kq}")"
  bam="$(sed -n 's/^Digest: //p' <<<"${kq}")"
  [[ "${mk}" =~ ^[A-Za-z0-9]{16}$ && "${bam}" == '$argon2id$'* ]] || die "Dịch vụ định danh trả kết quả lạ — chưa tạo tài khoản ${ten}"
  ONEBEE_BAM="${bam}" nguoi_dung_py them "${NGUOI_DUNG_TEP}" "${ten}" "${nhom}" "${ten}@${BOX_MA_DON_VI}.onebee.internal"
  echo "Đã tạo tài khoản ${ten} (nhóm ${nhom}). Đăng nhập tại: https://box.${BOX_MA_DON_VI}.onebee.internal/dangnhap/"
  echo "Mật khẩu tạm (chỉ hiện MỘT lần, đưa trực tiếp cho người dùng, không gửi qua Zalo/email): ${mk}"
  khoa="$(hoi_khoa cap nguoi "${ten}" 2>/dev/null)" \
    || { warn "Chưa cấp được khóa Trợ lý AI của ${ten} — chạy lại: sudo onebee-box cap-khoa-hoi ${ten}"; khoa=""; }
  [[ -z "${khoa}" ]] || echo "Khóa Trợ lý AI (chỉ hiện MỘT lần, trên máy trạm họ chạy 'hoi --dan-khoa' rồi dán): ${khoa}"
  if [[ "${nhom}" != nhan_vien ]]; then
    echo "Nhóm ${nhom} cần hai lớp: lần đầu đăng nhập, người dùng tự ghi danh mã TOTP trên điện thoại; mã xác minh 8 ký tự: sudo onebee-box ma-xac-nhan"
  fi
}

cmd_xoa_nguoi() {
  local ten="${1:-}"
  [[ "${ten}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Cách dùng: sudo onebee-box xoa-nguoi <tên>"
  nguoi_dung_py xoa "${NGUOI_DUNG_TEP}" "${ten}" || die "Không có tài khoản ${ten} (xem: sudo onebee-box danh-sach-nguoi)"
  hoi_khoa go nguoi "${ten}" >/dev/null 2>&1 || true
  # Ghi danh hai lớp của người cũ: xóa để người mới trùng tên phải tự ghi danh lại (chưa ghi danh thì lệnh này báo lỗi — bỏ qua)
  docker exec onebee-authelia authelia storage user totp delete "${ten}" --config /config/configuration.yml >/dev/null 2>&1 || true
  echo "Đã xóa tài khoản ${ten}: phiên đang mở của người này hết hiệu lực ở yêu cầu kế tiếp."
}

cmd_danh_sach_nguoi() {
  [[ -f "${NGUOI_DUNG_TEP}" ]] || die "Chưa có tệp người dùng ${NGUOI_DUNG_TEP} — chạy bộ cài OneBee Box"
  nguoi_dung_py ds "${NGUOI_DUNG_TEP}"
}

# Mã xác minh (8 ký tự) Authelia ghi vào tệp thông báo khi người dùng ghi danh hai lớp — quản trị đọc rồi đưa trực tiếp cho đúng người đó.
# Tệp chỉ giữ thông báo mới nhất. Mã hết hạn sau vài phút; không ghi mã vào nhật ký.
cmd_ma_xac_nhan() {
  [[ -s "${THONG_BAO_TEP}" ]] || die "Chưa có mã xác minh nào (người dùng chưa bấm ghi danh hai lớp trên trang đăng nhập)"
  python3 -I - "${THONG_BAO_TEP}" <<'PY'
import re, sys
dong = open(sys.argv[1], encoding="utf-8", errors="replace").read().splitlines()
bd = max((i for i, d in enumerate(dong) if d.startswith("Date: ")), default=0)
dong = dong[bd:]
lay = lambda tien_to: next((d[len(tien_to):].strip() for d in dong if d.startswith(tien_to)), "")
ma = ""
for i, d in enumerate(dong):
    if "one-time code" in d:
        ma = next((x.strip() for x in dong[i + 1:] if x.strip() and not set(x.strip()) <= {"-"}), "")
        break
if not re.fullmatch(r"[A-Za-z0-9]{6,16}", ma):
    sys.exit("LỖI: tệp thông báo không có mã xác minh")
print("Người nhận:", lay("Recipient: ").strip("{}"))
print("Lúc (giờ UTC):", lay("Date: ")[:19])
print("Mã xác minh:", ma)
PY
}

# ---- Lối thoát khi đăng nhập một lần hỏng (không ai đăng nhập được) ----
# Dấu ${SSO_TAM_TAT} được bộ cài đọc: dựng lại Caddyfile KHÔNG có forward_auth — /api/, /files/, /ai/ trả 503 (dữ liệu khóa, không mở toang),
# trang giám sát quay về mật khẩu riêng của Uptime Kuma (bộ cài bật lại đăng nhập riêng trước khi mở cổng). Mỗi lần chạy bộ cài đều cảnh báo.
SSO_TAM_TAT="${SECRETS}/sso-tam-tat"

chay_bo_cai_ap_dung() {
  local bo_cai
  bo_cai="$(cat "${LIB}/duong-dan-bo-cai" 2>/dev/null || true)"
  [[ -x "${bo_cai}" ]] || die "KHÔNG tìm thấy bộ cài — chạy NGAY bộ cài OneBee Box (sudo ./box/onebee-box-install.sh) để áp dụng"
  echo "Chạy bộ cài để dựng lại cổng Caddy (vài phút)..."
  "${bo_cai}" 9>&- || die "Bộ cài chưa xong — chạy lại NGAY: sudo ${bo_cai}"
}

cmd_tat_sso_tam() {
  https_bat || die "HTTPS chưa bật — Box chưa dùng đăng nhập một lần, không có gì để tắt"
  (umask 077; date '+%F %T' >"${SSO_TAM_TAT}")
  warn "TẠM TẮT đăng nhập một lần. Trong lúc này /api/, /files/, /ai/ trả 503 (không ai vào được dữ liệu),"
  warn "trang giám sát đòi mật khẩu riêng của Uptime Kuma (tài khoản quantri, mật khẩu: sudo onebee-box in-khoa)."
  warn "Sửa xong dịch vụ định danh (xem: sudo docker logs --tail 50 onebee-authelia) thì chạy: sudo onebee-box bat-sso-lai"
  chay_bo_cai_ap_dung
  echo "Đã tạm tắt đăng nhập một lần."
}

cmd_bat_sso_lai() {
  [[ -e "${SSO_TAM_TAT}" ]] || { echo "Đăng nhập một lần đang bật — không có gì để làm."; return 0; }
  rm -f "${SSO_TAM_TAT}"
  chay_bo_cai_ap_dung
  echo "Đã bật lại đăng nhập một lần: /api/, /files/, /ai/ và trang giám sát lại đòi đăng nhập qua https://box.${BOX_MA_DON_VI}.onebee.internal/dangnhap/"
}

# Không cho 2 lệnh sao lưu / xoay khóa chạy chồng nhau (lịch tự động + chạy tay)
lay_khoa() { exec 9>/run/onebee-box.lock; flock -n 9 || die "Đang có lệnh sao lưu / xoay khóa khác chạy — thử lại sau"; }
with_lock() { lay_khoa; "$@"; }

case "${1:-}" in
  trang-thai) cmd_trang_thai ;;
  chan-doan) shift; cmd_chan_doan "$@" ;;
  canh-bao) shift; /usr/local/bin/onebee-canh-bao "$@" ;;
  dat-telegram) cmd_dat_telegram ;;
  them-may) shift; cmd_them_may "$@" ;;
  may-tram) cmd_may_tram ;;
  bao-cao-tuan) shift; cmd_bao_cao_tuan "$@" ;;
  chuyen-du-lieu) chuyen_du_lieu ;;
  dong-bo-mat-khau-csdl) dong_bo_mat_khau_csdl ;;   # bộ cài gọi (role box-du-lieu)
  cap-nhat-may) shift; cmd_cap_nhat_may "$@" ;;
  dong-bo-may) shift; cmd_dong_bo_may "$@" ;;
  thu-hoi-may) shift; cmd_thu_hoi_may "$@" ;;
  ghim-lai-may) shift; cmd_ghim_lai_may "$@" ;;
  dong-bo-ten-may) dong_bo_ten_may ;;
  # Không lấy khóa sao lưu/xoay khóa: bộ cài gọi lệnh này khi đang giữ khóa (tat-sso-tam, xoay-khoa --box);
  # nạp tri thức chỉ đọc tệp bí mật và ghi CSDL trong một giao dịch, không xung đột với sao lưu hay xoay khóa.
  nap-tri-thuc) cmd_nap_tri_thuc ;;
  cap-khoa-hoi) shift; cmd_cap_khoa_hoi "$@" ;;
  go-khoa-hoi) shift; cmd_go_khoa_hoi "$@" ;;
  khoi-tao) with_lock cmd_khoi_tao ;;
  sao-luu) with_lock cmd_sao_luu_co_bao_cao ;;
  khoi-phuc-thu) with_lock cmd_khoi_phuc_thu ;;
  khoi-phuc-toan-bo) shift; with_lock cmd_khoi_phuc_toan_bo "$@" ;;
  in-khoa) cmd_in_khoa ;;
  xoay-khoa) shift; cmd_xoay_khoa "$@" ;;   # tự lấy khóa sau bước xác nhận
  in-ca) cmd_in_ca ;;
  gia-han-ca) gia_han_ca ;;
  go-khoa-hoi-may) cmd_go_khoa_hoi_may ;;
  may-chua-nhan-ca) may_chua_nhan_ca ;;
  dat-mat-khau-email) cmd_dat_mat_khau_email ;;
  them-nguoi) shift; cmd_them_nguoi "$@" ;;
  xoa-nguoi) shift; cmd_xoa_nguoi "$@" ;;
  danh-sach-nguoi) cmd_danh_sach_nguoi ;;
  ma-xac-nhan) cmd_ma_xac_nhan ;;
  tat-sso-tam) with_lock cmd_tat_sso_tam ;;
  bat-sso-lai) with_lock cmd_bat_sso_lai ;;
  cap-nhat-chu-ky-clamav)
    [[ -n "${2:-}" ]] || die "Cách dùng: sudo onebee-box cap-nhat-chu-ky-clamav <thư mục chứa main.cvd, daily.cvd, bytecode.cvd>"
    python3 /usr/local/lib/onebee-box/onebee-kho-tep.py cap-nhat-chu-ky "${2}" "${DATA}/clamav" ;;
  email-thu) bao_cao_quy_trinh THU "Email thử từ OneBee Box lúc $(date '+%H:%M %d/%m/%Y') — cấu hình email đã dùng được." \
               && echo "Đã chuyển cho động cơ quy trình gửi — kiểm tra hộp thư "{{ onebee_box_email.nhan | quote }}" (cả mục Spam)." ;;
  *) sed -n '/^set -euo/q; 2,$s/^# //p' "$0"; exit 1 ;;
esac

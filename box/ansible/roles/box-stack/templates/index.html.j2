{# Trang chủ OneBee Box (cổng 80; HTTPS: cổng 443). Một tệp, không tải gì từ Internet: Box trong LAN có thể không ra mạng được.
   Lối tắt dựng theo tên đang gõ (IP hoặc {{ onebee_box_ten_mdns }}.local). Số liệu: /trang-thai.json (onebee-trang-thai-web.timer). #}
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>OneBee Box{% if onebee_box_ten_don_vi %} — {{ onebee_box_ten_don_vi | e }}{% endif %}</title>
<style>
  :root { --navy:#0E1B2C; --card:#17304A; --honey:#F5A524; --teal:#2DD4BF; --red:#F87171; --text:#F8FAFC; --sub:#94A3B8; }
  * { box-sizing: border-box; }
  body { margin:0; min-height:100vh; font-family: "Noto Sans", system-ui, sans-serif; background:var(--navy); color:var(--text); padding:24px 16px; line-height:1.45; }
  main { width:min(860px,100%); margin:0 auto; }
  h1 { margin:0; font-size:clamp(28px,6vw,44px); }
  .don-vi { margin:2px 0 0; font-size:clamp(18px,4vw,24px); color:var(--honey); font-weight:600; }
  p.sub { margin:4px 0 24px; color:var(--sub); }
  h2 { margin:28px 0 12px; font-size:16px; color:var(--sub); font-weight:600; text-transform:uppercase; letter-spacing:.04em; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:12px; }
  .card { display:block; padding:16px 18px; border-radius:12px; background:var(--card); color:var(--text); text-decoration:none; border-left:6px solid var(--honey); }
  a.card:hover, a.card:focus { outline:2px solid var(--teal); }
  .card b { display:block; font-size:19px; }
  .card span, .card small { color:var(--sub); }
  .card .bieu-tuong { font-size:26px; float:right; margin-left:8px; }
  .phu .card { border-left-color:var(--teal); }
  .phu .card b { font-size:17px; }
  code { color:var(--teal); font-size:15px; word-break:break-all; }
  /* Tình trạng hệ thống */
  .so-lieu { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; }
  .chi-so { background:var(--card); border-radius:12px; padding:14px 16px; }
  .chi-so .ten { color:var(--sub); font-size:14px; }
  .chi-so .gia-tri { font-size:26px; font-weight:700; }
  .thanh { height:8px; border-radius:4px; background:#0B1522; overflow:hidden; margin-top:6px; }
  .thanh i { display:block; height:100%; width:0; background:var(--teal); transition:width .4s; }
  [data-muc="canh-bao"] .thanh i { background:var(--honey); }
  [data-muc="loi"] .thanh i { background:var(--red); }
  .dich-vu { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
  .dich-vu span { padding:6px 12px; border-radius:999px; background:var(--card); font-size:15px; }
  .dich-vu b { font-weight:600; color:var(--sub); }
  .dich-vu b[data-muc="tot"] { color:var(--teal); }
  .dich-vu b[data-muc="canh-bao"] { color:var(--honey); }
  .dich-vu b[data-muc="loi"] { color:var(--red); }
  #tt-cap-nhat { color:var(--sub); font-size:13px; margin-top:8px; }
  #tt-cap-nhat[data-muc="loi"] { color:var(--honey); }
  /* Cẩm nang */
  details { background:var(--card); border-radius:12px; padding:12px 16px; margin-bottom:10px; }
  summary { cursor:pointer; font-weight:600; font-size:17px; }
  details ul { margin:10px 0 4px; padding-left:20px; }
  details li { margin:4px 0; }
  kbd { background:#0B1522; border:1px solid #334155; border-radius:4px; padding:1px 6px; font-family:inherit; font-size:14px; white-space:nowrap; }
  .note { margin-top:20px; color:var(--sub); font-size:14px; }
  .note a { color:var(--teal); }
</style>
</head>
<body>
<main>
  <h1>OneBee Box</h1>
{% if onebee_box_ten_don_vi %}
  <p class="don-vi">{{ onebee_box_ten_don_vi | e }}</p>
{% endif %}
  <p class="sub">Máy chủ nội bộ — dữ liệu ở lại trong đơn vị. Vào trang này bằng tên <code id="ten-box">{{ onebee_box_ten_mdns }}.local</code>, không cần nhớ IP.</p>

  <section id="trang-thai" aria-labelledby="h-trang-thai">
    <h2 id="h-trang-thai">Tình trạng hệ thống</h2>
    <div class="so-lieu">
      <div class="chi-so" id="tt-cpu-o"><div class="ten">Bộ xử lý (CPU) đang dùng</div><div class="gia-tri" id="tt-cpu">…</div><div class="thanh"><i></i></div></div>
      <div class="chi-so" id="tt-ram-o"><div class="ten">Bộ nhớ (RAM) đang dùng</div><div class="gia-tri" id="tt-ram">…</div><div class="thanh"><i></i></div></div>
      <div class="chi-so" id="tt-o-dia-o"><div class="ten">Ổ dữ liệu còn trống</div><div class="gia-tri" id="tt-o-dia">…</div><div class="thanh"><i></i></div></div>
    </div>
    <div class="dich-vu">
      <span>Trợ lý AI: <b id="dv-tro_ly_ai">…</b></span>
      <span>Thư mục chung: <b id="dv-thu_muc_chung">…</b></span>
      <span>Sao lưu: <b id="dv-sao_luu">…</b></span>
    </div>
    <div id="tt-cap-nhat">Đang tải số liệu…</div>
  </section>

  <h2>Truy cập nhanh</h2>
  <div class="grid">
    <a class="card" data-port="{{ onebee_box_ports.open_webui }}" href="#"><span class="bieu-tuong" aria-hidden="true">🤖</span><b>Trợ lý AI nội bộ</b><span>Hỏi đáp, soạn công văn, tóm tắt — AI chạy ngay tại đơn vị</span></a>
    <div class="card"><span class="bieu-tuong" aria-hidden="true">📁</span><b>Thư mục dùng chung</b>
      <small>Windows: bấm <kbd>Windows + R</kbd>, gõ</small><br><code id="smb-win">\\{{ onebee_box_ten_mdns }}.local\{{ onebee_box_samba_share }}</code><br>
      <small>Linux Mint, macOS: thanh địa chỉ trình quản lý tệp, gõ</small><br><code id="smb">smb://{{ onebee_box_ten_mdns }}.local/{{ onebee_box_samba_share }}</code></div>
    <a class="card" data-port="{{ onebee_box_ports.n8n }}" data-path="form/onebee-ho-tro" href="#"><span class="bieu-tuong" aria-hidden="true">🛠️</span><b>Yêu cầu hỗ trợ kỹ thuật</b><span>Gửi kỹ thuật OneBee: máy lỗi, cần cài đặt, cần hướng dẫn</span></a>
    <a class="card" href="#cam-nang"><span class="bieu-tuong" aria-hidden="true">📖</span><b>Cẩm nang sử dụng</b><span>Phím tắt, in ấn, lưu trữ và sao lưu</span></a>
  </div>

  <h2>Biểu mẫu và quản trị (tài khoản do quản trị cấp)</h2>
  <div class="grid phu">
    <a class="card" data-port="{{ onebee_box_ports.n8n }}" data-path="form/onebee-don-hang" href="#"><b>Nhập đơn hàng</b><span>Ghi vào thư mục chung</span></a>
    <a class="card" data-port="{{ onebee_box_ports.n8n }}" data-path="form/onebee-tom-tat" href="#"><b>Tóm tắt văn bản PDF</b><span>Bằng AI tại đơn vị</span></a>
    <a class="card" data-port="{{ onebee_box_ports.n8n }}" href="#"><b>Tự động hóa (n8n)</b><span>Nhắc việc, báo cáo, chuyển dữ liệu</span></a>
    <a class="card" data-port="{{ onebee_box_ports.uptime_kuma }}" href="#"><b>Giám sát</b><span>Máy chủ và dịch vụ còn chạy hay không</span></a>
  </div>

  <section id="cam-nang" aria-labelledby="h-cam-nang">
    <h2 id="h-cam-nang">Cẩm nang sử dụng</h2>
    <details>
      <summary>Phím tắt hay dùng</summary>
      <ul>
        <li><kbd>Super + Space</kbd> — đổi bộ gõ tiếng Việt / tiếng Anh (Super là phím có logo Windows)</li>
        <li><kbd>Ctrl + C</kbd> / <kbd>Ctrl + V</kbd> — sao chép / dán; <kbd>Ctrl + Z</kbd> — hoàn tác</li>
        <li><kbd>Ctrl + S</kbd> — lưu tệp; <kbd>Ctrl + Shift + S</kbd> — lưu thành tệp khác</li>
        <li><kbd>Ctrl + F</kbd> — tìm chữ trong tài liệu, trang web</li>
        <li><kbd>Print Screen</kbd> — chụp màn hình</li>
        <li><kbd>Ctrl + Alt + L</kbd> — khóa màn hình khi rời chỗ ngồi</li>
      </ul>
    </details>
    <details>
      <summary>In ấn và xuất PDF</summary>
      <ul>
        <li><kbd>Ctrl + P</kbd> — mở hộp in; chọn đúng máy in, số bản, in 2 mặt (nếu máy in hỗ trợ)</li>
        <li>Xuất PDF trong LibreOffice: menu <b>Tệp → Xuất ra PDF</b> (File → Export as PDF) — gửi đi không lệch bố cục</li>
        <li>Máy in không in: kiểm tra giấy, dây/mạng của máy in, rồi bấm <b>Yêu cầu hỗ trợ kỹ thuật</b> ở trên</li>
      </ul>
    </details>
    <details>
      <summary>Lưu trữ và sao lưu</summary>
      <ul>
        <li>LibreOffice lưu mặc định dạng Word/Excel (.docx/.xlsx) — gửi cho đơn vị khác mở được ngay</li>
        <li>Tài liệu cần dùng chung: lưu vào <b>Thư mục dùng chung</b> trên Box, không gửi qua USB</li>
        <li>Máy văn phòng tự sao lưu lên Box lúc 12:00 hằng ngày (để máy bật); Box tự sao lưu ra ổ ngoài lúc {{ onebee_box_backup_time.split(' ')[1][:5] }}</li>
        <li>Lỡ xóa/ghi đè tệp: báo kỹ thuật để lấy lại từ bản sao lưu — không tự cài phần mềm khôi phục</li>
      </ul>
    </details>
    <details>
      <summary>Hỏi Trợ lý AI ngay từ máy văn phòng</summary>
      <ul>
        <li>Mở Terminal, gõ <code>hoi "Soạn thông báo họp xã viên ngày thứ Sáu"</code></li>
        <li>Câu hỏi và tài liệu chỉ đi tới Box trong đơn vị, không gửi ra Internet</li>
      </ul>
    </details>
  </section>

  <p class="note"><a href="/onebee-ca.crt">Chứng chỉ OneBee Box</a> — chỉ cài khi đã đối chiếu vân tay với bản in của quản trị (<code>sudo onebee-box in-ca</code>)</p>
  <p class="note">OneBee Box {{ onebee_box_version }} · HTX OneBee</p>
</main>
<script>
  var host = window.location.hostname;
  document.querySelectorAll("a.card[data-port]").forEach(function (a) {
    a.href = window.location.protocol + "//" + host + ":" + a.getAttribute("data-port") + "/" + (a.getAttribute("data-path") || "");
  });
  document.getElementById("ten-box").textContent = host;
  document.getElementById("smb-win").textContent = "\\\\" + host + "\\{{ onebee_box_samba_share }}";
  document.getElementById("smb").textContent = "smb://" + host + "/{{ onebee_box_samba_share }}";

  var NHAN = { chay: "Đang chạy", dung: "Ngừng", tot: "Tốt", qua_han: "Quá hạn", loi: "Lỗi", chua_co: "Chưa có" };
  var MUC = { chay: "tot", tot: "tot", qua_han: "canh-bao", chua_co: "canh-bao", dung: "loi", loi: "loi" };
  function pt(x) { x = Math.round(Number(x)); return isFinite(x) ? Math.min(100, Math.max(0, x)) : 0; }
  // Ô chỉ số: chữ hiện + thanh theo % đã dùng; ≥ 85% vàng, ≥ 95% đỏ
  function chiSo(id, chu, daDung) {
    document.getElementById(id).textContent = chu;
    var o = document.getElementById(id + "-o");
    o.setAttribute("data-muc", daDung >= 95 ? "loi" : daDung >= 85 ? "canh-bao" : "tot");
    o.querySelector(".thanh i").style.width = daDung + "%";
  }
  function capNhat(d) {
    chiSo("tt-cpu", pt(d.cpu_phan_tram) + "%", pt(d.cpu_phan_tram));
    chiSo("tt-ram", pt(d.ram_phan_tram) + "%", pt(d.ram_phan_tram));
    var od = d.o_dia || {};
    chiSo("tt-o-dia", (Number(od.con_trong_gb) || 0).toLocaleString("vi-VN") + " GB", pt(od.da_dung_phan_tram));
    ["tro_ly_ai", "thu_muc_chung", "sao_luu"].forEach(function (k) {
      var v = (d.dich_vu || {})[k], b = document.getElementById("dv-" + k);
      b.textContent = NHAN[v] || "Không rõ";
      b.setAttribute("data-muc", MUC[v] || "canh-bao");
    });
    var t = new Date(d.cap_nhat), e = document.getElementById("tt-cap-nhat");
    e.textContent = "Cập nhật lúc " + t.toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
    e.setAttribute("data-muc", Date.now() - t.getTime() > 5 * 60000 ? "loi" : "tot");   // số liệu cũ: lịch cập nhật trên Box đã ngừng
  }
  function tai() {
    fetch("/trang-thai.json", { cache: "no-store" })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(capNhat)
      .catch(function () {
        var e = document.getElementById("tt-cap-nhat");
        e.textContent = "Chưa đọc được số liệu tình trạng — thử tải lại trang sau 1 phút";
        e.setAttribute("data-muc", "loi");
      });
  }
  tai();
  setInterval(tai, 60000);
</script>
</body>
</html>

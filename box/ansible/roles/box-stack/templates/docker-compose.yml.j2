# Quản lý bởi OneBee OS (box/ansible/roles/box-stack) — sửa group_vars rồi chạy lại bộ cài, không sửa tay
name: onebee-box

# Giới hạn nhật ký mỗi dịch vụ (3 file x 10 MB) để không đầy ổ khi chạy 24/7
x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  portal:
    image: {{ onebee_box_images.caddy }}
    container_name: onebee-portal
    restart: unless-stopped
    logging: *logging
    ports: ["{{ onebee_box_ports.portal }}:80"]
    volumes:
      - ./portal/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./portal/site:/srv:ro

  ollama:
    image: {{ onebee_box_images.ollama }}
    container_name: onebee-ollama
    restart: unless-stopped
    logging: *logging
    # Không mở cổng ra LAN: chỉ Open WebUI gọi được (API Ollama không có mật khẩu)
    volumes:
      - {{ onebee_box_data }}/ollama:/root/.ollama

  open-webui:
    image: {{ onebee_box_images.open_webui }}
    container_name: onebee-open-webui
    restart: unless-stopped
    logging: *logging
    depends_on: [ollama]
    ports: ["{{ onebee_box_ports.open_webui }}:8080"]
    environment:
      OLLAMA_BASE_URL: http://ollama:11434
      WEBUI_SECRET_KEY: ${WEBUI_SECRET_KEY}
      # Tạo sẵn tài khoản quản trị lúc khởi động lần đầu → tự tắt đăng ký tự do (không còn "ai mở trước thành quản trị")
      WEBUI_ADMIN_EMAIL: {{ onebee_box_admin_email }}
      WEBUI_ADMIN_PASSWORD: ${WEBUI_ADMIN_PASSWORD}
      WEBUI_ADMIN_NAME: Quản trị OneBee
      ENABLE_SIGNUP: "false"
      DEFAULT_MODELS: onebee-tro-ly
      # Khóa API cho lệnh "hoi" trên máy trạm — chỉ gọi được hỏi đáp và danh sách model
      ENABLE_API_KEYS: "true"
      USER_PERMISSIONS_FEATURES_API_KEYS: "true"
      ENABLE_API_KEYS_ENDPOINT_RESTRICTIONS: "true"
      API_KEYS_ALLOWED_ENDPOINTS: /api/chat/completions,/api/models
      DEFAULT_LOCALE: vi-VN
      ENABLE_OPENAI_API: "false"   # không gọi AI đám mây — dữ liệu ở lại trong LAN
      OFFLINE_MODE: "true"
      SCARF_NO_ANALYTICS: "true"
      DO_NOT_TRACK: "true"
      ANONYMIZED_TELEMETRY: "false"
    volumes:
      - {{ onebee_box_data }}/open-webui:/app/backend/data

  n8n:
    image: {{ onebee_box_images.n8n }}
    container_name: onebee-n8n
    restart: unless-stopped
    logging: *logging
    ports: ["{{ onebee_box_ports.n8n }}:5678"]
    environment:
      N8N_ENCRYPTION_KEY: ${N8N_ENCRYPTION_KEY}
      N8N_LISTEN_ADDRESS: 0.0.0.0  # mặc định n8n nghe "::" (IPv6) → lỗi trên máy tắt IPv6
      GENERIC_TIMEZONE: {{ onebee_timezone }}
      TZ: {{ onebee_timezone }}
      N8N_SECURE_COOKIE: "false"   # chạy HTTP trong LAN; truy cập từ xa chỉ qua VPN (Tailscale/WireGuard)
      N8N_DIAGNOSTICS_ENABLED: "false"
      N8N_VERSION_NOTIFICATIONS_ENABLED: "false"
      N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: "true"
      N8N_PERSONALIZATION_ENABLED: "false"
      # Địa chỉ n8n in vào đường dẫn biểu mẫu (người dùng trong LAN mở được)
      WEBHOOK_URL: http://{{ onebee_box_address or ansible_default_ipv4.address | default('127.0.0.1') }}:{{ onebee_box_ports.n8n }}/
      # Tạo sẵn tài khoản chủ n8n (mật khẩu: onebee-box in-khoa) — không còn "ai mở trước thành chủ"
      N8N_INSTANCE_OWNER_MANAGED_BY_ENV: "true"
      N8N_INSTANCE_OWNER_EMAIL: {{ onebee_box_admin_email }}
      N8N_INSTANCE_OWNER_FIRST_NAME: Quản trị
      N8N_INSTANCE_OWNER_LAST_NAME: OneBee
      N8N_INSTANCE_OWNER_PASSWORD_HASH: ${N8N_OWNER_HASH}
    volumes:
      - {{ onebee_box_data }}/n8n:/home/node/.n8n
      - {{ onebee_box_dir }}/n8n-import:/import:ro
      - {{ onebee_box_data }}/{{ onebee_box_samba_share }}/don-hang:/home/node/.n8n-files/don-hang
      - {{ onebee_box_data }}/tinh-trang-may:/home/node/.n8n-files/tinh-trang-may
      - {{ onebee_box_data }}/ho-tro:/home/node/.n8n-files/ho-tro

  uptime-kuma:
    image: {{ onebee_box_images.uptime_kuma }}
    container_name: onebee-uptime-kuma
    restart: unless-stopped
    logging: *logging
    ports: ["{{ onebee_box_ports.uptime_kuma }}:3001"]
    environment:
      UPTIME_KUMA_DB_TYPE: sqlite   # bỏ trang chọn cơ sở dữ liệu lúc mở lần đầu (ai mở trước chọn được)
    volumes:
      - {{ onebee_box_data }}/uptime-kuma:/app/data

  rest-server:
    image: {{ onebee_box_images.rest_server }}
    container_name: onebee-rest-server
    restart: unless-stopped
    logging: *logging
    ports: ["{{ onebee_box_ports.rest_server }}:8000"]
    environment:
      # Mỗi máy trạm chỉ thấy kho sao lưu của chính nó; chỉ thêm, không xóa được bản cũ (chống mã độc tống tiền)
      OPTIONS: "--private-repos --append-only"
    volumes:
      - {{ onebee_box_data }}/restic:/data

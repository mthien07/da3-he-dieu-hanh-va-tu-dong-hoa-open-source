# shellcheck shell=bash
# Sao lưu / khôi phục OneBee Box (quản lý bởi OneBee OS, không sửa tay). Được lệnh onebee-box nạp vào.

box_repo_env() {
  export RESTIC_REPOSITORY="${BACKUP_REPO}"
  RESTIC_PASSWORD="$(secret restic-box)"; export RESTIC_PASSWORD
}

# Ổ sao lưu phải là ổ gắn riêng (mountpoint) — nếu chưa gắn, KHÔNG ghi vào ổ hệ thống
require_backup_disk() {
  mountpoint -q "${BACKUP_MOUNT}" || die "Chưa gắn ổ sao lưu vào ${BACKUP_MOUNT} — không sao lưu (tránh ghi đầy ổ hệ thống)"
}

cmd_khoi_tao() {
  require_backup_disk
  box_repo_env
  if restic cat config >/dev/null 2>&1; then echo "Kho sao lưu Box đã có sẵn tại ${BACKUP_REPO}"; return; fi
  restic init
  echo "Đã tạo kho sao lưu Box. Chạy tiếp: sudo onebee-box in-khoa (cất khóa ra giấy/USB) rồi sudo onebee-box khoi-phuc-thu"
}

# Dọn bản cũ trong kho từng máy trạm (kho chỉ-thêm nên máy trạm không tự dọn được)
prune_workstations() {
  local f ten repo failed=0
  for f in "${SECRETS}"/may-*-repo; do
    [[ -e "${f}" ]] || continue
    ten="$(basename "${f}")"; ten="${ten#may-}"; ten="${ten%-repo}"
    repo="${DATA}/restic/${ten}"
    [[ -f "${repo}/config" ]] || continue
    export RESTIC_REPOSITORY="${repo}" RESTIC_PASSWORD
    RESTIC_PASSWORD="$(cat "${f}")"
    # Bản có ngày ở tương lai = dấu hiệu giả mạo → không dọn kho này, báo ngay
    if restic snapshots --json 2>/dev/null | python3 -c '
import json, sys, re, datetime
lim = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=1)
def t(v): return datetime.datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", v).replace("Z", "+00:00"))
sys.exit(any(t(s["time"]) > lim for s in json.load(sys.stdin)))'; then
      restic forget --retry-lock 5m --prune "${KEEP_MAY[@]}" || { warn "Không dọn được kho máy ${ten}"; failed=1; }
    else
      warn "Kho máy ${ten} có bản sao lưu mang ngày tương lai — KHÔNG dọn, cần kiểm tra máy này"; failed=1
    fi
  done
  return "${failed}"
}

cmd_sao_luu() {
  require_backup_disk
  box_repo_env
  restic cat config >/dev/null 2>&1 || die "Chưa tạo kho sao lưu Box. Chạy: sudo onebee-box khoi-tao"
  [[ "$(stat -c %d "${BACKUP_MOUNT}")" != "$(stat -c %d "${DATA}")" ]] || warn "Ổ sao lưu cùng ổ với dữ liệu — hỏng ổ là mất cả hai"

  # Bước 1: tạm dừng dịch vụ có cơ sở dữ liệu, chụp nhanh phần dữ liệu của chúng (nhất quán), chạy lại ngay
  local svcs=(open-webui n8n uptime-kuma)
  trap 'compose unpause "${svcs[@]}" >/dev/null 2>&1 || true' EXIT
  compose pause "${svcs[@]}" >/dev/null 2>&1 || die "Không tạm dừng được dịch vụ ${svcs[*]}"
  restic backup --retry-lock 5m --tag onebee-box --tag csdl \
    "${DATA}/open-webui" "${DATA}/n8n" "${DATA}/uptime-kuma" "${DATA}/ho-tro" "${BOX_DIR}" "${SECRETS}"
  compose unpause "${svcs[@]}" >/dev/null 2>&1 || die "Không chạy lại được dịch vụ ${svcs[*]} — kiểm tra: sudo onebee-box trang-thai"
  trap - EXIT
  # Bước 2: thư mục chung (có thể lâu) — dịch vụ vẫn chạy. Không sao lưu model AI (tải lại được)
  # và kho máy trạm (đã là bản sao).
  restic backup --retry-lock 5m --tag onebee-box --tag chung "${SHARE}"
  restic forget --retry-lock 5m --tag onebee-box --prune "${KEEP_BOX[@]}"
  prune_workstations || warn "Có kho máy trạm chưa dọn được (xem các dòng CẢNH BÁO ở trên)"
  echo "Sao lưu xong: $(date '+%d/%m/%Y %H:%M')"
}

cmd_khoi_phuc_thu() {
  local mau="${SHARE}/.onebee-kiem-tra-sao-luu.txt" tmp sum
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp:-}"; trap - RETURN' RETURN
  echo "Kiểm tra khôi phục $(date +%s%N)" >"${mau}"
  sum="$(sha256sum <"${mau}")"
  cmd_sao_luu >/dev/null
  rm -f "${mau}"
  box_repo_env
  restic restore latest --tag onebee-box,chung --target "${tmp}" --include "${mau}" >/dev/null
  [[ "$(sha256sum <"${tmp}${mau}")" == "${sum}" ]] || die "KHÔNG ĐẠT: file khôi phục khác bản gốc"
  echo "ĐẠT: khôi phục đúng file đã xóa từ bản sao lưu"
}

# In "tên=số giờ từ lần sao lưu cuối" (hoặc "tên=null") cho mọi máy trạm đã cấp — Box tự đọc kho sao lưu
gio_sao_luu_may() {
  local f ten t
  for f in "${SECRETS}"/may-*-repo; do
    [[ -e "${f}" ]] || continue
    ten="$(basename "${f}")"; ten="${ten#may-}"; ten="${ten%-repo}"
    t="null"
    if [[ -f "${DATA}/restic/${ten}/config" ]]; then
      t="$(RESTIC_REPOSITORY="${DATA}/restic/${ten}" RESTIC_PASSWORD="$(cat "${f}")" \
           restic snapshots --latest 1 --json 2>/dev/null | python3 -c '
import json, sys, re, datetime
s = json.load(sys.stdin)
if not s: print("null"); sys.exit()
t = max(datetime.datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", x["time"]).replace("Z", "+00:00")) for x in s)
print(int((datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() // 3600))' || echo loi)"
    fi
    echo "${ten}=${t}"
  done
}

may_tram_py() { python3 /usr/local/lib/onebee-box/onebee-may-tram.py "$1" "${DATA}/tinh-trang-may" "${@:2}"; }

# Gửi kết quả sao lưu + tình trạng từng máy trạm (sao lưu, cập nhật, ổ đĩa...) sang n8n → email cho quản trị
bao_cao_n8n() {
  local trang_thai="$1" noi_dung="$2" payload hdr
  local -a may=()
  [[ "${trang_thai}" == THU ]] || mapfile -t may < <(gio_sao_luu_may)   # email thử: không cần đọc kho máy trạm
  payload="$(mktemp)"; hdr="$(mktemp)"
  trap 'rm -f "${payload}" "${hdr}"; trap - RETURN' RETURN
  may_tram_py payload "${trang_thai}" "${noi_dung}" "${may[@]}" >"${payload}"
  (umask 077; printf 'X-OneBee-Key: %s\n' "$(cat "${SECRETS}/n8n-webhook-key")" >"${hdr}")
  curl -fsS -m 30 -X POST "http://127.0.0.1:${N8N_PORT}/webhook/onebee-bao-cao-sao-luu" -H @"${hdr}" \
    -H 'Content-Type: application/json' --data-binary @"${payload}" >/dev/null
}

# Sao lưu + luôn gửi báo cáo (kể cả khi lỗi) — lịch 23:00 gọi lệnh này
cmd_sao_luu_co_bao_cao() {
  local log st
  log="$(mktemp)"
  set +e
  ( cmd_sao_luu ) 2>&1 | tee "${log}"
  st=${PIPESTATUS[0]}
  set -e
  bao_cao_n8n "$([[ ${st} -eq 0 ]] && echo DAT || echo LOI)" "$(tail -n 12 "${log}")" \
    || warn "Không gửi được báo cáo sao lưu qua n8n/email"
  rm -f "${log}"
  return "${st}"
}

# Khôi phục toàn bộ Box khi hỏng ổ: chạy trên Box ĐÃ CÀI LẠI (bộ cài OneBee Box), đã gắn ổ sao lưu cũ.
# $1 = file khóa in từ 'onebee-box in-khoa' (dùng dòng restic-box=…); không đưa file thì hỏi khóa.
cmd_khoi_phuc_toan_bo() {
  local tep="${1:-}" khoa f ten
  require_backup_disk
  if [[ -n "${tep}" ]]; then
    [[ -r "${tep}" ]] || die "Không đọc được file khóa ${tep}"
    khoa="$(grep -m1 '^restic-box=' "${tep}" | cut -d= -f2- | tr -d '\r')"
  else
    read -rsp "Khóa sao lưu Box (dòng restic-box trong bản in 'in-khoa'): " khoa; echo
  fi
  [[ -n "${khoa}" ]] || die "Thiếu khóa restic-box"
  export RESTIC_REPOSITORY="${BACKUP_REPO}" RESTIC_PASSWORD="${khoa}"
  restic cat config >/dev/null 2>&1 || die "Khóa sai, hoặc ổ không có kho sao lưu Box tại ${BACKUP_REPO}"
  restic snapshots --latest 1 --tag onebee-box,csdl --json \
    | python3 -c 'import json, sys; sys.exit(0 if json.load(sys.stdin) else 1)' || die "Kho không có bản sao lưu dữ liệu Box"
  echo "Dừng dịch vụ, khôi phục cơ sở dữ liệu, khóa bí mật, cấu hình, thư mục chung…"
  compose stop >/dev/null 2>&1 || true
  # Xóa dữ liệu của bản cài mới trước khi chép bản cũ vào (restic không xóa file thừa; file tạm của CSDL mới
  # lẫn với CSDL cũ có thể làm hỏng dữ liệu)
  rm -rf "${DATA}/open-webui" "${DATA}/n8n" "${DATA}/uptime-kuma" "${DATA}/ho-tro"
  restic restore latest --tag onebee-box,csdl --target / || die "Khôi phục dữ liệu Box lỗi — chưa chạy lại dịch vụ"
  restic restore latest --tag onebee-box,chung --target / || warn "Khôi phục thư mục chung lỗi — thử lại lệnh này"
  # Kho sao lưu máy trạm không nằm trong bản sao lưu Box → cấp lại tài khoản kho bằng mật khẩu cũ
  # (máy trạm dùng cấu hình cũ, tự tạo kho mới ở lần sao lưu sau)
  : >"${DATA}/restic/.htpasswd"
  for f in "${SECRETS}"/may-*-http; do
    [[ -e "${f}" ]] || continue
    ten="$(basename "${f}")"; ten="${ten#may-}"; ten="${ten%-http}"
    htpasswd -B -i "${DATA}/restic/.htpasswd" "${ten}" <"${f}" 2>/dev/null
  done
  compose up -d >/dev/null
  echo "Đã khôi phục. Việc tiếp theo: chạy lại bộ cài (sudo ./box/onebee-box-install.sh) để đồng bộ cấu hình, rồi"
  echo "sudo onebee-box khoi-phuc-thu. Máy trạm không cần làm gì (dùng lại cấu hình cũ)."
}

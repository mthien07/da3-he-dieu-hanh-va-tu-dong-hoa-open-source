# Sao lưu / khôi phục OneBee Box (quản lý bởi OneBee OS, không sửa tay). Được lệnh onebee-box nạp vào.

box_repo_env() {
  export RESTIC_REPOSITORY="${BACKUP_REPO}"
  RESTIC_PASSWORD="$(secret restic-box)"; export RESTIC_PASSWORD
}

# % đã dùng của ổ chứa thư mục $1 (số nguyên)
phan_tram_da_dung() { df -P "$1" | awk 'NR == 2 { sub("%", "", $5); print $5 }'; }

# Sao lưu ra ổ ngoài: ổ phải là ổ gắn riêng (mountpoint) — chưa gắn thì KHÔNG ghi vào ổ hệ thống.
# Sao lưu trong ổ Box (mặc định): chỉ cần thư mục kho (chỉ root đọc được).
require_backup_disk() {
  if [[ "${BACKUP_O_NGOAI}" == true ]]; then
    mountpoint -q "${BACKUP_MOUNT}" || die "Chưa gắn ổ sao lưu vào ${BACKUP_MOUNT} — không sao lưu (tránh ghi đầy ổ hệ thống)"
  else
    install -d -m 0700 "${BACKUP_MOUNT}"
  fi
}

cmd_khoi_tao() {
  require_backup_disk
  box_repo_env
  if restic cat config >/dev/null 2>&1; then echo "Kho sao lưu Box đã có sẵn tại ${BACKUP_REPO}"; return; fi
  restic init
  echo "Đã tạo kho sao lưu Box. Chạy tiếp: sudo onebee-box in-khoa (cất khóa ra giấy/USB) rồi sudo onebee-box khoi-phuc-thu"
}

# Dọn bản cũ trong kho từng máy trạm (kho chỉ-thêm nên máy trạm không tự dọn được)
prune_workstations() {
  local f ten repo failed=0
  for f in "${SECRETS}"/may-*-repo; do
    [[ -e "${f}" ]] || continue
    ten="$(basename "${f}")"; ten="${ten#may-}"; ten="${ten%-repo}"
    repo="${DATA}/restic/${ten}"
    [[ -f "${repo}/config" ]] || continue
    export RESTIC_REPOSITORY="${repo}" RESTIC_PASSWORD
    RESTIC_PASSWORD="$(cat "${f}")"
    # Bản có ngày ở tương lai = dấu hiệu giả mạo → không dọn kho này, báo ngay
    if restic snapshots --json 2>/dev/null | python3 -c '
import json, sys, re, datetime
lim = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=1)
def t(v): return datetime.datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", v).replace("Z", "+00:00"))
sys.exit(any(t(s["time"]) > lim for s in json.load(sys.stdin)))'; then
      restic forget --retry-lock 5m --prune "${KEEP_MAY[@]}" || { warn "Không dọn được kho máy ${ten}"; failed=1; }
    else
      warn "Kho máy ${ten} có bản sao lưu mang ngày tương lai — KHÔNG dọn, cần kiểm tra máy này"; failed=1
    fi
  done
  return "${failed}"
}

cmd_sao_luu() {
  # CA trung gian hết hạn thì HTTPS (khi bật) ngừng: gia hạn khi còn < 60 ngày, báo nếu không gia hạn được.
  # Chạy TRƯỚC mọi kiểm tra ổ/kho sao lưu: Box chưa gắn ổ vẫn phải được gia hạn mỗi đêm
  if [[ -s "${CA_DIR}/root.crt" ]]; then
    gia_han_ca >/dev/null || warn "Không gia hạn được CA riêng của Box — xem: sudo onebee-box in-ca"
    [[ "$(ca_con_ngay inter)" -ge 30 ]] || warn "CA trung gian của Box còn dưới 30 ngày hoặc đã hết hạn — chạy bộ cài OneBee Box"
    [[ "$(ca_con_ngay root)" -ge 365 ]] || warn "CA gốc của Box còn dưới 1 năm — lên kế hoạch xoay CA (onebee_box_xoay_ca trong group_vars/all.yml)"
  fi

  require_backup_disk
  box_repo_env
  restic cat config >/dev/null 2>&1 || die "Chưa tạo kho sao lưu Box. Chạy: sudo onebee-box khoi-tao"
  if [[ "${BACKUP_O_NGOAI}" == true ]]; then
    [[ "$(stat -c %d "${BACKUP_MOUNT}")" != "$(stat -c %d "${DATA}")" ]] || warn "Ổ sao lưu cùng ổ với dữ liệu — hỏng ổ là mất cả hai"
  else
    # Kho nằm trên ổ dữ liệu: ổ gần đầy thì dừng, kẻo bản sao lưu làm đầy ổ và CSDL ngừng ghi
    local da_dung
    da_dung="$(phan_tram_da_dung "${DATA}")"
    [[ "${da_dung}" =~ ^[0-9]+$ ]] || die "Không đọc được dung lượng ổ dữ liệu ${DATA}"
    (( da_dung <= NGUONG_O_DAY )) || die "Ổ dữ liệu Box đã dùng ${da_dung}% (trên ${NGUONG_O_DAY}% là dừng) — lần sao lưu này DỪNG để không làm đầy ổ. Dọn bớt thư mục chung hoặc nới ổ rồi chạy lại: sudo onebee-box sao-luu"
  fi

  # Bước 0: kết xuất CSDL dữ liệu cấu trúc TRƯỚC khi tạm dừng (không chạy được lệnh trong container đang tạm dừng);
  # lỗi thì dừng cả lần sao lưu. Thư mục dữ liệu sống của PostgreSQL không được chụp (chụp lúc đang ghi = bản hỏng)
  ket_xuat_csdl || die "Không kết xuất được CSDL (PostgreSQL) — lần sao lưu này DỪNG, chưa chụp gì. Kiểm tra: sudo onebee-box chan-doan"
  # Bước 1: tạm dừng dịch vụ có cơ sở dữ liệu (và kho tệp, để SeaweedFS không ghi dở volume), chụp nhanh phần dữ liệu
  # của chúng (nhất quán), chạy lại ngay. Metadata tệp nằm trong bản kết xuất CSDL; đối tượng nằm trong thư mục SeaweedFS.
  # Sổ phòng ban đi cùng bản chụp CSDL (cùng thời điểm với khóa bí mật: mật khẩu Samba từng phòng)
  install -d -m 0750 -o root -g 1000 "${PHONG_SO}"
  local svcs=(quy-trinh uptime-kuma authelia seaweedfs kho-tep)
  trap 'compose unpause "${svcs[@]}" >/dev/null 2>&1 || true' EXIT
  compose pause "${svcs[@]}" >/dev/null 2>&1 || die "Không tạm dừng được dịch vụ ${svcs[*]}"
  restic backup --retry-lock 5m --tag onebee-box --tag csdl \
    "${DATA}/ai-rag" "${DATA}/knowledge" "${DATA}/node-red" "${DATA}/uptime-kuma" "${DATA}/ho-tro" "${DATA}/authelia" "${DATA}/seaweedfs" "${KET_XUAT_DIR}" "${PHONG_SO}" "${BOX_DIR}" "${SECRETS}"
  compose unpause "${svcs[@]}" >/dev/null 2>&1 || die "Không chạy lại được dịch vụ ${svcs[*]} — kiểm tra: sudo onebee-box trang-thai"
  trap - EXIT
  # Bước 2: thư mục chung (có thể lâu) — dịch vụ vẫn chạy. Không sao lưu model AI (tải lại được)
  # và kho máy trạm (đã là bản sao).
  restic backup --retry-lock 5m --tag onebee-box --tag chung "${SHARE}"
  # Bước 3: mỗi phòng ban một bản chụp riêng (thẻ phong-<mã>) — khôi phục riêng từng phòng được. forget nhóm theo đường dẫn
  # nên mỗi phòng giữ đủ số bản như thư mục chung
  local ma
  local -a phong=()
  mapfile -t phong < <(ds_ma_phong)
  for ma in "${phong[@]}"; do
    if [[ -d "${PHONG_DIR}/${ma}" ]]; then
      restic backup --retry-lock 5m --tag onebee-box --tag "phong-${ma}" "${PHONG_DIR}/${ma}"
    else
      warn "Phòng ${ma} chưa có thư mục ${PHONG_DIR}/${ma} — bỏ qua; dựng lại: sudo onebee-box dong-bo-phong"
    fi
  done
  restic forget --retry-lock 5m --tag onebee-box --prune "${KEEP_BOX[@]}"
  prune_workstations || warn "Có kho máy trạm chưa dọn được (xem các dòng CẢNH BÁO ở trên)"
  echo "Sao lưu xong: $(date '+%d/%m/%Y %H:%M')"
}

cmd_khoi_phuc_thu() {
  local mau="${SHARE}/.onebee-kiem-tra-sao-luu.txt" tmp sum
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp:-}"; trap - RETURN' RETURN
  echo "Kiểm tra khôi phục $(date +%s%N)" >"${mau}"
  sum="$(sha256sum <"${mau}")"
  cmd_sao_luu >/dev/null
  rm -f "${mau}"
  box_repo_env
  restic restore latest --tag onebee-box,chung --target "${tmp}" --include "${mau}" >/dev/null
  [[ "$(sha256sum <"${tmp}${mau}")" == "${sum}" ]] || die "KHÔNG ĐẠT: file khôi phục khác bản gốc"
  echo "ĐẠT: khôi phục đúng file đã xóa từ bản sao lưu"
}

# In "tên=số giờ từ lần sao lưu cuối" (hoặc "tên=null") cho mọi máy trạm đã cấp — Box tự đọc kho sao lưu
gio_sao_luu_may() {
  local ten t
  while read -r ten; do
    t="null"
    if [[ -f "${DATA}/restic/${ten}/config" ]]; then
      t="$(RESTIC_REPOSITORY="${DATA}/restic/${ten}" RESTIC_PASSWORD="$(cat "${SECRETS}/may-${ten}-repo")" \
           restic snapshots --latest 1 --json </dev/null 2>/dev/null | python3 -c '
import json, sys, re, datetime
s = json.load(sys.stdin)
if not s: print("null"); sys.exit()
t = max(datetime.datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", x["time"]).replace("Z", "+00:00")) for x in s)
print(int((datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() // 3600))' || echo loi)"
    fi
    echo "${ten}=${t}"
  done < <(may_da_cap)   # máy đã thu hồi không còn nằm trong báo cáo (kho của máy vẫn giữ, vẫn được dọn bản cũ ở prune_workstations)
}

# ONEBEE_BI_MAT: onebee-may-tram.py kiểm chữ ký báo cáo bằng mật khẩu kho sao lưu của từng máy (động cơ quy trình không giữ khóa)
may_tram_py() { ONEBEE_BI_MAT="${SECRETS}" python3 /usr/local/lib/onebee-box/onebee-may-tram.py "$1" "${DATA}/tinh-trang-may" "${@:2}"; }

# Gửi kết quả sao lưu + tình trạng từng máy trạm (sao lưu, cập nhật, ổ đĩa...) sang động cơ quy trình → email cho quản trị
bao_cao_quy_trinh() {
  local trang_thai="$1" noi_dung="$2" payload hdr
  local -a may=()
  [[ "${trang_thai}" == THU ]] || mapfile -t may < <(gio_sao_luu_may)   # email thử: không cần đọc kho máy trạm
  # Hai con số cho ô "Máy trạm đã sao lưu" trên trang chủ (không có tên máy); email thử thì bỏ qua
  if [[ "${trang_thai}" != THU ]]; then
    { may_tram_py dem "${may[@]}" >/var/lib/onebee-box/may-tram-tong-hop.moi \
        && mv /var/lib/onebee-box/may-tram-tong-hop.moi /var/lib/onebee-box/may-tram-tong-hop; } \
      || warn "Không ghi được tổng hợp máy trạm cho trang chủ"
  fi
  payload="$(mktemp)"; hdr="$(mktemp)"
  trap 'rm -f "${payload}" "${hdr}"; trap - RETURN' RETURN
  may_tram_py payload "${trang_thai}" "${noi_dung}" "${may[@]}" >"${payload}"
  (umask 077; printf 'X-OneBee-Key: %s\n' "$(cat "${SECRETS}/quy-trinh-webhook-key")" >"${hdr}")
  quy_trinh_curl -X POST "$(quy_trinh_goc)/webhook/onebee-bao-cao-sao-luu" -H @"${hdr}" \
    -H 'Content-Type: application/json' --data-binary @"${payload}" >/dev/null
}

# Sao lưu + luôn gửi báo cáo (kể cả khi lỗi) — lịch 23:00 gọi lệnh này
cmd_sao_luu_co_bao_cao() {
  local log st
  log="$(mktemp)"
  set +e
  ( cmd_sao_luu ) 2>&1 | tee "${log}"
  st=${PIPESTATUS[0]}
  set -e
  # Kết quả lần cuối cho ô "Sao lưu" trên trang chủ (onebee-trang-thai-web.py đọc)
  printf '%s %s\n' "$([[ ${st} -eq 0 ]] && echo DAT || echo LOI)" "$(date +%s)" >/var/lib/onebee-box/sao-luu-lan-cuoi \
    || warn "Không ghi được kết quả sao lưu cho trang chủ"
  bao_cao_quy_trinh "$([[ ${st} -eq 0 ]] && echo DAT || echo LOI)" "$(tail -n 12 "${log}")" \
    || warn "Không gửi được báo cáo sao lưu qua động cơ quy trình/email"
  rm -f "${log}"
  return "${st}"
}

# Nhóm của tệp lấy lại từ bản sao lưu: số nhóm pb-<mã> của bản cài lại có thể khác bản cũ (restic giữ số, không giữ tên)
sua_nhom_phong() { chgrp -R -h "pb-$1" "$2"; }

# Lấy bản sao lưu mới nhất của phòng $1 vào thư mục phòng: ${PHONG_DIR}/<mã>/khoi-phuc-<YYYYmmdd-HHMM>/ (không ghi đè tệp đang dùng).
# Người trong phòng mở thư mục đó trên máy trạm, chép lại đúng tệp cần.
cmd_khoi_phuc_phong() {
  local ma="${1:-}" thoi_diem dich tam luc
  co_phong "${ma}" || die "Cách dùng: sudo onebee-box khoi-phuc-phong <mã-phòng-có-trong-sổ> (xem: sudo onebee-box danh-sach-phong)"
  [[ -d "${PHONG_DIR}/${ma}" ]] || die "Phòng ${ma} chưa có thư mục — chạy: sudo onebee-box dong-bo-phong"
  require_backup_disk
  box_repo_env
  restic cat config >/dev/null 2>&1 || die "Chưa tạo kho sao lưu Box. Chạy: sudo onebee-box khoi-tao"
  luc="$(restic snapshots --latest 1 --tag "onebee-box,phong-${ma}" --json | python3 -c '
import datetime, json, re, sys
s = json.load(sys.stdin)
if not s:
    sys.exit(1)
t = max(datetime.datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", x["time"]).replace("Z", "+00:00")) for x in s)
print(t.astimezone().strftime("%d/%m/%Y %H:%M"))')" || die "Chưa có bản sao lưu nào của phòng ${ma} (sao lưu chạy 23:00 hằng ngày; chạy ngay: sudo onebee-box sao-luu)"
  thoi_diem="$(date +%Y%m%d-%H%M)"
  dich="${PHONG_DIR}/${ma}/khoi-phuc-${thoi_diem}"
  [[ ! -e "${dich}" ]] || die "Đã có ${dich} — đợi một phút rồi chạy lại"
  tam="$(mktemp -d "${PHONG_DIR}/.khoi-phuc-tam-XXXXXX")"   # cùng ổ với thư mục phòng: chuyển vào bằng đổi tên
  TAM_DON+=("${tam}")
  restic restore latest --tag "onebee-box,phong-${ma}" --target "${tam}" >/dev/null \
    || die "Khôi phục phòng ${ma} lỗi — thư mục phòng không đổi gì"
  [[ -d "${tam}${PHONG_DIR}/${ma}" ]] || die "Bản sao lưu không có thư mục ${PHONG_DIR}/${ma}"
  mv "${tam}${PHONG_DIR}/${ma}" "${dich}"
  rm -rf "${tam}"
  sua_nhom_phong "${ma}" "${dich}"
  chmod 2770 "${dich}"
  echo "Đã lấy lại thư mục phòng ${ma} theo bản sao lưu lúc ${luc} vào: ${dich}"
  echo "Trên máy trạm của phòng: mở thư mục phòng ban, vào khoi-phuc-${thoi_diem}/ rồi chép lại tệp cần (xong thì xóa thư mục đó cho gọn)."
}

# Bản sao lưu cũ có thể còn khóa Trợ lý AI của máy đã thu hồi sau lần sao lưu đó → thu hồi lại cho chắc
xoa_tai_khoan_may_da_thu_hoi() {
  local f ten
  for f in "${SECRETS}"/thu-hoi/*; do
    [[ -e "${f}" ]] || continue
    ten="$(basename "${f}")"
    hoi_khoa go may "${ten}" >/dev/null 2>&1 || true
  done
}

# Sau khi lấy lại tệp: đổ bản kết xuất vào CSDL của bản cài lại (thay toàn bộ lược đồ onebee), rồi đặt mật khẩu vai trò theo tệp
# bí mật vừa khôi phục (vai trò là của cụm PostgreSQL, không nằm trong bản kết xuất; cụm của bản cài lại mang mật khẩu mới)
khoi_phuc_csdl() {
  local f="${KET_XUAT_DIR}/onebee.dump"
  if [[ ! -s "${f}" ]]; then
    warn "Bản sao lưu không có tệp kết xuất CSDL (${f}; bản sao lưu làm trước khi Box có CSDL?) — CSDL giữ trống, chạy: sudo onebee-box chuyen-du-lieu"
    return 0
  fi
  cho_csdl || die "PostgreSQL không chạy lên sau khôi phục — CSDL CHƯA được khôi phục. Xem: sudo docker logs --tail 50 onebee-postgres; sửa xong chạy lại lệnh này"
  docker exec -i onebee-postgres pg_restore -U postgres -d onebee --clean --if-exists --single-transaction <"${f}" \
    || die "Đổ bản kết xuất ${f} vào CSDL lỗi — CSDL giữ nguyên như trước lệnh này (giao dịch đã hoàn tác). Xem lỗi ở trên; tệp kết xuất còn nguyên"
  dong_bo_mat_khau_csdl >/dev/null || die "Không đặt lại được mật khẩu vai trò CSDL theo tệp bí mật đã khôi phục"
  csdl -c "NOTIFY pgrst, 'reload schema'" >/dev/null || true
  echo "Đã khôi phục CSDL từ bản kết xuất $(date -r "${f}" '+%d/%m/%Y %H:%M')"
}

# Khôi phục toàn bộ Box: chạy trên Box ĐÃ CÀI LẠI (bộ cài OneBee Box), còn kho sao lưu cũ (ổ ngoài đã gắn lại, hoặc
# thư mục sao-luu trong ổ dữ liệu còn nguyên khi chỉ cài lại hệ điều hành).
# $1 = file khóa in từ 'onebee-box in-khoa' (dùng dòng restic-box=…); không đưa file thì hỏi khóa.
cmd_khoi_phuc_toan_bo() {
  local tep="${1:-}" khoa f ten
  require_backup_disk
  if [[ -n "${tep}" ]]; then
    [[ -r "${tep}" ]] || die "Không đọc được file khóa ${tep}"
    khoa="$(grep -m1 '^restic-box=' "${tep}" | cut -d= -f2- | tr -d '\r')"
  else
    read -rsp "Khóa sao lưu Box (dòng restic-box trong bản in 'in-khoa'): " khoa; echo
  fi
  [[ -n "${khoa}" ]] || die "Thiếu khóa restic-box"
  export RESTIC_REPOSITORY="${BACKUP_REPO}" RESTIC_PASSWORD="${khoa}"
  restic cat config >/dev/null 2>&1 || die "Khóa sai, hoặc ổ không có kho sao lưu Box tại ${BACKUP_REPO}"
  restic snapshots --latest 1 --tag onebee-box,csdl --json \
    | python3 -c 'import json, sys; sys.exit(0 if json.load(sys.stdin) else 1)' || die "Kho không có bản sao lưu dữ liệu Box"
  echo "Dừng dịch vụ, khôi phục cơ sở dữ liệu (cả CSDL dữ liệu cấu trúc), khóa bí mật, cấu hình, thư mục chung…"
  compose stop >/dev/null 2>&1 || true
  # Xóa dữ liệu của bản cài mới trước khi chép bản cũ vào (restic không xóa file thừa; file tạm của CSDL mới
  # lẫn với CSDL cũ có thể làm hỏng dữ liệu)
  rm -rf "${DATA}/ai-rag" "${DATA}/knowledge" "${DATA}/node-red" "${DATA}/uptime-kuma" "${DATA}/ho-tro" "${DATA}/authelia" "${DATA}/seaweedfs" "${KET_XUAT_DIR}" "${PHONG_SO}"
  # CA riêng do lần cài lại vừa sinh phải nhường chỗ cho CA cũ (máy trạm đã tin CA cũ): xóa CA mới rồi khôi phục CA cũ từ bản sao lưu
  rm -rf "${CA_DIR}" "${HTTPS_DAU}" "${DATA}/caddy/data/caddy/certificates"   # chứng chỉ lá Caddy đã cấp bằng CA của bản cài lại cũng bỏ   # dấu HTTPS do bản cài lại ghi cũng nhường chỗ cho dấu trong bản sao lưu (nếu có)
  restic restore latest --tag onebee-box,csdl --target / || die "Khôi phục dữ liệu Box lỗi — chưa chạy lại dịch vụ"
  restic restore latest --tag onebee-box,chung --target / || warn "Khôi phục thư mục chung lỗi — thử lại lệnh này"
  # Thư mục từng phòng có trong sổ vừa lấy lại (bản chụp riêng, thẻ phong-<mã>)
  local ma
  local -a phong=()
  mapfile -t phong < <(ds_ma_phong)
  for ma in "${phong[@]}"; do
    restic restore latest --tag "onebee-box,phong-${ma}" --target / \
      || warn "Khôi phục thư mục phòng ${ma} lỗi (phòng tạo sau lần sao lưu cuối?) — thử lại: sudo onebee-box khoi-phuc-phong ${ma}"
  done
  [[ -s "${CA_DIR}/root.crt" ]] || die "Bản sao lưu không có CA riêng của Box (${CA_DIR}) — không khôi phục tiếp, vì mọi máy trạm đang tin CA cũ"
  install -m 0644 "${CA_DIR}/root.crt" /usr/local/share/ca-certificates/onebee-box-ca.crt
  update-ca-certificates --fresh >/dev/null   # Box tin lại CA cũ (bỏ CA mới sinh lúc cài lại)
  # Kho sao lưu máy trạm không nằm trong bản sao lưu Box → cấp lại tài khoản kho bằng mật khẩu cũ
  # (máy trạm dùng cấu hình cũ, tự tạo kho mới ở lần sao lưu sau)
  : >"${DATA}/restic/.htpasswd"
  # Chỉ máy còn được cấp: máy đã thu hồi (có file thu-hoi/<tên>) không được cấp lại quyền vào kho dù bản sao lưu còn mật khẩu cũ
  while read -r ten; do
    [[ -s "${SECRETS}/may-${ten}-http" ]] || continue
    htpasswd -B -i "${DATA}/restic/.htpasswd" "${ten}" <"${SECRETS}/may-${ten}-http" 2>/dev/null
  done < <(may_da_cap)
  nap_lai_kho_http   # rest-server của bản cài lại có thể đang chạy với file cũ
  dong_bo_ten_may >/dev/null   # chỗ nhận báo cáo tình trạng của động cơ quy trình dựng lại từ bí mật vừa khôi phục
  # Phòng ban: nhóm, tài khoản, chia sẻ Samba dựng lại từ sổ; mật khẩu Samba từng phòng là mật khẩu cũ (máy trạm không phải đổi gì)
  dong_bo_phong >/dev/null
  for ma in "${phong[@]}"; do
    [[ ! -d "${PHONG_DIR}/${ma}" ]] || sua_nhom_phong "${ma}" "${PHONG_DIR}/${ma}"
  done
  compose up -d >/dev/null
  khoi_phuc_csdl
  xoa_tai_khoan_may_da_thu_hoi
  echo "Đã khôi phục. Việc tiếp theo: chạy lại bộ cài (sudo ./box/onebee-box-install.sh) để đồng bộ cấu hình, rồi"
  echo "sudo onebee-box khoi-phuc-thu. Máy trạm không cần làm gì (dùng lại cấu hình cũ)."
}

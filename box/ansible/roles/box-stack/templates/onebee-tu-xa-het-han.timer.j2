[Unit]
Description=OneBee Box — chạy tu-xa-ap-dung mỗi 15 phút (lượt duyệt máy công tác hết hạn thì tự thu hồi)

[Timer]
OnCalendar=*:0/15
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target

#!/usr/bin/env bash
# onebee-canh-bao — Gửi cảnh báo sự cố chủ động qua Telegram Bot và động cơ quy trình (Node-RED)
# Cú pháp:
#   onebee-canh-bao INFO "Tiêu đề" "Nội dung"
#   onebee-canh-bao WARN "Tiêu đề" "Nội dung"
#   onebee-canh-bao CRIT "Tiêu đề" "Nội dung"
set -euo pipefail

MUC_DO="${1:-INFO}"
MUC_DO_IN_HOA="$(echo "${MUC_DO}" | tr '[:lower:]' '[:upper:]')"
TIEU_DE="${2:-Thông báo từ OneBee Box}"
NOI_DUNG="${3:-}"
THOI_GIAN="$(date '+%H:%M:%S %d/%m/%Y')"
TEN_DON_VI="{{ onebee_box_ten_don_vi }}"
SECRETS="/etc/onebee-box/secrets"
TELEGRAM_ENV="${SECRETS}/telegram.env"

# Chuẩn hóa mức độ & biểu tượng
ICON="ℹ️"
TEN_MUC="THÔNG BÁO"
case "${MUC_DO_IN_HOA}" in
  WARN|CANH_BAO)
    ICON="⚠️"
    TEN_MUC="CẢNH BÁO"
    ;;
  CRIT|KHAN_CAP|LOI)
    ICON="🚨"
    TEN_MUC="BÁO ĐỘNG KHẨN"
    ;;
  *)
    ICON="ℹ️"
    TEN_MUC="THÔNG BÁO"
    ;;
esac

# 1. Gửi Telegram nếu đã cấu hình
if [[ -f "${TELEGRAM_ENV}" ]]; then
  # shellcheck source=/dev/null
  . "${TELEGRAM_ENV}"
  if [[ -n "${TELEGRAM_BOT_TOKEN:-}" && -n "${TELEGRAM_CHAT_ID:-}" ]]; then
    MSG="${ICON} [${TEN_MUC} — ${TEN_DON_VI}]
*${TIEU_DE}*
Thời gian: ${THOI_GIAN}

${NOI_DUNG}"

    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
      -d "chat_id=${TELEGRAM_CHAT_ID}" \
      -d "text=${MSG}" \
      -d "parse_mode=Markdown" >/dev/null 2>&1 || true
  fi
fi

# 2. Gửi webhook nội bộ tới động cơ quy trình (gửi email cho quản trị, ghi nhật ký).
# Không còn cổng riêng: Caddy trên tên Box là cửa duy nhất; tuyến tự kiểm khóa X-OneBee-Key (chỉ root trên Box đọc được).
TEN_BOX="{{ 'box.' ~ onebee_box_ma_don_vi ~ '.onebee.internal' }}"
WEBHOOK_KEY_FILE="${SECRETS}/quy-trinh-webhook-key"
PAYLOAD="$(MUC_DO="${MUC_DO_IN_HOA}" TIEU_DE="${TIEU_DE}" NOI_DUNG="${NOI_DUNG}" DON_VI="${TEN_DON_VI}" THOI_GIAN="${THOI_GIAN}" \
  python3 -c 'import json, os; print(json.dumps({k: os.environ[v] for k, v in (("muc_do","MUC_DO"),("tieu_de","TIEU_DE"),("noi_dung","NOI_DUNG"),("don_vi","DON_VI"),("thoi_gian","THOI_GIAN"))}, ensure_ascii=False))')"
if [[ -s "${WEBHOOK_KEY_FILE}" ]]; then
  if [[ -f "${SECRETS}/https-da-bat" ]]; then
    GOC="https://${TEN_BOX}"; CA=(--cacert "${SECRETS}/ca/root.crt" --resolve "${TEN_BOX}:443:127.0.0.1")
  else
    GOC="http://127.0.0.1"; CA=()
  fi
  curl -s -m 15 "${CA[@]}" \
    -X POST "${GOC}/webhook/onebee-canh-bao" \
    -H "Content-Type: application/json" -H "X-OneBee-Key: $(cat "${WEBHOOK_KEY_FILE}")" \
    -d "${PAYLOAD}" >/dev/null 2>&1 || true
fi

echo "Đã gửi cảnh báo [${MUC_DO_IN_HOA}]: ${TIEU_DE}"

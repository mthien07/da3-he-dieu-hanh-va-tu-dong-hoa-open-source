[
  {
    "id": "onebeeSmtp000001",
    "name": "OneBee — hộp thư gửi (SMTP)",
    "type": "smtp",
    "data": {
      "user": {{ onebee_box_email.smtp_user | to_json }},
      "password": {{ onebee_smtp_password | to_json }},
      "host": {{ (onebee_box_email.smtp_host or "chua-cau-hinh.invalid") | to_json }},
      "port": {{ onebee_box_email.smtp_port | int }},
      "secure": {{ onebee_box_email.smtp_ssl | bool | to_json }},
      "disableStartTls": {{ (not (onebee_box_email.smtp_starttls | bool)) | to_json }}
    }
  },
  {
    "id": "onebeeHook000001",
    "name": "OneBee — khóa webhook của Box",
    "type": "httpHeaderAuth",
    "data": {"name": "X-OneBee-Key", "value": {{ onebee_webhook_key | to_json }}}
  },
  {
    "id": "onebeeTram000001",
    "name": "OneBee — khóa máy trạm gửi tình trạng",
    "type": "httpHeaderAuth",
    "data": {"name": "X-OneBee-Key", "value": {{ onebee_tram_key | to_json }}}
  },
  {
    "id": "onebeeForm000001",
    "name": "OneBee — tài khoản biểu mẫu nhân viên",
    "type": "httpBasicAuth",
    "data": {"user": "nhanvien", "password": {{ onebee_form_password | to_json }}}
  }
]

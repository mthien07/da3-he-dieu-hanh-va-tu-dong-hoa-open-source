       "formFields": {"values": [
         {"fieldLabel": "Khách hàng", "fieldName": "khach_hang", "fieldType": "text", "requiredField": true},
         {"fieldLabel": "Mặt hàng", "fieldName": "mat_hang", "fieldType": "text", "requiredField": true},

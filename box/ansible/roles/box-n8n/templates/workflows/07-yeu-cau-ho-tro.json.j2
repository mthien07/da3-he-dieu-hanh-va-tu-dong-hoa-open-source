{% set email_tu_nut = 'Tạo yêu cầu' %}{% set email_bo_qua_loi = true %}
{% set js %}
{% include 'workflows/_csv-js.j2' %}
// Nhân viên báo cần hỗ trợ → ghi ho-tro/yeu-cau.csv + email cho kỹ thuật
const j = $input.first().json;
// n8n không tự kiểm giá trị ô chọn → chỉ nhận đúng nhãn có sẵn (báo cáo tuần đếm theo nhãn)
if (!{{ onebee_ho_tro_loai | to_json }}.includes(j.loai)) throw new Error('Loại sự cố không hợp lệ');
if (!['Bình thường', 'Gấp (đang dừng việc)'].includes(j.muc_do)) throw new Error('Mức độ không hợp lệ');
const ma = $now.toFormat('yyMMdd-HHmmss') + '-' + String(Math.floor(Math.random() * 90) + 10);
const gap = String(j.muc_do || '').startsWith('Gấp');
const line = dongCsv([ma, $now.toFormat('yyyy-MM-dd HH:mm'), j.may, j.loai, gap ? 'gap' : 'binh-thuong', j.nguoi_bao, j.mo_ta]);
// Tiêu đề email một dòng: safe() đã đổi mọi ký tự điều khiển (\r \n) thành dấu cách → không chèn được tiêu đề thư khác
const subject = `[OneBee] ${gap ? 'GẤP — ' : ''}Yêu cầu hỗ trợ ${ma}: ${safe(j.loai)}`;
const text = [`Mã: ${ma}`, `Máy: ${safe(j.may) || '(không ghi)'}`, `Người báo: ${safe(j.nguoi_bao) || '(không ghi)'}`,
  `Loại: ${safe(j.loai)} · Mức độ: ${safe(j.muc_do)}`, '', safe(j.mo_ta), '',
  'Xử lý xong: mở biểu mẫu "Xử lý yêu cầu hỗ trợ" trên Box ({{ 'https' if onebee_https_hieu_luc | bool else 'http' }}://{{ onebee_box_ip }}:{{ onebee_box_ports.n8n }}/form/onebee-xu-ly), nhập mã trên.'].join('\n');
return [{ json: { ma, subject, text }, binary: tep(line, 'yeu-cau.csv') }];
{% endset %}

// Ghi CSV an toàn: mọi ký tự điều khiển (xuống dòng \r \n, tab…) thành dấu cách rồi cắt khoảng trắng đầu/cuối;
// chữ bắt đầu bằng = + - @ bị Calc/Excel hiểu là công thức → thêm dấu ' phía trước
const safe = v => { const t = String(v ?? '').replace(/[\u0000-\u001f\u007f]+/g, ' ').trim(); return /^[=+\-@]/.test(t) ? "'" + t : t; };
const esc = v => '"' + safe(v).replace(/"/g, '""') + '"';
const dongCsv = cot => cot.map(esc).join(',') + '\n';
const tep = (line, ten) => ({ data: { data: Buffer.from(line, 'utf8').toString('base64'), mimeType: 'text/csv', fileName: ten } });

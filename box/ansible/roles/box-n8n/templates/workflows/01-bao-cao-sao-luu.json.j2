{% set js %}
// Box gửi: trang_thai ("DAT"/"LOI"/"THU"), noi_dung, may_tram: [{ten, gio_tu_lan_cuoi, canh_bao: [...], tom_tat}]
// (cảnh báo từng máy do Box tính sẵn: sao lưu, cập nhật, ổ đĩa, khởi động lại, mất liên lạc)
const b = $input.first().json.body || {};
if (b.trang_thai === 'THU') return [{ json: { subject: '[OneBee Box] Email thử — cấu hình email đã dùng được', text: b.noi_dung || '' } }];
const ok = b.trang_thai === 'DAT';
const may = Array.isArray(b.may_tram) ? b.may_tram : [];
const canXuLy = may.filter(m => Array.isArray(m.canh_bao) && m.canh_bao.length);
const dong = may.map(m => {
  const cb = Array.isArray(m.canh_bao) ? m.canh_bao : [];
  return `- ${m.ten}: ${cb.length ? 'CẦN XỬ LÝ — ' + cb.join('; ') : 'ổn'}${m.tom_tat ? ' (' + m.tom_tat + ')' : ''}`;
});
let subject = `[OneBee Box] Sao lưu ${ok ? 'ĐẠT' : 'LỖI'}`;
if (canXuLy.length) subject += ` — ${canXuLy.length} máy trạm cần xử lý`;
const text = [
  ok ? 'Sao lưu OneBee Box ra ổ ngoài: ĐẠT.' : 'Sao lưu OneBee Box: LỖI — cần kiểm tra ngay (sudo onebee-box trang-thai).',
  '', b.noi_dung || '', '',
  may.length ? 'Tình trạng máy trạm:' : 'Chưa cấp máy trạm nào (sudo onebee-box them-may <tên-máy>).', ...dong,
  canXuLy.length ? '\nXem chi tiết: sudo onebee-box may-tram · cập nhật tất cả: sudo onebee-box cap-nhat-may --tat-ca' : '',
].join('\n');
return [{ json: { subject, text } }];
{% endset %}
{
  "id": "onebeeBaoCaoSL01",
  "name": "OneBee — Báo cáo sao lưu (email)",
  "nodes": [
    {"id": "sl-1", "name": "Box gửi kết quả sao lưu", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1,
     "position": [0, 0], "webhookId": "0e7c1b2a-0000-4000-8000-000000000001",
     "parameters": {"httpMethod": "POST", "path": "onebee-bao-cao-sao-luu", "authentication": "headerAuth", "options": {}},
     "credentials": {"httpHeaderAuth": {"id": "onebeeHook000001", "name": "OneBee — khóa webhook của Box"}}},
    {"id": "sl-2", "name": "Soạn báo cáo", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [240, 0],
     "parameters": {"jsCode": {{ js | to_json }}}},
    {% include 'workflows/_gui-email.json.j2' %}
  ],
  "connections": {
    "Box gửi kết quả sao lưu": {"main": [[{"node": "Soạn báo cáo", "type": "main", "index": 0}]]},
    "Soạn báo cáo": {"main": [[{"node": "Gửi email", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1", "timezone": "{{ onebee_timezone }}"}
}

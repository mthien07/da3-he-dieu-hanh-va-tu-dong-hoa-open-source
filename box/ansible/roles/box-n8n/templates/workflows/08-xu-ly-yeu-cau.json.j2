{% set js %}
{% include 'workflows/_csv-js.j2' %}
// Kỹ thuật ghi kết quả xử lý 1 yêu cầu → ho-tro/xu-ly.csv (dùng cho báo cáo tuần: thời gian xử lý, cách xử lý)
const j = $input.first().json;
const ma = String(j.ma || '').trim();
if (!/^\d{6}-\d{6}-\d{2}$/.test(ma)) throw new Error('Mã yêu cầu không đúng dạng (ví dụ 260930-143012-47)');
const phut = Number(j.so_phut);
if (!Number.isFinite(phut) || phut < 0 || phut > 10000) throw new Error('Số phút xử lý không hợp lệ');
const line = dongCsv([ma, $now.toFormat('yyyy-MM-dd HH:mm'), j.cach_xu_ly, Math.round(phut), j.ghi_chu]);
return [{ json: { ma }, binary: tep(line, 'xu-ly.csv') }];
{% endset %}

  {
    "id": "onebeePheDuyet01",
    "type": "http in",
    "z": "tab_onebee_dxos",
    "name": "11 - Phê duyệt quản lý (Poka-yoke)",
    "url": "/webhook/onebee-phe-duyet",
    "method": "post",
    "upload": false,
    "x": 170,
    "y": 720,
    "wires": [["fn_11_phe_duyet"]]
  },
  {
    "id": "fn_11_phe_duyet",
    "type": "function",
    "z": "tab_onebee_dxos",
    "name": "Kiểm quyền quan_ly, chặn tự duyệt (Poka-yoke) & bắt buộc lý do từ chối",
    "func": "const nguoiDuyet = String(msg.req.headers['remote-user'] || '').trim();\nconst nhom = String(msg.req.headers['remote-groups'] || '').split(',').map(s => s.trim());\nif (!nguoiDuyet || !nhom.includes('quan_ly')) {\n  msg.statusCode = 403;\n  msg.payload = { loi: 'Chỉ tài khoản thuộc nhóm quan_ly mới được phê duyệt' };\n  return msg;\n}\nconst b = msg.payload || {};\nconst nguoiTao = String(b.nguoi_tao || '').trim();\nconst quyetDinh = String(b.trang_thai_duyet || '').trim();\nconst lyDo = String(b.ly_do_duyet || '').trim();\nif (!['DA_DUYET', 'TU_CHOI'].includes(quyetDinh)) {\n  msg.statusCode = 400;\n  msg.payload = { loi: 'Trạng thái duyệt chỉ nhận DA_DUYET hoặc TU_CHOI' };\n  return msg;\n}\nif (nguoiTao && nguoiDuyet === nguoiTao) {\n  msg.statusCode = 409;\n  msg.payload = { loi: 'Chốt chặn Poka-yoke: Người tạo không được tự phê duyệt đơn của chính mình' };\n  return msg;\n}\nif (quyetDinh === 'TU_CHOI' && !lyDo) {\n  msg.statusCode = 422;\n  msg.payload = { loi: 'Từ chối phê duyệt bắt buộc phải ghi rõ lý do' };\n  return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = {\n  ok: true,\n  loai_ho_so: b.loai_ho_so || 'don_hang',\n  ma: b.ma || b.ma_don || '',\n  trang_thai_duyet: quyetDinh,\n  nguoi_duyet: nguoiDuyet,\n  ly_do_duyet: lyDo,\n  thoi_gian_duyet: new Date().toISOString()\n};\nreturn msg;",
    "outputs": 1,
    "x": 490,
    "y": 720,
    "wires": [["http_out_chung"]]
  },

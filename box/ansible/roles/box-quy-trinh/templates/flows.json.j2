  {
    "id": "fn_06_tinh_trang_may",
    "type": "function",
    "z": "tab_onebee_dxos",
    "name": "Kiểm khóa chung & danh sách may-da-cap",
    "attr_authentication": "{{ 'headerAuth' if (onebee_box_khoa_tinh_trang_chung | bool) else 'none' }}",
    "attr_file_selector": "/data/may-da-cap",
    "func": {{ ("const doiKhoa = " ~ ((onebee_box_khoa_tinh_trang_chung | bool) | to_json) ~ ";\nconst khoaTram = " ~ (onebee_tram_key | to_json) ~ ";\nif (doiKhoa && msg.req.headers['x-onebee-key'] !== khoaTram) {\n  msg.statusCode = 403;\n  msg.payload = { loi: 'Thiếu hoặc sai X-OneBee-Key' };\n  return msg;\n}\nconst b = msg.payload || {};\nconst ten = String(b.ten || '').trim();\nif (!/^[a-z0-9][a-z0-9-]{0,31}$/.test(ten)) {\n  msg.statusCode = 400;\n  msg.payload = { loi: 'Tên máy trạm không hợp lệ' };\n  return msg;\n}\nmsg.ten_may_da_cap = '/data/may-da-cap/' + ten;\nmsg.tep_tinh_trang = '/data/tinh-trang-may/' + ten + '.json';\nmsg.statusCode = 200;\nmsg.payload = { ok: true, ten: ten };\nreturn msg;") | to_json }},
    "outputs": 1,
    "x": 450,
    "y": 420,
    "wires": [["http_out_chung"]]
  },

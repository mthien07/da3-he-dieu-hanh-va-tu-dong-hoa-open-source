  {
    "id": "fn_01_bao_cao_sao_luu",
    "type": "function",
    "z": "tab_onebee_dxos",
    "name": "Kiểm khóa & soạn email sao lưu",
    "func": {{ ("const khoa = " ~ (onebee_webhook_key | to_json) ~ ";\nif (msg.req.headers['x-onebee-key'] !== khoa) {\n  msg.statusCode = 403;\n  msg.payload = { loi: 'Sai khóa webhook' };\n  return [msg, null];\n}\nconst b = msg.payload || {};\nmsg.topic = `[OneBee Box] Sao lưu: ${b.trang_thai || 'THÔNG BÁO'}`;\nmsg.payload = { ok: true, da_nhan: b.trang_thai || 'THU' };\nreturn [msg, msg];") | to_json }},
    "outputs": 2,
    "x": 410,
    "y": 120,
    "wires": [["http_out_chung"], []]
  },

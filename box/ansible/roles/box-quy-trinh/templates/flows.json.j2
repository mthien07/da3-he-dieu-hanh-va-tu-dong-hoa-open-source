    "name": "Chuyển tiếp tới dịch vụ AI nội bộ",
    "func": {{ ("const nd = String((msg.payload && msg.payload.noi_dung) || '').trim();\nif (!nd) {\n  msg.statusCode = 400;\n  msg.payload = { loi: 'Thiếu nội dung cần tóm tắt' };\n  return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = { ok: true, model: " ~ (onebee_box_ai_model | to_json) ~ ", do_dai: nd.length };\nreturn msg;") | to_json }},

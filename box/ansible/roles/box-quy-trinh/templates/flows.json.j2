    "type": "function",
    "z": "tab_onebee_dxos",
    "name": "Làm sạch CSV & ghi trạng thái CHO_DUYET",
    "func": {{ (csv_js ~ "\nconst b = msg.payload || {};\nconst ma = safe(b.ma_don || ('DH-' + Date.now()));\nconst nguoiTao = safe(msg.req.headers['remote-user'] || b.nguoi_tao || 'nhan_vien');\nconst dong = dongCsv([ma, new Date().toISOString().slice(0, 16).replace('T', ' '), b.khach_hang || '', b.mat_hang || '', b.so_luong || 1, b.don_gia || 0, b.ghi_chu || '', 'CHO_DUYET']);\nmsg.statusCode = 201;\nmsg.payload = { ok: true, ma_don: ma, nguoi_tao: nguoiTao, trang_thai_duyet: 'CHO_DUYET', csv_dong: dong };\nreturn msg;") | to_json }},
    "outputs": 1,
    "x": 450,
    "y": 300,
    "wires": [["http_out_chung"]]
  },

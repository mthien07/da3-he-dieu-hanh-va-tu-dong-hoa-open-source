    "name": "Xác thực token cảnh báo & gửi email",
    "func": {{ ("const token = " ~ (onebee_webhook_key | to_json) ~ ";\nconst hdr = msg.req.headers['x-onebee-box-token'] || msg.req.headers['x-onebee-key'] || '';\nif (token && hdr && hdr !== token) {\n  msg.statusCode = 403;\n  msg.payload = { loi: 'Sai khóa cảnh báo' };\n  return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = { ok: true, da_nhan: (msg.payload && msg.payload.muc_do) || 'INFO' };\nreturn msg;") | to_json }},
    "outputs": 1,
    "x": 440,
    "y": 660,

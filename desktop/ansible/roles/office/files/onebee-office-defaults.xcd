<?xml version="1.0" encoding="UTF-8"?>
<!-- OneBee OS: LibreOffice lưu mặc định theo định dạng Microsoft Office để trao đổi file với cơ quan, đối tác -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <!-- Phải nạp SAU writer/calc/impress.xcd, nếu không giá trị mặc định của chúng sẽ đè lên -->
  <dependency file="main"/>
  <dependency file="writer"/>
  <dependency file="calc"/>
  <dependency file="impress"/>
  <oor:component-data oor:name="Setup" oor:package="org.openoffice">
    <node oor:name="Office">
      <node oor:name="Factories">
        <node oor:name="com.sun.star.text.TextDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse">
            <value>MS Word 2007 XML</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse">
            <value>Calc MS Excel 2007 XML</value>
          </prop>
        </node>
        <node oor:name="com.sun.star.presentation.PresentationDocument">
          <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse">
            <value>Impress MS PowerPoint 2007 XML</value>
          </prop>
        </node>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <!-- Bảng thay font: Cambria → Noto Serif. LibreOffice tự thay Cambria bằng Caladea (bảng nội bộ),
         nhưng Caladea thiếu chữ tiếng Việt → chữ có dấu bị lẫn font. Xem fonts/29-onebee-cambria-tieng-viet.conf -->
    <node oor:name="Font">
      <node oor:name="Substitution">
        <prop oor:name="Replacement" oor:op="fuse">
          <value>true</value>
        </prop>
        <node oor:name="FontPairs">
          <node oor:name="onebee-cambria" oor:op="replace">
            <prop oor:name="Always"><value>true</value></prop>
            <prop oor:name="OnScreenOnly"><value>false</value></prop>
            <prop oor:name="ReplaceFont"><value>Cambria</value></prop>
            <prop oor:name="SubstituteFont"><value>Noto Serif</value></prop>
          </node>
        </node>
      </node>
    </node>
    <node oor:name="Save">
      <node oor:name="Document">
        <prop oor:name="WarnAlienFormat" oor:op="fuse">
          <value>false</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>

<?xml version="1.0" encoding="UTF-8"?>
<!-- OneBee OS: LibreOffice mở mặc định với thanh công cụ dạng tab (Tabbed Notebookbar) giống Ribbon của Microsoft Office.
     Người dùng vẫn đổi lại được ở Xem → Giao diện người dùng. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <!-- Phải nạp SAU main/writer/calc/impress.xcd, nếu không giá trị mặc định "Default" của chúng sẽ đè lên -->
  <dependency file="main"/>
  <dependency file="writer"/>
  <dependency file="calc"/>
  <dependency file="impress"/>
  <oor:component-data oor:name="ToolbarMode" oor:package="org.openoffice.Office.UI">
    <node oor:name="Applications">
      <node oor:name="Writer" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse">
          <value>Tabbed</value>
        </prop>
      </node>
      <node oor:name="Calc" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse">
          <value>Tabbed</value>
        </prop>
      </node>
      <node oor:name="Impress" oor:op="fuse">
        <prop oor:name="Active" oor:op="fuse">
          <value>Tabbed</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>

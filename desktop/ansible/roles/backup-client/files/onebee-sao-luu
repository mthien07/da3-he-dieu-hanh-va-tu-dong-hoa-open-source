#!/usr/bin/env bash
# onebee-sao-luu — sao lưu thư mục /home của máy trạm lên OneBee Box (restic, mã hóa).
# Cấu hình: /etc/onebee/may-tram.env (RESTIC_REPOSITORY, RESTIC_PASSWORD) lấy từ lệnh 'onebee-box them-may' trên Box.
# Kho trên Box ở chế độ chỉ-thêm: máy trạm không xóa được bản cũ (Box tự dọn).
set -euo pipefail
CONF=/etc/onebee/may-tram.env
[[ ${EUID} -eq 0 ]] || { echo "Hãy chạy bằng quyền quản trị: sudo $0" >&2; exit 1; }
[[ -r ${CONF} ]] || { echo "Chưa cấu hình sao lưu (${CONF})" >&2; exit 1; }
# Chỉ nạp 2 dòng RESTIC_ — đọc từng dòng KHÓA=giá trị, KHÔNG chạy file như mã shell (rà soát bảo mật F7: dòng lạ trong file không thành lệnh).
# File còn các dòng khác, có thể có ký tự xuống dòng kiểu Windows khi dán.
CA=/usr/local/share/ca-certificates/onebee-box-ca.crt
# "|| [[ -n ... ]]": không bỏ mất dòng cuối khi file không kết thúc bằng xuống dòng; tách tại dấu = ĐẦU TIÊN (giá trị có thể chứa =)
while IFS= read -r dong || [[ -n "${dong}" ]]; do
  dong="${dong%$'\r'}"; khoa="${dong%%=*}"; gia_tri="${dong#*=}"; [[ "${dong}" == *=* ]] || continue
  gia_tri="${gia_tri#\"}"; gia_tri="${gia_tri%\"}"
  case "${khoa}" in RESTIC_REPOSITORY | RESTIC_PASSWORD) export "${khoa}=${gia_tri}" ;; *) ;; esac
done <"${CONF}"
[[ -n "${RESTIC_REPOSITORY:-}" && -n "${RESTIC_PASSWORD:-}" ]] || { echo "Thiếu RESTIC_REPOSITORY hoặc RESTIC_PASSWORD trong ${CONF}" >&2; exit 1; }
case "${RESTIC_REPOSITORY}" in
  rest:https://*)
    # Kho qua HTTPS: chỉ tin CA riêng của OneBee Box (không tin CA công cộng)
    [[ -s ${CA} ]] || { echo "Chưa có chứng chỉ CA của OneBee Box (${CA}) — báo quản trị chạy: sudo onebee-box dong-bo-may <tên-máy>" >&2; exit 1; }
    export RESTIC_CACERT="${CA}" ;;
  rest:http://*)
    [[ ! -e /var/lib/onebee/https-bat ]] || { echo "Máy đã bật HTTPS nhưng cấu hình kho còn http:// — không sao lưu. Báo quản trị chạy: sudo onebee-box dong-bo-may <tên-máy>" >&2; exit 1; } ;;
  *) ;;
esac
restic cat config >/dev/null 2>&1 || restic init
restic backup --tag onebee-may-tram --exclude-caches \
  --exclude '/home/*/.cache' --exclude '/home/*/.local/share/Trash' /home
mkdir -p /var/lib/onebee && date +%s >/var/lib/onebee/sao-luu-cuoi   # máy trạm báo về Box (onebee-bao-tinh-trang)
echo "Sao lưu xong: $(date '+%d/%m/%Y %H:%M')"

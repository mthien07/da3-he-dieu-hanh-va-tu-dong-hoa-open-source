#!/usr/bin/env bash
# onebee-sao-luu — sao lưu thư mục /home của máy trạm lên OneBee Box (restic, mã hóa).
# Cấu hình: /etc/onebee/may-tram.env (RESTIC_REPOSITORY, RESTIC_PASSWORD) lấy từ lệnh 'onebee-box them-may' trên Box.
# Kho trên Box ở chế độ chỉ-thêm: máy trạm không xóa được bản cũ (Box tự dọn).
set -euo pipefail
CONF=/etc/onebee/may-tram.env
[[ ${EUID} -eq 0 ]] || { echo "Hãy chạy bằng quyền quản trị: sudo $0" >&2; exit 1; }
[[ -r ${CONF} ]] || { echo "Chưa cấu hình sao lưu (${CONF})" >&2; exit 1; }
set -a
# shellcheck disable=SC1090
. "${CONF}"
set +a
restic cat config >/dev/null 2>&1 || restic init
restic backup --tag onebee-may-tram --exclude-caches \
  --exclude '/home/*/.cache' --exclude '/home/*/.local/share/Trash' /home
echo "Sao lưu xong: $(date '+%d/%m/%Y %H:%M')"

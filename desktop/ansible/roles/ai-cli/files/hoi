"""hoi — hỏi Trợ lý OneBee (AI chạy trên OneBee Box trong mạng nội bộ) ngay từ cửa sổ dòng lệnh.

Cách dùng:
  hoi cách xuất file PDF
  hoi "tóm tắt đoạn này" < van-ban.txt      (nội dung đưa vào qua dấu < được gửi kèm câu hỏi)
  hoi --tom-tat < van-ban.txt               (gọi đường tóm tắt của Trợ lý)
  hoi --dan-khoa                            dán khóa API do quản trị OneBee cấp (không hiện khi dán)
  hoi --dang-xuat                           xóa khóa của bạn khỏi máy này

Mỗi nhân viên dùng khóa riêng của MÌNH (quản trị cấp bằng lệnh trên Box: sudo onebee-box them-nguoi <tên> <nhóm>).
Khóa lưu ở ~/.config/onebee/hoi-khoa (chỉ bạn đọc). Cấu hình địa chỉ: /etc/onebee-hoi.conf (bộ cài OneBee OS tạo).
Trợ lý chỉ chạy qua HTTPS trên tên Box; máy trạm ghim CA riêng của OneBee, không tin CA công cộng. Câu hỏi không gửi ra Internet.
"""
import getpass
import json
import os
import select
import ssl
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request

CA_ONEBEE = "/usr/local/share/ca-certificates/onebee-box-ca.crt"
HTTPS_BAT = "/var/lib/onebee/https-bat"   # dấu bền: Box đã báo bật HTTPS cho máy này (chỉ cờ BOX_HTTPS=0 do Box đẩy mới xóa)


class KhongTuChuyenHuong(urllib.request.HTTPRedirectHandler):
    """urllib tự theo 301/308 của GET; sang https:// nó dùng kho CA của hệ điều hành (CA công cộng), bỏ qua ghim CA OneBee.
    Tắt hẳn: mọi chuyển hướng thành HTTPError để mo() tự quyết (chỉ https:// cùng máy chủ, vẫn chỉ tin CA OneBee)."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def mo(req, timeout):
    """urlopen có ghim CA: https:// chỉ tin CA riêng của OneBee Box (không tin CA công cộng); http:// bị từ chối khi máy đã bật HTTPS
    (kẻ chen giữa mạng LAN không hạ cấp được kết nối về HTTP để đọc mật khẩu/khóa)."""
    ngu_canh = None
    scheme = urllib.parse.urlsplit(req.full_url).scheme   # urlsplit hạ chữ thường: 'HTTPS://' cũng là https, cũng phải ghim CA
    if scheme == "https":
        try:
            ngu_canh = ssl.create_default_context(cafile=CA_ONEBEE)
        except (OSError, ssl.SSLError):
            sys.exit("Máy chưa có chứng chỉ CA của OneBee Box. Báo người quản trị chạy: sudo onebee-box dong-bo-may <tên-máy>")
    elif os.path.exists(HTTPS_BAT):
        sys.exit("Máy này đã bật HTTPS nhưng cấu hình còn địa chỉ http:// — KHÔNG gửi. Báo người quản trị chạy: sudo onebee-box dong-bo-may <tên-máy>")
    try:
        return urllib.request.build_opener(KhongTuChuyenHuong, urllib.request.HTTPSHandler(context=ngu_canh)).open(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        # Box đã chuyển sang HTTPS (308) mà cấu hình máy còn http:// (máy tắt lúc chuyển): theo ĐÚNG MỘT lần, chỉ tới https:// CÙNG máy chủ,
        # vẫn chỉ tin CA OneBee — nhờ vậy máy không mất liên lạc tới khi quản trị chạy dong-bo-may. Địa chỉ khác máy chủ thì không theo.
        dich = e.headers.get("Location", "") if e.code in (301, 308) else ""
        goc, moi = urllib.parse.urlsplit(req.full_url), urllib.parse.urlsplit(dich)
        if scheme == "http" and moi.scheme == "https" and moi.hostname and moi.hostname == goc.hostname:
            return mo(urllib.request.Request(moi.geturl(), data=req.data, headers=dict(req.header_items()), method=req.get_method()), timeout)
        raise


def loi_mang(e):
    """Thông báo cho lỗi kết nối/HTTP chung. None nếu không phải loại này. Lỗi chứng chỉ được nêu riêng: đó có thể là dấu hiệu bị tấn công."""
    if isinstance(e, urllib.error.HTTPError):
        if e.code in (502, 503, 504):
            return "Dịch vụ trên OneBee Box chưa chạy hoặc đang khởi động. Thử lại sau vài phút; vẫn lỗi thì báo người quản trị."
        if e.code in (301, 308):
            return "Cấu hình địa chỉ OneBee Box đã cũ (Box chuyển sang HTTPS). Báo người quản trị chạy: sudo onebee-box dong-bo-may <tên-máy>"
        return None
    if isinstance(e, urllib.error.URLError) and isinstance(getattr(e, "reason", None), ssl.SSLError):
        return ("CHỨNG CHỈ CỦA ONEBEE BOX KHÔNG HỢP LỆ — dừng lại, đừng nhập mật khẩu ở bất cứ đâu. "
                "Có thể có thiết bị lạ giả danh Box: báo người quản trị ngay.")
    return None

CONF = "/etc/onebee-hoi.conf"
NOTE = "(Trợ lý AI có thể sai — kiểm tra lại số liệu, thông tin quan trọng.)"


KHOA_NV = os.path.join(os.environ.get("HOME") or os.path.expanduser("~"), ".config", "onebee", "hoi-khoa")


def read_conf():
    """Cấu hình chung của máy: địa chỉ (bắt buộc) và khóa của MÁY (chỉ có ở giai đoạn chuyển tiếp)."""
    conf = {}
    try:
        with open(CONF, encoding="utf-8") as f:
            for line in f:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.strip().split("=", 1)
                    conf[k] = v
    except OSError:
        sys.exit(f"Chưa cấu hình Trợ lý AI ({CONF}). Báo người quản trị OneBee.")
    if not conf.get("HOI_URL"):
        sys.exit(f"Thiếu HOI_URL trong {CONF}. Báo người quản trị OneBee.")
    return conf


def doc_khoa_nguoi_dung():
    try:
        with open(KHOA_NV, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def luu_khoa(khoa):
    os.makedirs(os.path.dirname(KHOA_NV), mode=0o700, exist_ok=True)
    fd = os.open(KHOA_NV, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(khoa + "\n")
    os.chmod(KHOA_NV, 0o600)   # file có sẵn từ trước với quyền rộng hơn cũng được siết lại


def goi_api(conf, duong_dan, khoa=None, noi_dung=None, timeout=300):
    """Gọi dịch vụ Trợ lý AI qua mo() (ghim CA). Trả về (mã, dữ liệu JSON hoặc None); lỗi mạng/chứng chỉ thì thoát với thông báo rõ."""
    tieu_de = {"Content-Type": "application/json"}
    if khoa:
        tieu_de["X-OneBee-Khoa"] = khoa
    req = urllib.request.Request(conf["HOI_URL"].rstrip("/") + duong_dan, method="POST", headers=tieu_de,
                                 data=json.dumps(noi_dung, ensure_ascii=False).encode("utf-8") if noi_dung is not None else None)
    try:
        with mo(req, timeout) as r:
            raw = r.read()
            return r.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as e:
        if loi_mang(e):
            sys.exit(loi_mang(e))
        return e.code, None
    except urllib.error.URLError as e:
        sys.exit(loi_mang(e) or "Không kết nối được OneBee Box. Kiểm tra mạng nội bộ hoặc báo người quản trị.")
    except (TimeoutError, OSError, ValueError):
        sys.exit("Không kết nối được OneBee Box hoặc Box trả dữ liệu không đọc được. Báo người quản trị.")


def yeu_cau_https(conf):
    if not conf["HOI_URL"].startswith("https://"):
        sys.exit("Địa chỉ Trợ lý AI phải là https:// — địa chỉ còn http:// thì khóa và câu hỏi đi qua mạng dạng rõ. "
                 "Báo người quản trị bật HTTPS cho OneBee Box và chạy: sudo onebee-box dong-bo-may <tên-máy>")


def dan_khoa(conf):
    """Dán khóa do quản trị cấp; kiểm khóa chạy được rồi mới lưu. Gửi câu hỏi rỗng: dịch vụ xác thực xong mới trả 400."""
    yeu_cau_https(conf)
    try:
        khoa = getpass.getpass("Dán khóa Trợ lý AI (bắt đầu bằng obk-, không hiện khi dán): ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit("\nĐã hủy.")
    if not khoa:
        sys.exit("Chưa nhập khóa.")
    ma, _ = goi_api(conf, "/ai/hoi", khoa, {"cau_hoi": ""})
    if ma in (400, 413):   # 400 "Thiếu câu hỏi" = khóa hợp lệ, xác thực đã qua
        luu_khoa(khoa)
        print(f"Khóa hợp lệ, đã lưu ở {KHOA_NV}. Từ giờ chỉ cần: hoi <câu hỏi>")
        return 0
    if ma in (401, 403):
        sys.exit("Khóa không dùng được (sai khóa, hoặc đã bị thu hồi) — chưa lưu gì.")
    sys.exit(f"OneBee Box báo lỗi {ma} khi kiểm khóa — chưa lưu gì. Báo người quản trị OneBee.")


def dang_xuat():
    try:
        os.unlink(KHOA_NV)
        print("Đã xóa khóa của bạn khỏi máy này.")
    except FileNotFoundError:
        print("Máy này chưa lưu khóa của bạn.")
    return 0


HUONG_DAN_KHOA = ("Bạn chưa có khóa Trợ lý AI trên máy này. Nhờ quản trị OneBee cấp bằng lệnh trên Box:\n"
                  "  sudo onebee-box them-nguoi <tên> <nhóm>   (tài khoản mới, in khóa MỘT lần)\n"
                  "  sudo onebee-box cap-khoa-hoi <tên>        (người đã có tài khoản, cấp lại khóa)\n"
                  "Rồi trên máy này chạy: hoi --dan-khoa  và dán khóa vào.")


def chon_khoa(conf):
    """Khóa của nhân viên trước; chưa có thì dùng khóa của MÁY (giai đoạn chuyển tiếp) kèm nhắc; không có gì thì hướng dẫn."""
    khoa = doc_khoa_nguoi_dung()
    if khoa:
        return khoa
    if conf.get("HOI_API_KEY"):
        print("(Đang dùng khóa chung của máy. Hãy chạy 'hoi --dan-khoa' để dùng khóa riêng của bạn.)", file=sys.stderr)
        return conf["HOI_API_KEY"]
    sys.exit(HUONG_DAN_KHOA)


def read_piped_input():
    """Đọc nội dung đưa vào qua dấu < hoặc | . Không chờ mãi khi chạy từ script/ssh mà không có gì đưa vào."""
    if sys.stdin is None or sys.stdin.isatty():
        return ""
    mode = os.fstat(sys.stdin.fileno()).st_mode
    if stat.S_ISREG(mode):
        return sys.stdin.read().strip()
    if stat.S_ISFIFO(mode) and select.select([sys.stdin], [], [], 2.0)[0]:
        return sys.stdin.read().strip()
    return ""


def in_tra_loi(du_lieu):
    tra_loi = (du_lieu or {}).get("tra_loi")
    if not isinstance(tra_loi, str) or not tra_loi.strip():
        sys.exit("OneBee Box trả về dữ liệu không đọc được. Báo người quản trị.")
    print(tra_loi.strip())
    nguon = [x for x in (du_lieu.get("nguon") or []) if isinstance(x, dict) and x.get("tieu_de")]
    if nguon:
        print("\nNguồn tham khảo:", file=sys.stderr)
        for i, x in enumerate(nguon, 1):
            print(f"  [{i}] {x.get('tieu_de')} ({x.get('nguon')})", file=sys.stderr)
    print(f"\n{NOTE}", file=sys.stderr)


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("--dan-khoa", "--dang-xuat"):
        if sys.argv[1] == "--dang-xuat":
            return dang_xuat()
        return dan_khoa(read_conf())
    che_do_tom_tat = len(sys.argv) >= 2 and sys.argv[1] == "--tom-tat"
    question = " ".join(sys.argv[2:] if che_do_tom_tat else sys.argv[1:]).strip()
    extra = read_piped_input()
    if extra:
        question = f"{question}\n\n{extra}" if question else extra
    if not question or question in ("-h", "--help"):
        print(__doc__)
        return 0 if question else 1
    conf = read_conf()
    yeu_cau_https(conf)
    khoa = chon_khoa(conf)
    if che_do_tom_tat:
        print("Đang nhờ Trợ lý OneBee tóm tắt...", file=sys.stderr, flush=True)
        ma, du_lieu = goi_api(conf, "/ai/tom-tat", khoa, {"noi_dung": question})
        if ma != 200:
            if ma in (401, 403):
                sys.exit("Khóa Trợ lý AI không hợp lệ hoặc đã bị thu hồi. Nhờ quản trị cấp lại, rồi chạy: hoi --dan-khoa")
            sys.exit(f"OneBee Box báo lỗi {ma}. Thử lại sau hoặc báo người quản trị.")
        tom_tat = (du_lieu or {}).get("tom_tat")
        if not isinstance(tom_tat, str) or not tom_tat.strip():
            sys.exit("OneBee Box trả về dữ liệu không đọc được. Báo người quản trị.")
        print(tom_tat.strip())
        print(f"\n{NOTE}", file=sys.stderr)
        return 0
    print("Đang hỏi Trợ lý OneBee...", file=sys.stderr, flush=True)
    ma, du_lieu = goi_api(conf, "/ai/hoi", khoa, {"cau_hoi": question})
    if ma != 200:
        if ma in (401, 403):
            sys.exit("Khóa Trợ lý AI không hợp lệ hoặc đã bị thu hồi. Nhờ quản trị cấp lại, rồi chạy: hoi --dan-khoa")
        sys.exit(f"OneBee Box báo lỗi {ma}. Thử lại sau hoặc báo người quản trị.")
    in_tra_loi(du_lieu)
    return 0


if __name__ == "__main__":
    sys.exit(main())

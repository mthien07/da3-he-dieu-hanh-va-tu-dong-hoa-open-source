#!/usr/bin/env python3
"""onebee-bao-tinh-trang — máy trạm gửi tình trạng về OneBee Box (lịch: mỗi giờ + sau khi bật máy).

Gửi: tên máy, địa chỉ IP trong LAN, phiên bản, số gói chờ cập nhật (bản vá bảo mật riêng), cần khởi động lại không,
dung lượng ổ còn trống, thời gian đã bật, lần sao lưu cuối, SỐ tài khoản có quyền sudo (không gửi tên tài khoản).
KHÔNG gửi tên file, nội dung hay lịch sử dùng máy.
Cấu hình: /etc/onebee/may-tram.env (MAY_TRAM, BOX_IP, TINH_TRANG_URL, TINH_TRANG_KEY nếu có — lấy từ 'onebee-box them-may').

Báo cáo được KÝ (HMAC-SHA256) bằng khóa suy từ RESTIC_PASSWORD trong cùng file cấu hình — mật khẩu kho sao lưu, restic mã hóa phía máy
trạm nên mật khẩu này chưa từng đi qua mạng. Box kiểm chữ ký bằng bản mật khẩu của nó; n8n (nơi nhận) không giữ khóa nên không giả được báo cáo.
Thiếu RESTIC_PASSWORD thì gửi dạng cũ (không ký) — Box nhận nhưng gắn nhãn "chưa ký".
"""
import hashlib
import hmac
import json
import os
import shutil
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

CONF = "/etc/onebee/may-tram.env"
MUC_DICH_KY = b"onebee-tinh-trang-v1"   # phải trùng với box-fleet/files/onebee-may-tram.py


def ky_bao_cao(mat_khau, du_lieu):
    """Chữ ký HMAC-SHA256 (hex) của chuỗi du_lieu; khóa ký = HMAC(mật khẩu kho sao lưu, mục đích)."""
    khoa = hmac.new(mat_khau.encode("utf-8"), MUC_DICH_KY, hashlib.sha256).digest()
    return hmac.new(khoa, du_lieu.encode("utf-8"), hashlib.sha256).hexdigest()


def dong_goi(tt, mat_khau):
    """Bao bì gửi n8n: có mật khẩu → {ten, du_lieu (JSON dạng chuỗi), ky}; không có → JSON phẳng như bản cũ."""
    if not mat_khau:
        return tt
    du_lieu = json.dumps(dict(tt, gui_luc=time.time()), ensure_ascii=False, sort_keys=True)
    return {"ten": tt["ten"], "du_lieu": du_lieu, "ky": ky_bao_cao(mat_khau, du_lieu)}


def doc_khoa_gia_tri(duong_dan):
    kq = {}
    try:
        with open(duong_dan, encoding="utf-8") as f:
            for dong in f:
                if "=" in dong and not dong.lstrip().startswith("#"):
                    k, v = dong.strip().split("=", 1)
                    kq[k] = v.strip('"')
    except OSError:
        pass
    return kq


def ip_toi_box(box_ip):
    """IP của máy trạm trên đường tới Box (không gửi gói tin nào)."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect((box_ip, 9))
            return s.getsockname()[0]
    except OSError:
        return None


def goi_cho_cap_nhat():
    """(số gói chờ, số gói có bản vá bảo mật) — mô phỏng nâng cấp từ danh mục gói đã có, không tải gì."""
    try:
        out = subprocess.run(["apt-get", "-s", "-o", "Debug::NoLocking=1", "dist-upgrade"], capture_output=True,
                             text=True, timeout=120, env={**os.environ, "LC_ALL": "C"}).stdout
    except (OSError, subprocess.SubprocessError):
        return None, None
    inst = [d for d in out.splitlines() if d.startswith("Inst ")]
    return len(inst), sum(1 for d in inst if "-security" in d)


def so_tai_khoan_sudo(duong_dan="/etc/group"):
    """Số tài khoản người dùng (không tính root) nằm trong nhóm sudo hoặc admin — nhân viên không nên có quyền này."""
    thanh_vien = set()
    try:
        with open(duong_dan, encoding="utf-8") as f:
            for dong in f:
                phan = dong.rstrip("\n").split(":")
                if len(phan) >= 4 and phan[0] in ("sudo", "admin"):
                    thanh_vien.update(t for t in phan[3].split(",") if t and t != "root")
    except OSError:
        return None
    return len(thanh_vien)

CA_ONEBEE = "/usr/local/share/ca-certificates/onebee-box-ca.crt"
HTTPS_BAT = "/var/lib/onebee/https-bat"   # dấu bền: Box đã báo bật HTTPS cho máy này (chỉ cờ BOX_HTTPS=0 do Box đẩy mới xóa)


def mo(req, timeout):
    """urlopen có ghim CA: https:// chỉ tin CA riêng của OneBee Box (không tin CA công cộng); http:// bị từ chối khi máy đã bật HTTPS
    (kẻ chen giữa mạng LAN không hạ cấp được kết nối về HTTP để đọc mật khẩu/khóa)."""
    ngu_canh = None
    if req.full_url.startswith("https://"):
        try:
            ngu_canh = ssl.create_default_context(cafile=CA_ONEBEE)
        except (OSError, ssl.SSLError):
            sys.exit("Máy chưa có chứng chỉ CA của OneBee Box. Báo người quản trị chạy: sudo onebee-box dong-bo-may <tên-máy>")
    elif os.path.exists(HTTPS_BAT):
        sys.exit("Máy này đã bật HTTPS nhưng cấu hình còn địa chỉ http:// — KHÔNG gửi. Báo người quản trị chạy: sudo onebee-box dong-bo-may <tên-máy>")
    try:
        return urllib.request.urlopen(req, timeout=timeout, context=ngu_canh)
    except urllib.error.HTTPError as e:
        # Box đã chuyển sang HTTPS (308) mà cấu hình máy còn http:// (máy tắt lúc chuyển): theo ĐÚNG MỘT lần, chỉ tới https:// CÙNG máy chủ,
        # vẫn chỉ tin CA OneBee — nhờ vậy máy không mất liên lạc tới khi quản trị chạy dong-bo-may. Địa chỉ khác máy chủ thì không theo.
        dich = e.headers.get("Location", "") if e.code in (301, 308) else ""
        goc, moi = urllib.parse.urlsplit(req.full_url), urllib.parse.urlsplit(dich)
        if req.full_url.startswith("http://") and moi.scheme == "https" and moi.hostname and moi.hostname == goc.hostname:
            return mo(urllib.request.Request(dich, data=req.data, headers=dict(req.header_items()), method=req.get_method()), timeout)
        raise


def loi_mang(e):
    """Thông báo cho lỗi kết nối/HTTP chung. None nếu không phải loại này. Lỗi chứng chỉ được nêu riêng: đó có thể là dấu hiệu bị tấn công."""
    if isinstance(e, urllib.error.HTTPError):
        if e.code in (502, 503, 504):
            return "Dịch vụ trên OneBee Box chưa chạy hoặc đang khởi động. Thử lại sau vài phút; vẫn lỗi thì báo người quản trị."
        if e.code in (301, 308):
            return "Cấu hình địa chỉ OneBee Box đã cũ (Box chuyển sang HTTPS). Báo người quản trị chạy: sudo onebee-box dong-bo-may <tên-máy>"
        return None
    if isinstance(e, urllib.error.URLError) and isinstance(getattr(e, "reason", None), ssl.SSLError):
        return ("CHỨNG CHỈ CỦA ONEBEE BOX KHÔNG HỢP LỆ — dừng lại, đừng nhập mật khẩu ở bất cứ đâu. "
                "Có thể có thiết bị lạ giả danh Box: báo người quản trị ngay.")
    return None


def main():
    if os.geteuid() != 0:
        sys.exit("Hãy chạy bằng quyền quản trị: sudo onebee-bao-tinh-trang")
    conf = doc_khoa_gia_tri(CONF)
    if not all(conf.get(k) for k in ("MAY_TRAM", "BOX_IP", "TINH_TRANG_URL")):
        print("Máy chưa cấp quản lý từ Box (thiếu cấu hình trong /etc/onebee/may-tram.env) — bỏ qua.")
        return 0
    cho, bao_mat = goi_cho_cap_nhat()
    o = shutil.disk_usage("/")
    try:
        with open("/proc/uptime") as f:
            bat_gio = round(float(f.read().split()[0]) / 3600, 1)
    except (OSError, ValueError):
        bat_gio = None
    try:
        with open("/var/lib/onebee/sao-luu-cuoi") as f:
            sao_luu = int(f.read().strip())
    except (OSError, ValueError):
        sao_luu = None
    tt = {
        "ten": conf["MAY_TRAM"], "ip": ip_toi_box(conf["BOX_IP"]), "hostname": socket.gethostname(),
        "phien_ban": doc_khoa_gia_tri("/etc/onebee-release").get("ONEBEE_VERSION"),
        "he_dieu_hanh": doc_khoa_gia_tri("/etc/os-release").get("PRETTY_NAME"),
        "cap_nhat_cho": cho, "bao_mat_cho": bao_mat,
        "can_khoi_dong_lai": os.path.exists("/var/run/reboot-required"),
        "o_trong_phan_tram": round(o.free * 100 / o.total, 1), "o_trong_gb": round(o.free / 1e9, 1),
        "khoi_dong_gio": bat_gio, "sao_luu_cuoi": sao_luu, "sudo_so": so_tai_khoan_sudo(),
    }
    tieu_de = {"Content-Type": "application/json"}
    if conf.get("TINH_TRANG_KEY"):   # khóa lọc chung ở cửa n8n: chỉ còn trong giai đoạn chuyển tiếp (Box đặt onebee_box_khoa_tinh_trang_chung: false thì không có)
        tieu_de["X-OneBee-Key"] = conf["TINH_TRANG_KEY"]
    req = urllib.request.Request(conf["TINH_TRANG_URL"], data=json.dumps(dong_goi(tt, conf.get("RESTIC_PASSWORD"))).encode("utf-8"),
                                 method="POST", headers=tieu_de)
    try:
        with mo(req, 30) as r:
            r.read()
    except urllib.error.HTTPError as e:
        sys.exit(loi_mang(e) or f"OneBee Box từ chối tình trạng (mã {e.code}) — kiểm tra khóa TINH_TRANG_KEY (nếu có) hoặc chạy lại 'onebee-box them-may'.")
    except (urllib.error.URLError, OSError) as e:
        sys.exit(loi_mang(e) or f"Không gửi được tình trạng về OneBee Box ({e}) — Box tắt hoặc mất mạng, lần sau gửi lại.")
    print(f"Đã gửi tình trạng máy {tt['ten']} về Box: {cho} gói chờ cập nhật, ổ trống {tt['o_trong_phan_tram']}%.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""onebee-bao-ho-tro — mở biểu mẫu "Báo cần hỗ trợ" của OneBee Box trong trình duyệt, đã điền sẵn tên máy
(và loại sự cố, mô tả nếu có). Địa chỉ biểu mẫu chỉ đọc từ /etc/onebee-ho-tro.conf (root ghi, dòng HO_TRO_URL=);
tham số của người dùng được mã hóa phần trăm, không đi qua shell. Biểu mẫu vẫn hỏi tài khoản như bình thường."""
import argparse
import os
import shutil
import socket
import subprocess
import sys
from urllib.parse import quote, urlencode

CONF_MAC_DINH = "/etc/onebee-ho-tro.conf"
MO_TA_TOI_DA = 1200


def doc_dia_chi(tep):
    """Giá trị HO_TRO_URL trong tệp; None nếu không đọc được, thiếu khóa hoặc không phải địa chỉ http(s) không có khoảng trắng."""
    try:
        with open(tep, encoding="utf-8") as f:
            dong = f.read().splitlines()
    except (OSError, UnicodeDecodeError):
        return None
    for d in dong:
        if d.startswith("HO_TRO_URL="):
            url = d.split("=", 1)[1].strip().strip('"')
            if url.startswith(("http://", "https://")) and len(url.split("://", 1)[1]) > 0 \
                    and not any(c.isspace() or ord(c) < 32 for c in url):
                return url
            return None
    return None


def dung_dia_chi(goc, may, loai="", mo_ta=""):
    """Địa chỉ biểu mẫu kèm khóa query là tên trường của biểu mẫu n8n (may, loai, mo_ta); tham số rỗng thì bỏ."""
    if len(mo_ta) > MO_TA_TOI_DA:
        mo_ta = mo_ta[:MO_TA_TOI_DA] + "…"
    cap = [(k, v) for k, v in (("may", may), ("loai", loai), ("mo_ta", mo_ta)) if v]
    if not cap:
        return goc
    return goc + ("&" if "?" in goc else "?") + urlencode(cap, quote_via=quote)


def bao(loi):
    """Báo lỗi cho người dùng: hộp thoại nếu có màn hình và zenity, không thì stderr."""
    if os.environ.get("DISPLAY") and shutil.which("zenity"):
        try:
            subprocess.run(["zenity", "--warning", "--title", "Báo cần hỗ trợ — OneBee", "--width", "380", "--text", loi],
                           check=False, timeout=300)
        except (OSError, subprocess.SubprocessError):
            pass
    print(loi, file=sys.stderr)


def main(argv):
    ap = argparse.ArgumentParser(prog="onebee-bao-ho-tro", description="Mở biểu mẫu Báo cần hỗ trợ của OneBee Box, đã điền sẵn tên máy.")
    ap.add_argument("--loai", default="", help="loại sự cố điền sẵn (đúng một lựa chọn của biểu mẫu)")
    ap.add_argument("--mo-ta", default="", help="mô tả điền sẵn (tối đa %d ký tự)" % MO_TA_TOI_DA)
    args = ap.parse_args(argv)
    goc = doc_dia_chi(os.environ.get("ONEBEE_HO_TRO_CONF", CONF_MAC_DINH))
    if goc is None:
        bao("Máy này chưa nối OneBee Box nên chưa mở được biểu mẫu Báo cần hỗ trợ.\nHãy gọi kỹ thuật viên của đơn vị.")
        return 1
    url = dung_dia_chi(goc, socket.gethostname(), args.loai, args.mo_ta)
    try:
        subprocess.Popen(["xdg-open", url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as e:
        bao("Không mở được trình duyệt để điền biểu mẫu (%s).\nHãy gọi kỹ thuật viên của đơn vị." % e)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""onebee-trung-tam — cửa sổ "Trung tâm OneBee": lối vào các việc chính, bảng phím tắt và trang "Cần giúp đỡ".

Cách dùng:
  onebee-trung-tam                  Mở cửa sổ ở trang Bắt đầu
  onebee-trung-tam --trang phim-tat Mở thẳng một trang (bat-dau, phim-tat, tro-giup)
  onebee-trung-tam --lan-dau        Chỉ mở nếu người này chưa từng đóng cửa sổ (dùng khi tự mở lúc đăng nhập)
  onebee-trung-tam --tu-kiem        Dựng đủ cửa sổ và mọi trang rồi thoát, in TU-KIEM-DAT (không mở chương trình nào)
Dấu "đã xem": ~/.config/onebee/trung-tam-da-xem (theo XDG_CONFIG_HOME nếu có), tạo khi đóng cửa sổ trừ khi người dùng
chọn "Hiện cửa sổ này ở lần đăng nhập sau".
Dữ liệu: /usr/share/onebee/cam-nang.json (biến ONEBEE_CAM_NANG), /usr/share/onebee/don-vi.json (biến ONEBEE_DON_VI).
Thiếu hoặc hỏng dữ liệu thì cửa sổ vẫn mở. Chạy bằng quyền người dùng thường.
"""
import argparse
import json
import os
import sys

# Bảng khai báo các trang theo thứ tự hiện trên thanh chuyển trang. Thêm trang: thêm một dòng ở đây và một hàm dựng trang.
TRANG = [("bat-dau", "Bắt đầu"), ("phim-tat", "Phím tắt"), ("tro-giup", "Cần giúp đỡ")]

NHOM_PHIM_TAT = [
    ("go-tieng-viet", "Gõ tiếng Việt"),
    ("man-hinh", "Màn hình và cửa sổ"),
    ("chup", "Chụp màn hình"),
    ("soan-thao", "Soạn thảo"),

O_BAT_DAU = [
    {"ma": "soan-van-ban", "ten": "Soạn văn bản", "mo_ta": "Như Word — lưu sẵn đuôi .docx",
     "bieu_tuong": "libreoffice-writer", "lenh": ["libreoffice", "--writer"], "can_lenh": "libreoffice",

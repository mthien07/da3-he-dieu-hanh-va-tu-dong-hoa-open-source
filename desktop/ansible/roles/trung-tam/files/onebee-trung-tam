CAM_NANG_MAC_DINH = "/usr/share/onebee/cam-nang.json"
DON_VI_MAC_DINH = "/usr/share/onebee/don-vi.json"
TEN_TEP_DAU = "trung-tam-da-xem"
TEP_CHIA_SE = "/usr/share/applications/onebee-chia-se-noi-bo.desktop"

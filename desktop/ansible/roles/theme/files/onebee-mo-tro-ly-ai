# Hướng dẫn dùng Trợ lý AI OneBee: Trợ lý hỏi bằng lệnh `hoi` trong cửa sổ dòng lệnh (không còn giao diện web riêng).
# Mục menu này chỉ hiện hướng dẫn; cấu hình khóa nằm trong /etc/onebee-hoi.conf do bộ cài tạo.
set -uo pipefail

HUONG_DAN="Trợ lý AI OneBee dùng lệnh hoi trong cửa sổ dòng lệnh:

  hoi <câu hỏi>
  hoi --tom-tat < van-ban.txt

Lần đầu, dán khóa do quản trị OneBee cấp:
  hoi --dan-khoa

Khóa lưu riêng cho tài khoản của bạn; không dùng chung với người khác.
Trợ lý chỉ chạy khi máy đã kết nối OneBee Box và Box đã bật HTTPS."

if command -v zenity >/dev/null 2>&1 && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
  zenity --info --title="Trợ lý AI OneBee" --text="${HUONG_DAN}" --width=480 2>/dev/null && exit 0
fi
printf '%s\n' "${HUONG_DAN}"

#!/usr/bin/env bash
# OneBee OS — Trình trợ lý bắt file cài đặt Windows (.exe, .msi) và gợi ý ứng dụng thay thế.
# Giúp người dùng văn phòng không bị bỡ ngỡ khi tải file Windows về máy Linux.
# Cách dùng:
#   onebee-windows-app-helper <tep_tin.exe|tep_tin.msi>
#   onebee-windows-app-helper --detect <tep_tin>   (chỉ in kết quả nhận diện ra terminal)
#   onebee-windows-app-helper --cli <tep_tin>      (chạy chế độ dòng lệnh dù có màn hình)
#   onebee-windows-app-helper --lam <mã> <tep_tin> (làm ngay một hành động, không hiện hộp thoại hỏi)
set -euo pipefail

PHAN_MEM_BAN_QUYEN="OneBee OS"
TIEU_DE="Trợ lý tập tin Windows — ${PHAN_MEM_BAN_QUYEN}"

in_huong_dan() {
  cat <<'EOF'
Cách dùng: onebee-windows-app-helper [TÙY CHỌN] <đường_dẫn_file>

Tùy chọn:
  --detect     Nhận diện và in thông tin phân tích ra stdout (không mở giao diện)
  --cli        Chạy giao diện dòng lệnh (không gọi hộp thoại zenity)
  --lam <mã>   Làm ngay hành động có mã <mã> (ví dụ browser, pdf_reader, wine, bao_ho_tro), không hiện hộp thoại hỏi
  -h, --help   Hiển thị hướng dẫn này
  -v, --version Hiển thị thông tin phiên bản
EOF
}

che_do="gui"
tep_tin=""
ma_lam=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --detect)
      che_do="detect"
      shift
      ;;
    --cli)
      che_do="cli"
      shift
      ;;
    --lam)
      if [[ $# -lt 2 ]]; then
        printf 'LỖI: --lam cần kèm mã hành động.\n\n' >&2
        in_huong_dan >&2
        exit 1
      fi
      che_do="lam"
      ma_lam="$2"
      shift 2
      ;;
    -h|--help)
      in_huong_dan
      exit 0
      ;;
    -v|--version)
      printf '%s — Trợ lý ứng dụng Windows v1.0.0\n' "${PHAN_MEM_BAN_QUYEN}"
      exit 0
      ;;
    *)
      if [[ -z "${tep_tin}" ]]; then
        tep_tin="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "${tep_tin}" ]]; then
  printf 'LỖI: Chưa chỉ định đường dẫn tệp tin cần mở.\n\n' >&2
  in_huong_dan >&2
  exit 1
fi

if [[ ! -e "${tep_tin}" ]]; then
  printf 'LỖI: Tệp tin "%s" không tồn tại.\n' "${tep_tin}" >&2
  exit 1
fi

ten_tep="$(basename "${tep_tin}")"
ten_tep_thuong="$(printf '%s' "${ten_tep}" | tr '[:upper:]' '[:lower:]')"
kich_thuoc="$(du -h "${tep_tin}" 2>/dev/null | cut -f1 || printf 'Không rõ')"

# Phân loại ứng dụng
ten_ung_dung=""
khoa_nhan_dien=""
goi_y=""
nhan_hanh_dong=""
lenh_hanh_dong=""

if [[ "${ten_tep_thuong}" == *zalo* ]]; then
  ten_ung_dung="Zalo (Bản cài đặt Windows)"
  khoa_nhan_dien="zalo"
  goi_y="Dùng Zalo ngay trên trình duyệt (Zalo Web), không cần cài phần mềm Windows."
  nhan_hanh_dong="Mở Zalo Web"
  lenh_hanh_dong="zalo_web"

elif [[ "${ten_tep_thuong}" == *chrome* || "${ten_tep_thuong}" == *chromium* ]]; then
  ten_ung_dung="Trình duyệt web (Chrome, Cốc Cốc, Edge...)"
  khoa_nhan_dien="chrome"
  goi_y="Máy đã có sẵn trình duyệt Firefox, dùng được các trang web và dịch vụ công như trên Windows. Không cần cài bản Windows."
  nhan_hanh_dong="Mở Trình duyệt Web"
  lenh_hanh_dong="browser"

elif [[ "${ten_tep_thuong}" == *unikey* ]]; then
  ten_ung_dung="Bộ gõ tiếng Việt UniKey"
  khoa_nhan_dien="unikey"
  goi_y="Máy đã có sẵn bộ gõ tiếng Việt (IBus Bamboo), gõ Telex như Unikey. Không cần cài Unikey."
  nhan_hanh_dong="Mở Cài đặt Bộ gõ"
  lenh_hanh_dong="ime_setup"

elif [[ "${ten_tep_thuong}" == *foxit* || "${ten_tep_thuong}" == *acrobat* || "${ten_tep_thuong}" == *adobereader* || "${ten_tep_thuong}" == *pdfreader* ]]; then
  ten_ung_dung="Trình đọc tài liệu PDF (Foxit / Adobe Acrobat)"
  khoa_nhan_dien="foxit"
  goi_y="Máy đã có sẵn trình đọc PDF. Bấm đúp vào file PDF là mở được."
  nhan_hanh_dong="Mở Trình đọc PDF"
  lenh_hanh_dong="pdf_reader"

elif [[ "${ten_tep_thuong}" == *vlc* ]]; then
  ten_ung_dung="Trình phát phim, nhạc"
  khoa_nhan_dien="vlc"
  goi_y="Máy đã có sẵn trình phát phim, nhạc. Bấm đúp vào file phim, nhạc là mở được."
  nhan_hanh_dong="Mở trình phát phim, nhạc"
  lenh_hanh_dong="media_player"

elif [[ "${ten_tep_thuong}" == *ultraviewer* || "${ten_tep_thuong}" == *teamviewer* || "${ten_tep_thuong}" == *anydesk* ]]; then
  ten_ung_dung="Phần mềm điều khiển máy tính từ xa (UltraViewer / TeamViewer)"
  khoa_nhan_dien="ultraviewer"
  goi_y="OneBee OS đã tích hợp sẵn công cụ \"Cho phép hỗ trợ từ xa\" (onebee-ho-tro) an toàn với mã 1 lần và kiểm soát quyền xem màn hình."
  nhan_hanh_dong="Mở Hỗ trợ từ xa OneBee"
  lenh_hanh_dong="onebee_support"

elif [[ "${ten_tep_thuong}" == *office* || "${ten_tep_thuong}" == *word* || "${ten_tep_thuong}" == *excel* || "${ten_tep_thuong}" == *powerpoint* ]]; then
  ten_ung_dung="Microsoft Office (Word / Excel / PowerPoint)"
  khoa_nhan_dien="office"
  goi_y="LibreOffice trên máy mở và lưu được file Word, Excel, PowerPoint (.docx, .xlsx, .pptx)."
  nhan_hanh_dong="Mở LibreOffice"
  lenh_hanh_dong="libreoffice"

else
  ten_ung_dung="Ứng dụng Windows (${ten_tep})"
  khoa_nhan_dien="unknown_windows"
  goi_y="Tập tin này là phần mềm chỉ chạy trên Windows (.exe / .msi). Hãy báo kỹ thuật OneBee để được hướng dẫn cách làm việc này trên máy."
  nhan_hanh_dong="Tùy chọn tương thích"
  lenh_hanh_dong="advanced_options"
fi

# Hiện lời nhắn: hộp thoại khi có màn hình và zenity, ngược lại in ra màn hình
bao() {
  local loi_nhan="$1"
  if [[ "${che_do}" == "gui" && -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --info --title="${TIEU_DE}" --width=420 --text="${loi_nhan}" 2>/dev/null || true
  else
    printf '%b\n' "${loi_nhan}"
  fi
}

# mo_hoac_bao "<tên hiển thị>" <lệnh 1> [<lệnh 2> ...]: chạy nền lệnh đầu tiên có trên máy; không có lệnh nào thì nói rõ cho người dùng
mo_hoac_bao() {
  local ten_hien_thi="$1" lenh
  local -a phan_lenh
  shift
  for lenh in "$@"; do
    read -r -a phan_lenh <<<"${lenh}"
    if command -v "${phan_lenh[0]}" >/dev/null 2>&1; then
      "${phan_lenh[@]}" >/dev/null 2>&1 &
      return 0
    fi
  done
  bao "Máy này chưa có ${ten_hien_thi}.\n\nBấm \"Báo cần hỗ trợ (OneBee)\" trong menu Bắt đầu để kỹ thuật cài giúp."
}

thuc_thi_hanh_dong() {
  local hanh_dong="$1"
  case "${hanh_dong}" in
    zalo_web)
      mo_hoac_bao "trình duyệt web" "xdg-open https://chat.zalo.me" "x-www-browser https://chat.zalo.me"
      ;;
    browser)
      mo_hoac_bao "trình duyệt web" "x-www-browser" "firefox"
      ;;
    ime_setup)
      mo_hoac_bao "công cụ cài đặt bộ gõ" "ibus-setup"
      ;;
    pdf_reader)
      mo_hoac_bao "trình đọc PDF" "xreader" "evince"
      ;;
    media_player)
      mo_hoac_bao "trình phát phim, nhạc" "celluloid" "vlc"
      ;;
    libreoffice)
      mo_hoac_bao "LibreOffice" "libreoffice"
      ;;
    remote_vm)
      mo_hoac_bao "phần mềm nối máy tính từ xa (Remmina)" "remmina"
      ;;
    onebee_support)
      mo_hoac_bao "công cụ hỗ trợ từ xa OneBee" "onebee-ho-tro"
      ;;
    wine)
      if command -v wine >/dev/null 2>&1; then
        wine "${tep_tin}" >/dev/null 2>&1 &
      else
        bao "Máy này chưa có môi trường chạy phần mềm Windows (WINE).\n\nBấm \"Báo cần hỗ trợ (OneBee)\" trong menu Bắt đầu để kỹ thuật xem giúp."
      fi
      ;;
    bao_ho_tro)
      if [[ -f /usr/share/applications/onebee-bao-ho-tro.desktop ]] && command -v gtk-launch >/dev/null 2>&1; then
        gtk-launch onebee-bao-ho-tro >/dev/null 2>&1 &
      else
        bao "Máy này chưa có mục Báo cần hỗ trợ (máy chưa nối OneBee Box). Hãy gọi điện cho kỹ thuật OneBee."
      fi
      ;;
    *)
      printf 'LỖI: Không có hành động "%s".\n' "${hanh_dong}" >&2
      return 1
      ;;
  esac
}

# 0. Chế độ làm ngay một hành động (dùng cho kiểm thử tự động và cho các nút), không hiện hộp thoại nào khác
if [[ "${che_do}" == "lam" ]]; then
  thuc_thi_hanh_dong "${ma_lam}" || exit 1
  exit 0
fi

# 1. Chế độ Detect (dành cho automation test & script phân tích)
if [[ "${che_do}" == "detect" ]]; then
  printf 'APP_NAME=%s\n' "${ten_ung_dung}"
  printf 'DETECTED_KEY=%s\n' "${khoa_nhan_dien}"
  printf 'SUGGESTION=%s\n' "${goi_y}"
  printf 'ACTION_LABEL=%s\n' "${nhan_hanh_dong}"
  printf 'ACTION_CMD=%s\n' "${lenh_hanh_dong}"
  exit 0
fi

# 2. Kiểm tra môi trường hiển thị đồ họa
co_gui=false
if [[ "${che_do}" == "gui" && -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
  co_gui=true
fi

# 3. Xử lý hiển thị
if [[ "${co_gui}" == true ]]; then
  if [[ "${khoa_nhan_dien}" != "unknown_windows" ]]; then
    # Trường hợp nhận diện được ứng dụng phổ biến: hiện hộp thoại gợi ý thân thiện
    thong_diep="<b>Phát hiện:</b> ${ten_ung_dung}\n<b>Tập tin:</b> ${ten_tep} (${kich_thuoc})\n\n${goi_y}\n\nBạn có muốn mở ứng dụng thay thế ngay không?"
    if zenity --question --title="${TIEU_DE}" --text="${thong_diep}" \
      --ok-label="${nhan_hanh_dong}" --cancel-label="Đóng" \
      --width=480 2>/dev/null; then
      thuc_thi_hanh_dong "${lenh_hanh_dong}"
    fi
  else
    # Trường hợp file lạ: cung cấp các lựa chọn WINE / Máy ảo / Hỗ trợ kỹ thuật
    thong_diep="Tập tin: <b>${ten_tep}</b> (${kich_thuoc})\n\n${goi_y}\n\nVui lòng chọn cách xử lý bên dưới:"
    cac_dong_chon=()
    if command -v wine >/dev/null 2>&1; then
      cac_dong_chon+=("wine" "🚀 Chạy thử với môi trường tương thích WINE")
    fi
    if command -v remmina >/dev/null 2>&1; then
      cac_dong_chon+=("remote_vm" "💻 Mở máy ảo / máy kế toán chuyên dụng (Remmina)")
    fi
    cac_dong_chon+=("bao_ho_tro" "Báo cần hỗ trợ (gửi yêu cầu cho kỹ thuật OneBee)" "cancel" "❌ Đóng lại")
    lua_chon="$(zenity --list --title="${TIEU_DE}" --text="${thong_diep}" \
      --column="Mã" --column="Phương án xử lý" --hide-column=1 \
      --width=520 --height=280 \
      "${cac_dong_chon[@]}" 2>/dev/null || printf 'cancel')"

    case "${lua_chon}" in
      wine|remote_vm|bao_ho_tro)
        thuc_thi_hanh_dong "${lua_chon}"
        ;;
      *)
        exit 0
        ;;
    esac
  fi
else
  # Chế độ dòng lệnh (CLI fallback)
  printf '============================================================\n'
  printf ' [%s] %s\n' "${PHAN_MEM_BAN_QUYEN}" "${TIEU_DE}"
  printf '============================================================\n'
  printf ' Tập tin:    %s (Kích thước: %s)\n' "${ten_tep}" "${kich_thuoc}"
  printf ' Nhận diện:  %s\n' "${ten_ung_dung}"
  printf ' Gợi ý:      %s\n' "${goi_y}"
  printf ' Đề xuất:    %s\n' "${nhan_hanh_dong}"
  printf '============================================================\n'
  if [[ "${khoa_nhan_dien}" == "unknown_windows" ]]; then
    printf ' Các tùy chọn có sẵn:\n'
    so_thu_tu=1
    if command -v wine >/dev/null 2>&1; then
      printf '  %d. Chạy thử với môi trường WINE:      wine "%s"\n' "${so_thu_tu}" "${tep_tin}"
      so_thu_tu=$((so_thu_tu + 1))
    fi
    if command -v remmina >/dev/null 2>&1; then
      printf '  %d. Mở máy ảo kế toán chuyên dụng:    remmina\n' "${so_thu_tu}"
      so_thu_tu=$((so_thu_tu + 1))
    fi
    printf '  %d. Báo cần hỗ trợ: bấm "Báo cần hỗ trợ (OneBee)" trong menu Bắt đầu\n' "${so_thu_tu}"
    printf '============================================================\n'
  fi
fi

exit 0
